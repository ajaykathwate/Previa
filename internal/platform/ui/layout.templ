package ui

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } | Previa</title>
			<script src="/static/htmx.min.js" defer></script>
		</head>
		<body>
			<header>
				<nav aria-label="Main navigation">
					<a href="/">Previa</a>
				</nav>
			</header>
			<main id="content">
				{ children... }
			</main>
		</body>
	</html>
}
