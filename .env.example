# Copy to .env for local configuration. Migration targets load it automatically
# (or use this example if absent). Application config reads exported variables:
# set -a; . ./.env; set +a
# Values below are placeholders, not production credentials.

# HTTP listen address; binds to localhost by default.
HTTP_ADDR=127.0.0.1:8080

# Public origin used for OAuth redirects. Use this exact hostname in your browser.
# Register http://localhost:8080/auth/github/callback in your local OAuth App.
# HTTPS is required outside localhost and enables Secure cookies.
APP_BASE_URL=http://localhost:8080

# PostgreSQL connection string for control-plane state and the River queue.
# Local credentials/port match deploy/docker-compose.yml; change both together.
DATABASE_URL=postgres://previa:change-me@localhost:5432/previa?sslmode=disable

# Numeric GitHub App ID from the app settings.
GITHUB_APP_ID=123456
# Path to the GitHub App private key PEM file (keep the file out of Git).
GITHUB_APP_PRIVATE_KEY_PATH=/path/to/github-app.private-key.pem
# Shared secret used to validate GitHub webhook signatures.
GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# GitHub OAuth credentials for dashboard sign-in.
GITHUB_OAUTH_CLIENT_ID=replace-with-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret

# Base DNS domain for per-PR preview URLs and wildcard TLS.
PREVIEW_BASE_DOMAIN=preview.example.com
# Random secret for session security, at least 32 characters.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Base64-encoded 32-byte key for stored preview-app secrets (AES-256-GCM).
# This all-zero key is a placeholder. Generate a real key with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Maximum number of simultaneous builds; tune for host capacity.
MAX_CONCURRENT_BUILDS=2
# Preview lifetime in hours before expiry cleanup.
ENV_TTL_HOURS=24

# DNS provider token used by Traefik for wildcard certificate DNS-01 challenges.
DNS_PROVIDER_API_TOKEN=replace-with-dns-provider-token
