# =============================================================================
# Previa configuration (local development)
# =============================================================================
# Copy this file to .env and replace the placeholders:   cp .env.example .env
#
# How to read this file
# - Every setting has a placeholder value and a comment saying what it does,
#   which process reads it, whether it is required, its default, and how to
#   get the value.
# - Uncommented lines are the minimum to start the server and worker locally.
#   Commented lines are optional: remove the leading "# " to turn one on.
# - The values here are placeholders, never real credentials. Never commit,
#   print or share your .env (it is Git-ignored).
# - make run-server, make run-worker, make dev and the make test-* targets load
#   .env automatically; already-exported variables win. For a plain `go run`,
#   export it first: set -a; . ./.env; set +a
# - Keep shell syntax: NAME=value, no spaces around "=", no inline comments;
#   quote values that contain spaces.
# - Production uses deploy/production/previa.env.example instead
#   (docs/24-production-deployment.md). Every setting is also listed in
#   docs/02-development-setup.md and technical-docs/tech-stack.md.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Shared: server, worker and migration commands
# -----------------------------------------------------------------------------

# DATABASE_URL (required; server, worker, migrations)
# What: PostgreSQL connection for application data, sessions and River jobs
#   (there is no separate queue database).
# How to get it: the local database from `docker compose -f
#   deploy/docker-compose.yml up -d` uses exactly this value; change the user,
#   password, port and database name together with that Compose file.
DATABASE_URL=postgres://previa:change-me@localhost:5432/previa?sslmode=disable

# APP_ENV (optional; server, worker; default development)
# What: development or production. Production requires an HTTPS APP_BASE_URL
#   and GITHUB_WEBHOOK_SECRET, refuses a GitHub App key that group or others can
#   read, and does not serve the queue-ping developer tools.
# How to get it: keep development locally; release images set production.
# APP_ENV=development

# LOG_LEVEL (optional; server, worker, egress proxy; default info)
# What: debug, info, warn or error. Logs are JSON; secrets are redacted.
# LOG_LEVEL=info


# -----------------------------------------------------------------------------
# 2. Server: dashboard, sign-in and webhooks
# -----------------------------------------------------------------------------

# HTTP_ADDR (optional; server; default 127.0.0.1:8080)
# What: where the dashboard listens. Keep it on loopback locally.
HTTP_ADDR=127.0.0.1:8080

# APP_BASE_URL (server; also the worker when PREVIEW_BASE_DOMAIN is set;
#   default http://localhost:8080)
# What: the dashboard's public origin. OAuth redirects, CSRF origin checks,
#   Secure cookies and the host the server answers for all come from it.
#   Must be HTTPS except on localhost.
# How to get it: http://localhost:8080 locally; your dashboard URL in
#   production (for example https://previa.example.com).
APP_BASE_URL=http://localhost:8080

# GITHUB_OAUTH_CLIENT_ID and GITHUB_OAUTH_CLIENT_SECRET (required; server)
# What: the GitHub OAuth App used for "Sign in with GitHub".
# How to get them: GitHub > Settings > Developer settings > OAuth Apps >
#   New OAuth App. Homepage URL http://localhost:8080, Authorization callback
#   URL http://localhost:8080/auth/github/callback (exactly). Copy the Client
#   ID, then "Generate a new client secret" and copy it once
#   (docs/04-github-sign-in-and-app.md).
GITHUB_OAUTH_CLIENT_ID=Ov23li-replace-with-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret

# SESSION_SECRET (required; server)
# What: signs the OAuth state; at least 32 characters.
# How to get it: openssl rand -hex 32
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32-xxxxxxxxxxxx

# GITHUB_WEBHOOK_SECRET (optional locally, required in production; server)
# What: verifies the X-Hub-Signature-256 of every GitHub webhook. Without it
#   /webhooks/github answers 503 and accepts nothing.
# How to get it: openssl rand -hex 32, then paste the same value into your
#   GitHub App > General > Webhook secret.
# GITHUB_WEBHOOK_SECRET=replace-with-output-of-openssl-rand-hex-32

# INTERNAL_ADDR (optional; server; default 127.0.0.1:9090)
# What: the internal listener for /livez, /readyz and /metrics. Never publish
#   it; containers use 0.0.0.0:9090 on their private network.
# INTERNAL_ADDR=127.0.0.1:9090

# TRUSTED_PROXIES (optional; server; default empty = trust nobody)
# What: comma-separated addresses or CIDR ranges of reverse proxies allowed to
#   set X-Forwarded-For / X-Forwarded-Host (the router, in production).
# How to get it: the proxy's address on the network it reaches the server
#   from; production Compose sets 172.31.250.10 itself.
# TRUSTED_PROXIES=172.31.250.10

# BACKUP_STATUS_FILE (optional; server)
# What: a file the backup script touches after each successful backup; its
#   time becomes previa_backup_last_success_timestamp_seconds for alerting.
# How to get it: production Compose sets it; leave unset locally.
# BACKUP_STATUS_FILE=/var/lib/previa/backup/last-success


# -----------------------------------------------------------------------------
# 3. GitHub App: repository linking (server), discovery and builds (worker)
# -----------------------------------------------------------------------------
# Create one GitHub App: GitHub > Settings > Developer settings > GitHub Apps >
# New GitHub App (docs/04-github-sign-in-and-app.md):
#   Homepage URL       http://localhost:8080
#   Callback URL       http://localhost:8080/installations/authorize/callback
#   Setup URL          http://localhost:8080/installations/callback (Redirect on update)
#   Webhook URL        a public HTTPS URL ending in /webhooks/github (a tunnel
#                      to localhost works), secret = GITHUB_WEBHOOK_SECRET;
#                      subscribe to "Pull request"
#   Permissions        Contents: read, Pull requests: write, Checks: write
# The worker needs only GITHUB_APP_ID and GITHUB_APP_PRIVATE_KEY_PATH. The server
# needs all five values below to link installations: set all five or none.

# GITHUB_APP_ID (optional; server, worker)
# What: the App's numeric ID, used to sign App JWTs.
# How to get it: the App's settings page > General > "App ID".
# GITHUB_APP_ID=123456

# GITHUB_APP_PRIVATE_KEY_PATH (optional; server, worker)
# What: absolute path of the App's private key (PEM).
# How to get it: App settings > General > Private keys > "Generate a private
#   key"; save the downloaded .pem outside this repository (on WSL, in your
#   Linux home, not /mnt/c) and chmod 600 it.
# GITHUB_APP_PRIVATE_KEY_PATH=/home/you/.config/previa/github-app.private-key.pem

# GITHUB_APP_SLUG (optional; server)
# What: the App's URL name, used to send owners to its installation page.
# How to get it: the last part of https://github.com/apps/<slug>.
# GITHUB_APP_SLUG=your-app-slug

# GITHUB_APP_CLIENT_ID and GITHUB_APP_CLIENT_SECRET (optional; server)
# What: the App's own OAuth credentials, used to verify that the person who
#   installed it is the signed-in user (separate from the OAuth App above).
# How to get them: App settings > General > "Client ID", and "Generate a new
#   client secret".
# GITHUB_APP_CLIENT_ID=Iv23li-replace-with-app-client-id
# GITHUB_APP_CLIENT_SECRET=replace-with-app-client-secret


# -----------------------------------------------------------------------------
# 4. Repository secrets keyring (server and worker)
# -----------------------------------------------------------------------------

# SECRETS_ENCRYPTION_KEYS and SECRETS_ACTIVE_KEY_VERSION (optional; set both
#   or neither; use the same values in the server and the worker)
# What: versioned AES-256 keys that encrypt the values owners store on a
#   repository's Secrets tab, and the version new values use. Without them the
#   Secrets tab says "not configured" and repositories that have secrets fail
#   their builds closed (secrets_unavailable).
# How to get them: openssl rand -base64 32, written as "<version>:<key>";
#   comma-separate versions when rotating (docs/07-repository-secrets.md).
#   Keep a copy offline: without it stored secrets cannot be decrypted.
# SECRETS_ENCRYPTION_KEYS=1:replace-with-output-of-openssl-rand-base64-32=
# SECRETS_ACTIVE_KEY_VERSION=1


# -----------------------------------------------------------------------------
# 5. Worker: builds and capacity
# -----------------------------------------------------------------------------

# MAX_CONCURRENT_BUILDS (required; worker)
# What: builds running at once, per worker and across all workers.
# How to get it: 1-2 on a laptop; on a server roughly free memory divided by
#   BUILD_MEMORY.
MAX_CONCURRENT_BUILDS=2

# BUILD_TIMEOUT (optional; worker; default 12m; more than 0, at most 24h)
# What: the longest one build (source, image, healthy preview) may take.
BUILD_TIMEOUT=12m

# WORKER_INTERNAL_ADDR (optional; worker; default 127.0.0.1:9091)
# What: the worker's /livez, /readyz (with its capabilities) and /metrics.
# WORKER_INTERNAL_ADDR=127.0.0.1:9091

# BUILDS_PAUSED (optional; worker; default false)
# What: the execution kill switch. When true no new build starts; teardown,
#   cleanup, routing, reports and housekeeping keep running
#   (docs/23-incident-runbook.md).
# BUILDS_PAUSED=false

# BUILD_CPUS, BUILD_MEMORY, BUILD_PIDS (optional; worker; defaults 2, 4GiB, 2048)
# What: limits for each isolated BuildKit builder. CPUs 0.25-64, memory at
#   least 256MiB, processes 128-65536. Sizes take KiB, MiB, GiB or TiB.
# BUILD_CPUS=2
# BUILD_MEMORY=4GiB
# BUILD_PIDS=2048

# BUILD_DISK_BUDGET, BUILD_MAX_IMAGE_SIZE, BUILD_MIN_FREE_DISK (optional;
#   worker; defaults 20GiB, 4GiB, 15GiB)
# What: disk one build may use, the largest image it may produce, and the free
#   space the Docker host must keep (builds wait instead of filling the disk).
# BUILD_DISK_BUDGET=20GiB
# BUILD_MAX_IMAGE_SIZE=4GiB
# BUILD_MIN_FREE_DISK=15GiB

# EGRESS_IMAGE (optional; worker; default previa-egress:dev)
# What: the image of the egress proxy and readiness prober, the only way out
#   of build and preview networks.
# How to get it: make egress-image builds previa-egress:dev.
# EGRESS_IMAGE=previa-egress:dev

# BUILDKIT_IMAGE (optional; worker; default the pinned rootless BuildKit
#   v0.33.1 image)
# What: the BuildKit daemon image started for every build. Change only to
#   another pinned rootless image.
# BUILDKIT_IMAGE=moby/buildkit:v0.33.1-rootless@sha256:f8a833b2de9d68e27f0815e4a737abdfaf8a2e4c615650557df11025101557b4

# SOURCE_WORKSPACE_ROOT (optional; worker; default previa-sources in the
#   system temporary directory)
# What: where each build's exact-commit source is unpacked. An absolute path
#   on a Linux filesystem (not /mnt/c).
# SOURCE_WORKSPACE_ROOT=/home/you/.cache/previa/sources


# -----------------------------------------------------------------------------
# 6. Worker: previews (hardening and capacity)
# -----------------------------------------------------------------------------

# PREVIEW_ALLOW_ROOT, PREVIEW_WRITABLE_ROOTFS (optional; worker; default false)
# What: server-wide opt-outs from running previews as UID 65532 with a
#   read-only root. Leave false unless your apps cannot run otherwise.
# PREVIEW_ALLOW_ROOT=false
# PREVIEW_WRITABLE_ROOTFS=false

# PREVIEW_TMPFS_SIZE, PREVIEW_PIDS, PREVIEW_STARTUP_TIMEOUT (optional; worker;
#   defaults 256MiB, 512, 120s)
# What: each preview's /tmp size (16MiB-4GiB), process limit (64-65536) and
#   how long it may take to answer its health check (5s-30m).
# PREVIEW_TMPFS_SIZE=256MiB
# PREVIEW_PIDS=512
# PREVIEW_STARTUP_TIMEOUT=120s

# PREVIEW_MEMORY_BUDGET, PREVIEW_CPU_BUDGET (optional; worker; empty = 60% of
#   Docker's memory and 75% of its CPUs)
# What: what all previews together may use; a new preview waits when full.
# PREVIEW_MEMORY_BUDGET=8GiB
# PREVIEW_CPU_BUDGET=4

# PREVIEW_MAX_PER_REPOSITORY (optional; worker; default 10, 1-1000)
# What: running previews allowed per repository.
# PREVIEW_MAX_PER_REPOSITORY=10

# PREVIEW_OCI_RUNTIME (optional; worker; default Docker's runtime)
# What: a Docker runtime for previews, for example runsc (gVisor) where it is
#   installed on the Docker host.
# PREVIEW_OCI_RUNTIME=runsc


# -----------------------------------------------------------------------------
# 7. Preview domain and routing (server and worker)
# -----------------------------------------------------------------------------
# Setting PREVIEW_BASE_DOMAIN turns builds and previews on in the worker (with
# the GitHub App, Docker, ROUTER_DYNAMIC_DIR and a running router). Without it
# the worker only discovers pull requests (docs/21-mvp-operations.md).

# PREVIEW_BASE_DOMAIN (optional; server, worker)
# What: previews get https://pr-<number>-<repo id>-<token>.<PREVIEW_BASE_DOMAIN>.
#   It must not be the dashboard's host or a parent of it; a separate
#   registrable domain isolates previews best.
# How to get it: a domain you control with a wildcard DNS record
#   (*.preview.example.net) pointing at the Docker host.
# PREVIEW_BASE_DOMAIN=preview.example.net

# ROUTER_DYNAMIC_DIR (worker, with PREVIEW_BASE_DOMAIN; also the router)
# What: an existing directory shared with Traefik, where the worker writes the
#   route table. Keep it on a Linux filesystem (Traefik watches it).
# How to get it: mkdir -p ~/.local/share/previa/router
# ROUTER_DYNAMIC_DIR=/home/you/.local/share/previa/router

# ROUTER_CONTAINER, ROUTER_ENTRYPOINT, ROUTER_API_ADDRESS (optional; worker;
#   defaults previa-router, websecure, 127.0.0.1:8080)
# What: the router container's name, its HTTPS entry point, and its API
#   address inside that container (the worker reads it through docker exec).
# ROUTER_CONTAINER=previa-router
# ROUTER_ENTRYPOINT=websecure
# ROUTER_API_ADDRESS=127.0.0.1:8080


# -----------------------------------------------------------------------------
# 8. Housekeeping (worker)
# -----------------------------------------------------------------------------

# ENV_TTL_HOURS (optional; worker; default 48; 0 = never; at most 8760)
# What: a preview is removed this many hours after its latest publication;
#   the next build brings it back at the same address.
# ENV_TTL_HOURS=48

# HOUSEKEEPING_DRY_RUN (optional; worker; default false)
# What: log every deletion housekeeping would make (orphans, expiry, pruning)
#   and make none.
# HOUSEKEEPING_DRY_RUN=false

# HOUSEKEEPING_GRACE (optional; worker; default 15m; 1m-24h)
# What: an unreferenced container, image or network must be at least this old
#   before housekeeping removes it.
# HOUSEKEEPING_GRACE=15m

# BUILD_CACHE_BUDGET (optional; worker; default 40GiB; at least 1GiB)
# What: all build caches together; the oldest unused ones are pruned first.
# BUILD_CACHE_BUDGET=40GiB


# -----------------------------------------------------------------------------
# 9. Router for local or staging use (make router-up; read by
#    deploy/traefik/compose.yml, not by Go)
# -----------------------------------------------------------------------------

# ACME_EMAIL (required by make router-up)
# What: the Let's Encrypt account e-mail (expiry notices).
# ACME_EMAIL=ops@example.com

# ACME_DNS_PROVIDER and ACME_DNS_CREDENTIAL_VARIABLE (required by router-up)
# What: the lego DNS provider that proves domain ownership for the wildcard
#   certificate, and the variable that provider reads its token from.
# How to get them: https://go-acme.github.io/lego/dns/ lists providers and
#   their variables, for example cloudflare and CF_DNS_API_TOKEN.
# ACME_DNS_PROVIDER=cloudflare
# ACME_DNS_CREDENTIAL_VARIABLE=CF_DNS_API_TOKEN

# ACME_DNS_CREDENTIAL_FILE (required by router-up)
# What: a chmod 600 file holding only the DNS API token (it is never an
#   environment value).
# How to get it: create a token at your DNS provider that can edit TXT records
#   of the preview zone; printf '%s' "$TOKEN" > the file; chmod 600 it.
# ACME_DNS_CREDENTIAL_FILE=/home/you/.config/previa/dns-credential

# ACME_CA_SERVER and ACME_DNS_RESOLVERS (optional; defaults Let's Encrypt
#   staging and 1.1.1.1:53,8.8.8.8:53)
# What: switch to production
#   (https://acme-v02.api.letsencrypt.org/directory) only after staging issued
#   a certificate.
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# ACME_DNS_RESOLVERS=1.1.1.1:53,8.8.8.8:53


# -----------------------------------------------------------------------------
# 10. Tests and tooling (read by make targets and tests only)
# -----------------------------------------------------------------------------
# The make test-* targets (except test-browser) load .env, so the TEST_* and
# WORKSPACES settings below work from .env. ENV_FILE, UI_BROWSER_*,
# PREVIA_VERSION and SMOKE_* do not: put them on the command line instead, for
# example `UI_BROWSER_EXECUTABLE=/snap/bin/chromium make test-browser`.

# ENV_FILE (make command line only; default .env)
# What: load another file instead: ENV_FILE=.env.local make run-server.
#   Setting it inside .env has no effect.

# TEST_DATABASE_URL (tests; default DATABASE_URL for the make test-* targets)
# What: the PostgreSQL the integration tests use; they create and drop their own
#   schemas. Plain `go test` skips database tests without it.
# TEST_DATABASE_URL=postgres://previa:change-me@localhost:5432/previa?sslmode=disable

# TEST_GITHUB_INSTALLATION_ID, TEST_GITHUB_REPO_ID, TEST_GITHUB_PR_NUMBER
#   (make test-github-app, test-source, test-reporting)
# What: a real installation, repository and open pull request for the opt-in
#   live checks. test-reporting writes a comment and check runs to that PR:
#   use a disposable PR you may write to.
# How to get them: the installation ID is the number in
#   github.com/settings/installations/<id>; the repository ID from
#   `gh api repos/OWNER/REPO --jq .id`; the PR number from its URL.
# TEST_GITHUB_INSTALLATION_ID=12345678
# TEST_GITHUB_REPO_ID=987654321
# TEST_GITHUB_PR_NUMBER=1

# TEST_E2E_LOG, TEST_ROUTING_LOG (make test-e2e, test-routing; set to 1)
# What: print the worker's and the router's logs during those suites.
# TEST_E2E_LOG=1
# TEST_ROUTING_LOG=1

# UI_BROWSER_EXECUTABLE, UI_BROWSER_SCREENSHOTS (make test-browser; command
#   line or exported, not .env)
# What: use an existing Chromium (for example /snap/bin/chromium) instead of
#   Playwright's, and save screenshots to web/tests/browser/artifacts (set 1).
# UI_BROWSER_EXECUTABLE=/snap/bin/chromium
# UI_BROWSER_SCREENSHOTS=1

# WORKSPACES (make housekeeping-dry-run)
# What: also inspect this source workspace directory in the dry run.
# WORKSPACES=/home/you/.cache/previa/sources

# PREVIA_VERSION, SMOKE_OLD_DUMP, SMOKE_KEEP (make release-images, prod-smoke;
#   command line or exported, not .env)
# What: the image tag to build and test; a pg_dump -Fc file from an older
#   release to rehearse restoring it; 1 to keep the smoke stack on failure.
# PREVIA_VERSION=v0.1.0-rc.1
# SMOKE_OLD_DUMP=/home/you/backups/previa-old.dump
# SMOKE_KEEP=1
