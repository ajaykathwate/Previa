# Copy to .env for local configuration. Migration targets load it automatically
# (or use this example if absent). make run-server/run-worker load .env too;
# exported variables take precedence. Direct go run needs exported variables:
# set -a; . ./.env; set +a
# Values below are placeholders, not production credentials.

# shared — server, worker, and migration commands
# PostgreSQL stores application state and River jobs; no separate queue URL.
# Local credentials/port match deploy/docker-compose.yml; change both together.
DATABASE_URL=postgres://previa:change-me@localhost:5432/previa?sslmode=disable

# shared App authentication — server and PR-discovery worker (optional)
# Workers need only this pair. Linking in the server also needs the three
# server-only App values below; configure all five there or omit all five.
# App settings: numeric App ID and Generate private key. Keep the PEM out of Git.
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY_PATH=/absolute/path/to/github-app.private-key.pem

# server only
# HTTP listen address; binds to localhost by default.
HTTP_ADDR=127.0.0.1:8080
# Browser origin; register http://localhost:8080/auth/github/callback in GitHub.
# HTTPS is required outside localhost and enables Secure cookies.
APP_BASE_URL=http://localhost:8080
# GitHub OAuth App credentials for dashboard sign-in.
GITHUB_OAUTH_CLIENT_ID=replace-with-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret
# Signs OAuth state. Generate a random value with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional server-only GitHub App linking values, completing the shared pair above.
# Leave these commented to run dashboard sign-in without installation linking.
# App settings: App ID, URL slug, Generate private key, Client ID, Generate client secret.
# Store the key outside this repository and chmod 600 the file.
# GITHUB_APP_SLUG=your-app-slug
# GITHUB_APP_CLIENT_ID=Iv1.replace-with-app-client-id
# GITHUB_APP_CLIENT_SECRET=replace-with-app-client-secret
# Setup URL: http://localhost:8080/installations/callback
# App user authorization callback: http://localhost:8080/installations/authorize/callback
# These are separate from the existing OAuth App dashboard login callback.

# Preview hostnames — server and worker (optional until previews are published).
# Previews get https://pr-<number>-<repo id>-<token>.<PREVIEW_BASE_DOMAIN>.
# Use a domain the dashboard (APP_BASE_URL) is NOT below; a separate
# registrable domain (like githubusercontent.com for github.com) isolates best.
# The server refuses an overlapping pair; the worker validates the routing set.
# PREVIEW_BASE_DOMAIN=preview.example.com

# Server-only webhook authentication; independent of optional App linking.
# Generate: openssl rand -hex 32. Paste the same value into GitHub App Webhook Secret.
# Omit to keep /webhooks/github disabled (503); signatures are always required.
# GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Repository secrets keyring — server now, worker too once previews run (optional).
# Versioned AES-256 keys: "<version>:<base64 of 32 random bytes>", comma-separated.
# Generate a key with: openssl rand -base64 32
# Set both or neither; without them the Secrets tab shows "not configured".
# Rotation: add a new version, point SECRETS_ACTIVE_KEY_VERSION at it, restart,
# run make secrets-reencrypt, and remove the old version only when it reports zero.
# SECRETS_ENCRYPTION_KEYS=1:replace-with-output-of-openssl-rand-base64-32
# SECRETS_ACTIVE_KEY_VERSION=1

# worker only
# Positive per-worker ping concurrency; PR discovery has its own two-worker queue.
# Once execution is connected, also the builds running at once across all workers.
MAX_CONCURRENT_BUILDS=2
# Maximum build execution time; completion/cleanup has a separate one-minute grace.
BUILD_TIMEOUT=12m
# Housekeeping (worker; optional, defaults shown). Previews expire this many
# hours after their latest publication (0: never). A dry run logs every
# deletion housekeeping would make and makes none; orphans must be older than
# the grace period. See docs/14-housekeeping-and-capacity.md.
# ENV_TTL_HOURS=48
# HOUSEKEEPING_DRY_RUN=false
# HOUSEKEEPING_GRACE=15m
# BUILD_CACHE_BUDGET=40GiB
# Isolated image builds and previews (worker; optional, defaults shown).
# Sizes take KiB/MiB/GiB/TiB. The worker validates these at start; builds and
# previews use them once execution is connected. Build the egress image first:
# make egress-image
# EGRESS_IMAGE=previa-egress:dev
# BUILD_CPUS=2
# BUILD_MEMORY=4GiB
# BUILD_PIDS=2048
# BUILD_DISK_BUDGET=20GiB
# BUILD_MAX_IMAGE_SIZE=4GiB
# BUILD_MIN_FREE_DISK=15GiB
# BUILDKIT_IMAGE defaults to the pinned moby/buildkit:v0.33.1-rootless digest.
# Previews run as UID 65532 with a read-only root unless an operator opts out
# for every repository on this server:
# PREVIEW_ALLOW_ROOT=false
# PREVIEW_WRITABLE_ROOTFS=false
# PREVIEW_TMPFS_SIZE=256MiB
# PREVIEW_PIDS=512
# PREVIEW_STARTUP_TIMEOUT=120s
# Empty budgets use 60% of Docker's memory and 75% of its CPUs for all previews.
# PREVIEW_MEMORY_BUDGET=
# PREVIEW_CPU_BUDGET=
# PREVIEW_MAX_PER_REPOSITORY=10
# PREVIEW_OCI_RUNTIME=runsc   # optional gVisor, if installed on the Docker host

# Routing (worker; used once execution is connected). Configured when
# PREVIEW_BASE_DOMAIN is set above; then the worker also needs APP_BASE_URL
# (unknown preview hosts are redirected to its /previews/unavailable page) and
# a directory it shares with the router. Keep that directory on a Linux
# filesystem (not /mnt/c): Traefik watches it for changes.
# APP_BASE_URL=https://previa.example.com
# ROUTER_DYNAMIC_DIR=/var/lib/previa/router
# ROUTER_CONTAINER=previa-router
# ROUTER_ENTRYPOINT=websecure
# ROUTER_API_ADDRESS=127.0.0.1:8080

# Router (make router-up; read by deploy/traefik/compose.yml, not by Go).
# Let's Encrypt staging is the default CA: switch ACME_CA_SERVER to
# https://acme-v02.api.letsencrypt.org/directory only after staging issued a
# certificate. The DNS credential lives in its own chmod 600 file; name the
# lego variable that reads it (CF_DNS_API_TOKEN for cloudflare, for example).
# ACME_EMAIL=ops@example.com
# ACME_DNS_PROVIDER=cloudflare
# ACME_DNS_CREDENTIAL_VARIABLE=CF_DNS_API_TOKEN
# ACME_DNS_CREDENTIAL_FILE=/etc/previa/dns-credential
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
