# =============================================================================
# Previa configuration for local development
# =============================================================================
# cp .env.example .env, then replace every placeholder: values containing
# "replace-with", "/home/you", "you@", "your-" or "123456".
# Labels:
#   [Required]                the server or worker does not start without it
#   [Required for <step>]     that step of the app does not work without it
#   [Optional, default <x>]   already set to its default; change only if needed
# Step-by-step instructions for every value: technical-docs/config-setup.md
# make run-server, make run-worker, make dev and the make test-* targets load
# this file (exported variables win). Syntax: NAME=value, no spaces around "=",
# no inline comments. Never commit or share your .env. Production uses
# deploy/production/previa.env.example.
# =============================================================================

# --- Shared: server, worker and migrations -----------------------------------

# [Required] PostgreSQL for app data, sessions and jobs; matches deploy/docker-compose.yml (server, worker, migrate).
DATABASE_URL=postgres://previa:change-me@localhost:5432/previa?sslmode=disable
# [Optional, default development] development or production; production enforces HTTPS and stricter checks (server, worker).
APP_ENV=development
# [Optional, default info] Log detail: debug, info, warn or error (server, worker, egress proxy).
LOG_LEVEL=info
# [Optional, default empty] Sentry project DSN: warnings and errors also go to Sentry; keep empty locally (server, worker).
SENTRY_DSN=

# --- Server: dashboard, sign-in and webhooks ---------------------------------

# [Optional, default 127.0.0.1:8080] Address the dashboard listens on (server).
HTTP_ADDR=127.0.0.1:8080
# [Required for sign-in and previews] The dashboard's public URL, HTTPS except on localhost (server, worker).
APP_BASE_URL=http://localhost:8080
# [Required] Client ID of your GitHub OAuth App, used for sign-in (server).
GITHUB_OAUTH_CLIENT_ID=Ov23li-replace-with-oauth-client-id
# [Required] Client secret of your GitHub OAuth App, used for sign-in (server).
GITHUB_OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret
# [Required] Random secret that signs sign-in state, at least 32 characters: openssl rand -hex 32 (server).
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32-xxxxxxxxxxxx
# [Required for live updates and Automatic builds] Verifies GitHub webhooks; same value as the App's webhook secret (server).
GITHUB_WEBHOOK_SECRET=replace-with-output-of-openssl-rand-hex-32
# [Optional, default 127.0.0.1:9090] Internal /livez, /readyz and /metrics listener; never publish it (server).
INTERNAL_ADDR=127.0.0.1:9090
# [Optional, default empty = trust nobody] Reverse proxies allowed to set X-Forwarded headers (server).
TRUSTED_PROXIES=
# [Optional, default empty = off] File the backup script touches after each backup, for alerts (server).
BACKUP_STATUS_FILE=

# --- GitHub App: repositories, sync, builds and PR feedback ------------------

# [Required for repositories] The GitHub App's numeric App ID (server, worker).
GITHUB_APP_ID=123456
# [Required for repositories] Full path of the App's private key file (.pem, chmod 600) (server, worker).
GITHUB_APP_PRIVATE_KEY_PATH=/home/you/.config/previa/github-app.private-key.pem
# [Required for repositories] The App's URL name, from github.com/apps/<slug> (server).
GITHUB_APP_SLUG=your-app-slug
# [Required for repositories] The GitHub App's own Client ID (server).
GITHUB_APP_CLIENT_ID=Iv23li-replace-with-app-client-id
# [Required for repositories] The GitHub App's own client secret (server).
GITHUB_APP_CLIENT_SECRET=replace-with-app-client-secret

# --- Repository secrets keyring ----------------------------------------------

# [Required for repository secrets] Encryption keys as 1:<openssl rand -base64 32>; same in server and worker.
SECRETS_ENCRYPTION_KEYS=1:replace-with-output-of-openssl-rand-base64-32=
# [Required for repository secrets] Key version new values use (server, worker).
SECRETS_ACTIVE_KEY_VERSION=1

# --- Worker: builds and capacity ---------------------------------------------

# [Required] Builds that may run at once, across all workers (worker).
MAX_CONCURRENT_BUILDS=2
# [Optional, default 12m] Overall source/build/start deadline, at most 24h; repository build_timeout must fit it (worker).
BUILD_TIMEOUT=12m
# [Optional, default 127.0.0.1:9091] Internal /livez, /readyz and /metrics listener (worker).
WORKER_INTERNAL_ADDR=127.0.0.1:9091
# [Optional, default false] Kill switch: true stops new builds; teardown and cleanup keep running (worker).
BUILDS_PAUSED=false
# [Optional, default 2] CPUs each build may use, 0.25-64 (worker).
BUILD_CPUS=2
# [Optional, default 4GiB] Memory each build may use, at least 256MiB (worker).
BUILD_MEMORY=4GiB
# [Optional, default 2048] Processes each build may run, 128-65536 (worker).
BUILD_PIDS=2048
# [Optional, default 20GiB] Disk one build may use, at least 1GiB (worker).
BUILD_DISK_BUDGET=20GiB
# [Optional, default 4GiB] Largest image a build may produce (worker).
BUILD_MAX_IMAGE_SIZE=4GiB
# [Optional, default 15GiB] Free disk the Docker host keeps; builds wait below it (worker).
BUILD_MIN_FREE_DISK=15GiB
# [Optional, default 0 = no extra ceiling] Additional concurrent-build safety ceiling per workspace, 0-1000 (worker). The finite free plan still applies.
BUILDS_PER_ACCOUNT=0
# [Optional, default 0 = no extra ceiling] Additional UTC-day build-minute safety ceiling per workspace, 0-1440 (worker). It cannot enlarge the free allowance.
BUILD_MINUTES_PER_ACCOUNT_DAY=0
# [Optional, default open] What builds may reach: open (any public host on ports 80 and 443) or registries (package and image registries only) (worker).
BUILD_EGRESS=open
# [Optional, default empty] More hosts builds may reach with BUILD_EGRESS=registries, comma-separated; .example.com allows its subdomains (worker).
BUILD_EGRESS_HOSTS=
# [Optional, default previa-egress:dev] Egress proxy image; build it once with make egress-image (worker).
EGRESS_IMAGE=previa-egress:dev
# [Optional, default empty = the pinned rootless BuildKit v0.33.1 image] BuildKit image for builds (worker).
BUILDKIT_IMAGE=
# [Optional, default empty = previa-sources in the temp directory] Where build sources are unpacked; a full Linux path (worker).
SOURCE_WORKSPACE_ROOT=

# --- Worker: previews ---------------------------------------------------------

# [Optional, default false] Let previews run as root (weaker isolation) (worker).
PREVIEW_ALLOW_ROOT=false
# [Optional, default false] Let previews write outside /tmp (weaker isolation) (worker).
PREVIEW_WRITABLE_ROOTFS=false
# [Optional, default 256MiB] Size of each preview's /tmp, 16MiB-4GiB (worker).
PREVIEW_TMPFS_SIZE=256MiB
# [Optional, default 512] Processes each preview may run, 64-65536 (worker).
PREVIEW_PIDS=512
# [Optional, default 120s] Time a preview has to pass its health check, 5s-30m (worker).
PREVIEW_STARTUP_TIMEOUT=120s
# [Optional, default 0 = 60% of Docker's memory] Memory all previews may use together (worker).
PREVIEW_MEMORY_BUDGET=0
# [Optional, default 0 = 75% of Docker's CPUs] CPUs all previews may use together (worker).
PREVIEW_CPU_BUDGET=0
# [Optional, default 10] Running previews allowed per repository, 1-1000 (worker).
PREVIEW_MAX_PER_REPOSITORY=10
# [Optional, default 0 = no limit] Running previews allowed per account, 0-10000 (worker).
PREVIEW_MAX_PER_ACCOUNT=0
# [Optional, default 0 = never] Time without a visit after which a preview's app stops until the next visit wakes it, 15m-168h (worker).
PREVIEW_IDLE_SLEEP=0
# [Optional, default empty = Docker's runtime] Docker runtime for previews, for example runsc (worker).
PREVIEW_OCI_RUNTIME=
# [Optional, default empty = Previa's pinned PostgreSQL 17/16, Redis 8/7 and MySQL 8.4 images] Backend services previews may request, kind:version=image@sha256:digest pairs; none offers none (worker).
PREVIEW_SERVICE_CATALOG=
# [Optional, default 5m] Time a preview's setup command (migrations) or seed command may run, 10s-30m (worker).
PREVIEW_SETUP_TIMEOUT=5m
# [Optional, default empty = previa-baselines in the system temporary directory] Absolute directory for encrypted test-data baselines; needs SECRETS_ENCRYPTION_KEYS (worker).
PREVIEW_BASELINE_DIR=
# [Optional, default 64MiB] Compressed size limit of one baseline dump, 1MiB-4GiB (worker).
PREVIEW_BASELINE_MAX_SIZE=64MiB
# [Optional, default 2m] Time one test-data copy or restore (kept data or a baseline) may take, 10s-30m (worker).
PREVIEW_DATA_COPY_TIMEOUT=2m
# [Optional, default 1h] Least time between automatic baseline refreshes of one repository, 1m-24h (worker).
PREVIEW_BASELINE_MIN_INTERVAL=1h
# [Optional, default 5432,3306,6379,6380,27017,5671,5672,9092,1433] Ports owners may approve for outbound connections; none turns them off (server, worker).
PREVIEW_OUTBOUND_PORTS=5432,3306,6379,6380,27017,5671,5672,9092,1433

# --- Preview domain and router ------------------------------------------------

# [Required for previews] Domain previews live under; preview.localtest.me works on one machine (server, worker, router).
PREVIEW_BASE_DOMAIN=preview.localtest.me
# [Required for previews] Full path where the worker writes routes for the router; no ~ (worker, router).
ROUTER_DYNAMIC_DIR=/home/you/.local/share/previa/router
# [Optional, default previa-router] Name of the router container (worker, router).
ROUTER_CONTAINER=previa-router
# [Optional, default websecure] The router's HTTPS entry point (worker).
ROUTER_ENTRYPOINT=websecure
# [Optional, default 127.0.0.1:8080] The router's API address inside its container (worker).
ROUTER_API_ADDRESS=127.0.0.1:8080
# [Optional, default empty = ROUTER_API_ADDRESS] Where the router serves Prometheus metrics inside its container; preview visit counts come from it (worker).
ROUTER_METRICS_ADDRESS=
# [Required for private previews, otherwise empty] The server's /previews/auth as the router container reaches it (all routing workers).
# Without it the UI blocks enabling private previews; existing private routes deny access and publication reports private_preview_unconfigured.
PREVIEW_ACCESS_URL=
# [Required for previews] E-mail for the certificate account; any address on one machine (router).
ACME_EMAIL=you@example.com
# [Required for previews] DNS provider that proves the preview domain, for example cloudflare (router).
ACME_DNS_PROVIDER=cloudflare
# [Required for previews] Variable that provider reads its API token from, for example CF_DNS_API_TOKEN (router).
ACME_DNS_CREDENTIAL_VARIABLE=CF_DNS_API_TOKEN
# [Required for previews] Full path of a chmod 600 file holding the DNS API token; any text on one machine (router).
ACME_DNS_CREDENTIAL_FILE=/home/you/.config/previa/dns-credential
# [Required for previews] Certificate authority; https://127.0.0.1:1/directory requests none on one machine (router).
ACME_CA_SERVER=https://127.0.0.1:1/directory
# [Optional, default /acme/acme.json] Certificate account and key storage inside the persistent /acme volume (local/staging Compose only).
# Use /acme/acme-production.json with the production CA; staging certificates are not trusted by browsers.
ACME_STORAGE_FILE=/acme/acme.json
# [Optional, default 1.1.1.1:53,8.8.8.8:53] DNS resolvers used to check the certificate challenge (router).
ACME_DNS_RESOLVERS=1.1.1.1:53,8.8.8.8:53

# --- Housekeeping -------------------------------------------------------------

# [Optional, default 48] Hours a preview lives after its latest publication; 0 = forever (worker).
ENV_TTL_HOURS=48
# [Optional, default 14] Days a finished build's logs are kept, 1-90 (server, worker).
BUILD_LOG_RETENTION_DAYS=14
# [Optional, default false] Log what housekeeping would delete instead of deleting it (worker).
HOUSEKEEPING_DRY_RUN=false
# [Optional, default 15m] Minimum age before unused containers, images or networks are removed, 1m-24h (worker).
HOUSEKEEPING_GRACE=15m
# [Optional, default 40GiB] Space all build caches may use together, at least 1GiB (worker).
BUILD_CACHE_BUDGET=40GiB

# --- Tests and tooling (make targets only) ------------------------------------

# [Optional, default empty = DATABASE_URL] PostgreSQL for the make test-* integration suites.
TEST_DATABASE_URL=
# [Optional, default empty = skip] Installation ID for the live GitHub checks (make test-github-app, test-source, test-reporting).
TEST_GITHUB_INSTALLATION_ID=
# [Optional, default empty = skip] Repository ID for the live GitHub checks.
TEST_GITHUB_REPO_ID=
# [Optional, default empty = skip] A disposable open PR number for the live GitHub checks (test-reporting writes to it).
TEST_GITHUB_PR_NUMBER=
# [Optional, default 0] 1 prints the worker's and router's logs during make test-e2e.
TEST_E2E_LOG=0
# [Optional, default 0] 1 prints the router's logs during make test-routing.
TEST_ROUTING_LOG=0
# [Optional, default empty] Extra source workspace directory for make housekeeping-dry-run.
WORKSPACES=
# [Optional, default 8090] Port of the River UI job queue view (make river-ui), on loopback only.
RIVER_UI_PORT=8090

# Command line only (no effect in this file): ENV_FILE, UI_BROWSER_EXECUTABLE,
# UI_BROWSER_SCREENSHOTS, PREVIA_VERSION, SMOKE_OLD_DUMP, SMOKE_KEEP, for example
#   UI_BROWSER_EXECUTABLE=/snap/bin/chromium make test-browser
# See technical-docs/config-setup.md.
# F4: customer contact, operator authorization and retention.
# Set your real contact email. Contact details are read from env, not templates.
# [Optional, default empty] Contact email displayed on Help and policy pages (server).
SUPPORT_EMAIL=
# [Optional, default Previa operator] Operator name displayed in policy text (server).
OPERATOR_NAME="Previa operator"
# Operators may read/resolve support requests and publish public incidents.
# Comma-separated NUMERIC GitHub user IDs, not logins or workspace roles.
# Find yours on Your profile > GitHub account > GitHub ID, or the "id" field at
# https://api.github.com/users/YOUR_LOGIN. Example format: 1234567,7654321.
# Empty is the placeholder: nobody has operator access until explicitly configured.
# Operators also approve early access, so with EARLY_ACCESS_ENABLED=true an empty value
# makes a production server refuse to start (a development server logs a warning).
# [Optional, default empty; required in production while early access is on] Immutable numeric GitHub IDs allowed into the audited operator console (server).
SUPPORT_OPERATOR_GITHUB_IDS=
# [Optional, default 16384] Maximum support message size in UTF-8 bytes (server).
SUPPORT_MESSAGE_MAX_BYTES=16384
# [Optional, default 5] Support submissions per member per UTC day (server).
SUPPORT_REQUESTS_PER_DAY=5
# Open support requests are retained until resolved or explicitly erased.
# [Optional, default 90] Days to keep resolved support requests (server, worker).
SUPPORT_RETENTION_DAYS=90
# Must exceed BACKUP_RETENTION_DAYS; the exporter fails closed on size overflow.
# [Optional, default 90] Minimum encrypted deletion-journal retention in days (server command).
DELETION_JOURNAL_RETENTION_DAYS=90
# [Optional, default 1048576] Maximum plaintext journal export size in bytes (server command).
DELETION_JOURNAL_MAX_BYTES=1048576
# [Optional, default 30] Encrypted backup retention in days; must be shorter than the deletion journal (backup script, policies).
BACKUP_RETENTION_DAYS=30

# Early access: existing workspaces stay approved at migration; new ones await
# approval at /operator/early-access by SUPPORT_OPERATOR_GITHUB_IDS operators
# (production refuses to start with early access on and no operator).
# [Optional, default true] Gate repository connections and all new compute (server/worker).
EARLY_ACCESS_ENABLED=true
# [Optional, default 5] Maximum automatic reconciliation removals per pass (1-100).
# Revoking every known installation always stops for operator review.
INSTALLATION_RECONCILE_MAX_CHANGES=5

# Optional Google Web OAuth client. Configure both to offer Google sign-in.
# Authorized redirect URI: APP_BASE_URL/auth/google/callback (exact origin/path).
# [Optional, default empty] Google Web client ID; set together with the secret.
GOOGLE_OAUTH_CLIENT_ID=
# [Optional, default empty] Google Web client secret; both blank disables Google.
GOOGLE_OAUTH_CLIENT_SECRET=
