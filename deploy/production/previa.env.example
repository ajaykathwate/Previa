# Previa production settings: copy to /etc/previa/previa.env (root:root, mode
# 600). deploy/production/setup.sh creates it with generated secrets. The same
# file feeds Compose interpolation (--env-file) and the containers (env_file).
# docs/25-production-deployment.md explains each group and gives build and
# preview budgets for small and larger hosts; technical-docs/config-setup.md
# explains every setting with its default.

# Release: the tag checked out in /opt/previa. The server builds the three
# images from that checkout (docs/25 Step 7), tagged with this version.
PREVIA_VERSION=v0.1.0
# Only when pulling images published by the optional Release workflow instead:
# PREVIA_SERVER_IMAGE=ghcr.io/OWNER/previa-server
# PREVIA_WORKER_IMAGE=ghcr.io/OWNER/previa-worker
# PREVIA_EGRESS_IMAGE=ghcr.io/OWNER/previa-egress
# Group that owns /var/run/docker.sock (setup.sh fills it in).
DOCKER_GID=

# Database (the postgres service on the Compose network)
POSTGRES_PASSWORD=
DATABASE_URL=postgres://previa:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/previa?sslmode=disable

# Dashboard and landing page
APP_BASE_URL=https://previa.live
PREVIA_DASHBOARD_HOST=previa.live
SESSION_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
LOG_LEVEL=info
# Sentry project DSN (Settings -> Projects -> previa -> Client Keys). The
# server and worker report warnings and errors to it, and the backup checks in
# with its cron monitor; empty turns all of that off.
SENTRY_DSN=

# GitHub App (installation linking, discovery, builds, PR feedback). The key
# is a file: /etc/previa/github-app.pem, owned by UID 65532, mode 600.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_FILE=/etc/previa/github-app.pem
GITHUB_WEBHOOK_SECRET=

# Repository secrets keyring (back up the keys offline; without them stored
# secrets cannot be decrypted after a restore).
SECRETS_ENCRYPTION_KEYS=
SECRETS_ACTIVE_KEY_VERSION=1

# Previews: a separate registrable domain (not under previa.live) whose
# wildcard record *.preview.<domain> points here. Replace example.net with it.
PREVIEW_BASE_DOMAIN=preview.example.net
ROUTER_ENTRYPOINT=websecure
ROUTER_API_ADDRESS=127.0.0.1:8080
# Sized for the guide's VPS-2 (4 vCores / 8 GB / 75 GB); the worker warns at
# start when these exceed the host. Larger hosts: see "Starter settings for a
# small host" in docs/25-production-deployment.md and raise them together.
MAX_CONCURRENT_BUILDS=1
BUILD_TIMEOUT=12m
BUILD_CPUS=2
BUILD_MEMORY=2GiB
BUILD_DISK_BUDGET=10GiB
BUILD_MAX_IMAGE_SIZE=2GiB
BUILD_MIN_FREE_DISK=10GiB
BUILD_CACHE_BUDGET=10GiB
PREVIEW_MEMORY_BUDGET=4GiB
PREVIEW_CPU_BUDGET=4
PREVIEW_MAX_PER_REPOSITORY=2
ENV_TTL_HOURS=24
# Fair sharing between accounts on a shared server (docs/17-build-scheduling.md):
# one build at a time per account, at most 4 previews and 120 build minutes
# a day each (0 = no limit). Waiting builds take turns by account either way.
BUILDS_PER_ACCOUNT=1
PREVIEW_MAX_PER_ACCOUNT=4
BUILD_MINUTES_PER_ACCOUNT_DAY=120
# Previews nobody opened for 3 hours stop until the next visit wakes them,
# freeing their memory (docs/10-preview-runtime.md); 0 keeps them running.
PREVIEW_IDLE_SLEEP=3h
# What builds may reach: open (any public HTTP(S) host) or registries
# (package and image registries only, plus BUILD_EGRESS_HOSTS).
BUILD_EGRESS=open
# BUILD_EGRESS_HOSTS=npm.example.com,.mirror.example.com
# Days a finished build's logs are kept (1-90). Deleted data leaves the
# backups within BACKUP_RETENTION_DAYS.
BUILD_LOG_RETENTION_DAYS=14
# BUILDS_PAUSED=true   # execution kill switch (docs/24-incident-runbook.md)
# Backend previews (docs/11-backend-previews.md): empty uses Previa's pinned
# PostgreSQL/Redis images; "none" offers none. Outbound ports: "none" turns
# owner-approved outbound connections off (server and worker read it).
# PREVIEW_SERVICE_CATALOG=
# PREVIEW_SETUP_TIMEOUT=5m
# PREVIEW_OUTBOUND_PORTS=5432,3306,6379,6380,27017,5671,5672,9092,1433
# Persistent test data (docs/32-persistent-test-data.md): the compose file
# keeps encrypted baselines on the worker's baselines volume
# (PREVIEW_BASELINE_DIR=/var/lib/previa/baselines); they are derived data and
# not backed up. They use SECRETS_ENCRYPTION_KEYS.
# PREVIEW_BASELINE_MAX_SIZE=64MiB
# PREVIEW_DATA_COPY_TIMEOUT=2m
# PREVIEW_BASELINE_MIN_INTERVAL=1h

# Router certificates: previews over DNS-01 (token in a chmod 600 file),
# the dashboard over TLS-ALPN-01. Staging first; production only after a
# staging certificate was issued.
ACME_EMAIL=ops@example.com
ACME_DNS_PROVIDER=cloudflare
ACME_DNS_CREDENTIAL_VARIABLE=CF_DNS_API_TOKEN
ACME_DNS_CREDENTIAL_FILE=/etc/previa/dns-credential
ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Backups (deploy/production/backup.sh): an age public key (the private key
# stays offline) and an rclone remote or an absolute directory.
BACKUP_AGE_RECIPIENT=
BACKUP_REMOTE=
BACKUP_RETENTION_DAYS=30

# Only for the optional observability profile (Prometheus and Grafana), which
# this deployment does not run; setup.sh generates it anyway.
GRAFANA_ADMIN_PASSWORD=

# Account exits, support and policy configuration (docs/34).
# [Optional, default empty] Contact email displayed on Help and policy pages (server).
SUPPORT_EMAIL=
# [Optional, default Previa operator] Operator name displayed in policy text (server).
OPERATOR_NAME="Previa operator"
# Operators may read/resolve support requests and publish public incidents.
# Comma-separated NUMERIC GitHub user IDs, not logins or workspace roles.
# Find yours on Your profile > GitHub account > GitHub ID, or the "id" field at
# https://api.github.com/users/YOUR_LOGIN. Example format: 1234567,7654321.
# Empty is the placeholder: nobody has operator access until explicitly configured.
# Operators also approve early access, so with EARLY_ACCESS_ENABLED=true an empty value
# makes a production server refuse to start (a development server logs a warning).
# [Optional, default empty; required in production while early access is on] Immutable numeric GitHub IDs allowed into the audited operator console (server).
SUPPORT_OPERATOR_GITHUB_IDS=
# [Optional, default 16384] Maximum support message size in UTF-8 bytes (server).
SUPPORT_MESSAGE_MAX_BYTES=16384
# [Optional, default 5] Support submissions per member per UTC day (server).
SUPPORT_REQUESTS_PER_DAY=5
# Open support requests are retained until resolved or explicitly erased.
# [Optional, default 90] Days to keep resolved support requests (server, worker).
SUPPORT_RETENTION_DAYS=90
# Must exceed BACKUP_RETENTION_DAYS; the exporter fails closed on size overflow.
# [Optional, default 90] Minimum encrypted deletion-journal retention in days (server command).
DELETION_JOURNAL_RETENTION_DAYS=90
# [Optional, default 1048576] Maximum plaintext journal export size in bytes (server command).
DELETION_JOURNAL_MAX_BYTES=1048576
# [Optional, default 30] Encrypted backup retention in days; must be shorter than the deletion journal (backup script, policies).

# Early access: existing workspaces stay approved at migration; new ones await
# approval at /operator/early-access by SUPPORT_OPERATOR_GITHUB_IDS operators
# (production refuses to start with early access on and no operator).
# [Optional, default true] Gate repository connections and all new compute (server/worker).
EARLY_ACCESS_ENABLED=true
# [Optional, default 5] Maximum automatic reconciliation removals per pass (1-100).
# Revoking every known installation always stops for operator review.
INSTALLATION_RECONCILE_MAX_CHANGES=5

# Optional Google Web OAuth client. Configure both to offer Google sign-in.
# Authorized redirect URI: APP_BASE_URL/auth/google/callback (exact origin/path).
# [Optional, default empty] Google Web client ID; set together with the secret.
GOOGLE_OAUTH_CLIENT_ID=
# [Optional, default empty] Google Web client secret; both blank disables Google.
GOOGLE_OAUTH_CLIENT_SECRET=
