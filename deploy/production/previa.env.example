# Previa production settings: copy to /etc/previa/previa.env (root:root, mode
# 600). deploy/production/setup.sh creates it with generated secrets. The same
# file feeds Compose interpolation (--env-file) and the containers (env_file).
# docs/25-production-deployment.md explains each group and gives build and
# preview budgets for small and larger hosts; technical-docs/config-setup.md
# explains every setting with its default.

# Release
PREVIA_VERSION=v0.1.0
# PREVIA_SERVER_IMAGE=ghcr.io/OWNER/previa-server
# PREVIA_WORKER_IMAGE=ghcr.io/OWNER/previa-worker
# PREVIA_EGRESS_IMAGE=ghcr.io/OWNER/previa-egress
# Group that owns /var/run/docker.sock (setup.sh fills it in).
DOCKER_GID=

# Database (the postgres service on the Compose network)
POSTGRES_PASSWORD=
DATABASE_URL=postgres://previa:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/previa?sslmode=disable

# Dashboard
APP_BASE_URL=https://previa.example.com
PREVIA_DASHBOARD_HOST=previa.example.com
SESSION_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
LOG_LEVEL=info

# GitHub App (installation linking, discovery, builds, PR feedback). The key
# is a file: /etc/previa/github-app.pem, owned by UID 65532, mode 600.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_FILE=/etc/previa/github-app.pem
GITHUB_WEBHOOK_SECRET=

# Repository secrets keyring (back up the keys offline; without them stored
# secrets cannot be decrypted after a restore).
SECRETS_ENCRYPTION_KEYS=
SECRETS_ACTIVE_KEY_VERSION=1

# Previews: a separate registrable domain whose wildcard record points here.
PREVIEW_BASE_DOMAIN=preview.example.net
ROUTER_ENTRYPOINT=websecure
ROUTER_API_ADDRESS=127.0.0.1:8080
MAX_CONCURRENT_BUILDS=2
BUILD_TIMEOUT=12m
ENV_TTL_HOURS=48
# BUILDS_PAUSED=true   # execution kill switch (docs/24-incident-runbook.md)
# Backend previews (docs/11-backend-previews.md): empty uses Previa's pinned
# PostgreSQL/Redis images; "none" offers none. Outbound ports: "none" turns
# owner-approved outbound connections off (server and worker read it).
# PREVIEW_SERVICE_CATALOG=
# PREVIEW_SETUP_TIMEOUT=5m
# PREVIEW_OUTBOUND_PORTS=5432,3306,6379,6380,27017,5671,5672,9092,1433

# Router certificates: previews over DNS-01 (token in a chmod 600 file),
# the dashboard over TLS-ALPN-01. Staging first; production only after a
# staging certificate was issued.
ACME_EMAIL=ops@example.com
ACME_DNS_PROVIDER=cloudflare
ACME_DNS_CREDENTIAL_VARIABLE=CF_DNS_API_TOKEN
ACME_DNS_CREDENTIAL_FILE=/etc/previa/dns-credential
ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Backups (deploy/production/backup.sh): an age public key (the private key
# stays offline) and an rclone remote or an absolute directory.
BACKUP_AGE_RECIPIENT=
BACKUP_REMOTE=
BACKUP_RETENTION_DAYS=30
# BACKUP_FAILURE_WEBHOOK=https://hooks.example.com/...

# Observability profile (Grafana on 127.0.0.1:3000 only)
GRAFANA_ADMIN_PASSWORD=
