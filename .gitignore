# Go build outputs and test artifacts.
/bin/
/tmp/
/dist/
*.exe
*.exe~
*.test
*.out
*.prof
/coverage/
/coverage.xml

# templ-generated Go and development artifacts.
*_templ.go
*_templ.txt
/.templ/
/web/static/css/app.css
/web/static/css/app.css.*

# Local configuration and secrets; retain the documented example.
.env
.env.*
!.env.example
*.pem
*.key

# Editor and operating-system files.
.idea/
.vscode/
.DS_Store
Thumbs.db

# Optional browser test dependencies and screenshots.
/web/tests/browser/node_modules/
/web/tests/browser/artifacts/

# Router DNS credentials, if ever placed next to the router configuration.
/deploy/traefik/*credential*
