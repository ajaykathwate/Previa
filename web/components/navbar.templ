package components

import "github.com/ajaykathwatee/previa/web/components/button"

// BrandMark is the stacked-preview logo: a commit frame with a live lens.
templ BrandMark() {
	<svg class="brand-mark" viewBox="0 0 28 28" width="26" height="26" aria-hidden="true">
		<rect x="1.5" y="1.5" width="18" height="18" rx="5.5" fill="none" stroke="currentColor" stroke-width="2" opacity=".32"></rect>
		<rect x="8" y="8" width="18.5" height="18.5" rx="5.5" class="brand-mark-front"></rect>
		<circle cx="17.25" cy="17.25" r="3.4" class="brand-mark-lens"></circle>
	</svg>
}

templ Brand() {
	<a href="/" class="brand" aria-label="Previa home">
		@BrandMark()
		<span class="brand-word">previa<span class="brand-period">.</span></span>
	</a>
}

// ThemeToggle is a progressive enhancement; without JavaScript the OS theme applies.
templ ThemeToggle() {
	<button type="button" class="icon-button theme-toggle" data-theme-toggle aria-label="Switch colour theme" title="Switch colour theme">
		@SunIcon()
		@MoonIcon()
	</button>
}

templ Navbar(loggedIn bool) {
	<header class="site-header">
		<nav aria-label="Main navigation" class="site-container site-nav">
			@Brand()
			<div class="site-nav-links"><a href="/#why" class="nav-link-wide">Why Previa</a><a href="/#how-it-works">How it works</a><a href="/#features">Features</a><a href="/#security" class="nav-link-wide">Security</a><a href="/open-source-tests" class="nav-link-wide">Open Source Tests</a><a href="/#faq">FAQ</a></div>
			<div class="site-nav-actions">
				@ThemeToggle()
				if loggedIn {
					@button.Button(button.Props{Href: LandingURL(ctx), Class: "nav-cta"}) {
						Open dashboard
						@Arrow()
					}
				} else {
					@button.Button(button.Props{Href: "/auth/github/login", Class: "nav-cta"}) {
						<span class="hidden sm:inline">Get started</span><span class="sm:hidden">Sign in</span>
						@Arrow()
					}
				}
			</div>
		</nav>
	</header>
}
