package components

templ Navbar() {
	<header class="border-b bg-card">
		<nav aria-label="Main navigation" class="mx-auto flex max-w-5xl items-center px-4 py-4 sm:px-6">
			<a href="/" class="rounded-md text-lg font-semibold tracking-tight focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring">Previa</a>
			<span class="ml-auto text-sm text-muted-foreground">Preview platform</span>
		</nav>
	</header>
}
