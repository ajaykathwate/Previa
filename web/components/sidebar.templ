package components

templ SidebarContent(active NavItem) {
	<div class="sidebar-label">WORKSPACE</div>
	<nav aria-label="Workspace navigation" class="sidebar-nav">
		@WorkspaceLink("/dashboard", "Overview", "◈", NavOverview, active)
		@WorkspaceLink("/repositories", "Repositories", "⌘", NavRepositories, active)
		@WorkspaceLink("/environments", "Environments", "◎", NavEnvironments, active)
		@WorkspaceLink("/builds", "Builds", "↗", NavBuilds, active)
		@WorkspaceLink("/developer-tools", "Developer tools", "↗", NavTools, active)
	</nav>
	<div class="sidebar-note">
		<span class="eyebrow">A little room to grow</span>
		<p>One place for the work between a pull request and a merge.</p>
		<a href="/#workflow">
			Explore the vision
			@Arrow()
		</a>
	</div>
}

templ Sidebar(active NavItem) {
	<aside class="app-sidebar">
		<div class="sidebar-brand">
			@Brand()
			<span class="version-label">EARLY ACCESS</span>
		</div>
		@SidebarContent(active)
		<div class="sidebar-bottom"><span class="status-dot" aria-hidden="true"></span>Built to be yours.<span>Self-hosted by design</span></div>
	</aside>
}

// WorkspaceLink renders identical desktop/mobile navigation with explicit selection.
templ WorkspaceLink(href string, label string, symbol string, item NavItem, active NavItem) {
	<a
		href={ href }
		if active==item {
			aria-current="page"
		}
	>
		<span class="nav-symbol" aria-hidden="true">
			if symbol == "↗" {
				@ArrowUpRight()
			} else {
				{ symbol }
			}
		</span>{ label }
		if active==item {
			<span class="active-dot" aria-hidden="true"></span>
		}
	</a>
}
