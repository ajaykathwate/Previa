package components

// SidebarContent is the mobile drawer's navigation: the workspace switcher,
// the destinations, then help and tools.
templ SidebarContent(active NavItem) {
	@WorkspaceSwitcher()
	@SidebarNav(active)
	@SidebarUtility(active)
}

// SidebarNav lists the workspace's destinations: day-to-day work first, then
// the workspace's own people and settings.
templ SidebarNav(active NavItem) {
	<nav aria-label="Workspace navigation" class="sidebar-nav">
		<div class="nav-group">
			if CanOperate(ctx) {
				@WorkspaceLink("/dashboard", "Overview", OverviewIcon(), NavOverview, active)
				@WorkspaceLink("/repositories", "Repositories", RepositoryIcon(), NavRepositories, active)
				@WorkspaceLink("/builds", "Builds", BuildIcon(), NavBuilds, active)
			}
			@WorkspaceLink("/previews", "Previews", EnvironmentIcon(), NavPreviews, active)
			if CanOperate(ctx) {
				@WorkspaceLink("/starter-kits", "Starter kits", KitIcon(), NavStarterKits, active)
			}
		</div>
		if Workspace(ctx).ID>0 {
			<div class="nav-group">
				<p class="nav-group-label">Workspace</p>
				@WorkspaceLink(WorkspaceURL(Workspace(ctx).ID, "members"), "Members", TeamIcon(), NavMembers, active)
				if CanOperate(ctx) {
					@WorkspaceLink(WorkspaceURL(Workspace(ctx).ID, "usage"), "Usage", BuildIcon(), NavUsage, active)
				}
				if CanManage(ctx) {
					@WorkspaceLink(WorkspaceURL(Workspace(ctx).ID, "settings"), "Settings", WrenchIcon(), NavWorkspaceSettings, active)
				}
			</div>
		}
	</nav>
}

// SidebarUtility holds secondary destinations at the bottom of the sidebar.
templ SidebarUtility(active NavItem) {
	<nav aria-label="Help and tools" class="sidebar-utility">
		if CanManage(ctx) {
			@WorkspaceLink("/developer-tools", "Developer tools", TerminalIcon(), NavTools, active)
		}
		@WorkspaceLink("/faq", "Help & FAQ", QuestionIcon(), NavFAQ, active)
	</nav>
}

templ Sidebar(active NavItem) {
	<aside class="app-sidebar" aria-label="Workspace">
		<div class="sidebar-brand">
			@Brand()
			<span class="version-label">Early access</span>
		</div>
		<div class="sidebar-workspace">
			@WorkspaceSwitcher()
		</div>
		<div class="sidebar-scroll">
			@SidebarNav(active)
		</div>
		<div class="sidebar-bottom">
			@SidebarUtility(active)
		</div>
	</aside>
}

// WorkspaceLink renders identical desktop/mobile navigation with explicit selection.
templ WorkspaceLink(href string, label string, icon templ.Component, item NavItem, active NavItem) {
	<a
		href={ PublicURL(ctx, href) }
		class="nav-link"
		title={ label }
		if active==item {
			aria-current="page"
		}
	>
		<span class="nav-icon">
			@icon
		</span><span class="nav-label">{ label }</span>
	</a>
}
