package logviewer

import (
	"github.com/ajaykathwatee/previa/web/components"
	"strconv"
)

templ Viewer(p Panel) {
	<section
		class={ "workspace-panel", "log-panel", templ.KV("log-panel-inline", p.Inline) }
		aria-label="Build log events"
		data-log-panel
		data-log-source={ p.Source }
		data-log-query={ p.Query }
		if p.Inline {
			data-log-limit="300"
		}
		if p.EventsURL != "" {
			data-log-events={ p.EventsURL }
			data-log-cursor={ p.Cursor }
		}
	>
		<header class="log-panel-header">
			<div class="log-panel-title"><h2>Log events</h2><span class="log-panel-note">Secrets are masked</span></div>
			<nav class="log-pager" aria-label="Log tools">
				if p.EarlierURL != "" {
					<a class="log-tool" href={ templ.SafeURL(p.EarlierURL) } rel="prev">
						@components.ArrowLeft()
						Earlier lines
					</a>
				}
				<a
					class="log-tool"
					href={ templ.SafeURL(p.LatestURL) }
					if p.Inline {
						data-refresh-pr-logs
					}
				>
					@components.RestartIcon()
					Refresh
				</a>
				<button type="button" class="copy-button log-tool" data-copy-log-panel aria-label="Copy the lines shown">
					@components.CopyIcon()
					<span data-copy-status aria-live="polite">Copy</span>
				</button>
				if p.HasOutput {
					<a class="log-tool" href={ templ.SafeURL(p.DownloadURL) } download>
						@components.DownloadIcon()
						Download
					</a>
				}
				if p.CanDelete {
					<button type="button" class="log-tool log-tool-danger" data-open-dialog="delete-logs" commandfor="delete-logs" command="show-modal" aria-haspopup="dialog">
						@components.TrashIcon()
						Delete logs
					</button>
				}
				if p.EventsURL != "" {
					<label class="log-follow" hidden data-log-follow-control><input type="checkbox" checked data-log-follow/> Live tail</label>
				}
			</nav>
		</header>
		<form
			class="log-filters"
			method="get"
			action={ templ.SafeURL(p.BaseURL) }
			if p.Inline {
				hx-get={ p.BaseURL + "/recent" }
				hx-target="#pr-recent-log-content"
				hx-swap="innerHTML"
			}
		>
			<label class="log-source-filter">
				<span>Log source</span>
				<select name="source" aria-label="Log source" data-log-source-filter>
					<option value="all" selected?={ p.Source == "" || p.Source == "all" }>All logs</option>
					<option value="previa" selected?={ p.Source == "previa" }>Previa logs</option>
					<option value="application" selected?={ p.Source == "application" }>Application logs</option>
				</select>
			</label>
			<label class="log-search">
				<span class="sr-only">Find in logs</span>
				@components.SearchIcon()
				<input type="search" name="q" value={ p.Query } placeholder="Find text in logs" maxlength="200" aria-label="Find in logs"/>
			</label>
			<button type="submit" class="log-tool">Apply filters</button>
			<span class="log-source-key"><i class="log-source-previa"></i>Previa<i class="log-source-application"></i>Application</span>
		</form>
		<div class="log-table-heading" aria-hidden="true"><span>Line</span><span>Timestamp · message (UTC unless supplied by the app)</span></div>
		<p class="log-empty" data-log-empty hidden?={ len(p.Lines)>0 }>{ p.Empty }</p>
		<ol class="log-lines" aria-label="Build output" tabindex="0" data-log-lines>
			for _, line := range p.Lines {
				@Event(line)
			}
		</ol>
		<footer class="log-panel-footer">
			<span data-log-count>{ strconv.Itoa(len(p.Lines)) } events shown</span>
			<span class="log-live" data-log-connection aria-live="polite">
				if p.EventsURL != "" {
					Live updates off
				} else {
					Historical view
				}
			</span>
			if p.Inline {
				<span>Latest 300 matching events</span>
				<a class="log-tool" href={ templ.SafeURL(p.FullURL) }>
					View full build logs
					@components.ArrowUpRight()
				</a>
			}
			if p.LaterURL != "" {
				<a class="text-link" href={ templ.SafeURL(p.LaterURL) } rel="next">
					Later lines
					@components.Arrow()
				</a>
			}
		</footer>
	</section>
}

templ Event(line Line) {
	<li id={ line.Anchor() } class={ "log-line", templ.KV("log-system", line.System), templ.KV("log-error", line.IsError()) } data-log-source={ line.Source() }>
		<a class="log-number" href={ templ.SafeURL("#" + line.Anchor()) } tabindex="-1">{ line.Number() }</a>
		<span class="log-text"><span class="log-timestamp" title={ "Received at " + line.ISOTime() }>{ line.Timestamp() }</span>{ " "+line.Message() }</span>
	</li>
}
