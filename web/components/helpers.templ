package components

// Time shows an exact UTC time; ui.js rewrites it as a relative one ("3 min
// ago", "in 2 h") and keeps the exact time as its title. Without JavaScript the
// exact time stays.
templ Time(iso, label string) {
	if iso != "" {
		<time datetime={ iso } title={ label } data-relative>{ label }</time>
	}
}

// CopyButton copies value to the clipboard (ui.js); hidden without JavaScript,
// where the value next to it can be selected instead.
templ CopyButton(value, label string) {
	<button type="button" class="copy-button" data-copy={ value } aria-label={ label } title={ label }>
		@CopyIcon()
		<span data-copy-status aria-live="polite">Copy</span>
	</button>
}
