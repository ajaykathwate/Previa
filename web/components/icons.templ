	<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m4 6.5 1.5 1.5 3-3M4 13.5l1.5 1.5 3-3M11.5 7H20M11.5 14H20M11.5 19.5H20"></path></svg>
