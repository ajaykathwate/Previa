package components

// SiteFooter closes the public pages. Links point at the home page's sections
// so they work from any public page.
templ SiteFooter() {
	<footer class="site-footer">
		<div class="site-container footer-inner">
			<div class="footer-brand">
				@Brand()
				<p>A live preview for every pull request.</p>
			</div>
			<nav class="footer-links" aria-label="Footer">
				<a href="/#how-it-works">How it works</a>
				<a href="/#features">Features</a>
				<a href="/#available">What works today</a>
				<a href="/open-source-tests">Open Source Tests</a>
				<a href="/#faq">FAQ</a>
				<a href="#content" class="footer-top">
					Back to top
					@ArrowUp()
				</a>
			</nav>
		</div>
	</footer>
}
