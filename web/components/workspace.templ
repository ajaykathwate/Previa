package components

templ WorkspaceSwitcher() {
	if Workspace(ctx).ID > 0 {
		<details class="workspace-switcher" data-workspace-switcher>
			<summary title={ Workspace(ctx).Name } aria-label={ "Switch workspace: " + Workspace(ctx).Name }>
				@WorkspaceAvatar(Workspace(ctx).Name, Workspace(ctx).ID, Workspace(ctx).LogoVersion)
				<span class="workspace-switcher-label">
					<strong data-current-workspace-name>
						{ Workspace(ctx).Name }
					</strong>
					@WorkspaceRole(Workspace(ctx).Role)
				</span>
				<span class="workspace-switcher-chevron">
					@ChevronDownIcon()
				</span>
			</summary>
			<div class="workspace-switcher-menu">
				<p class="eyebrow">Switch workspace</p>
				for _, item := range Workspace(ctx).Items {
					<form method="post" action={ PublicURL(ctx, WorkspaceURL(item.ID, "select")) }>
						<input type="hidden" name="csrf_token" value={ Workspace(ctx).CSRF }/>
						<button type="submit" aria-current={ workspaceCurrent(Workspace(ctx).ID, item.ID) }>
							@WorkspaceAvatar(item.Name, item.ID, item.LogoVersion)
							<span>
								<strong>
									{ item.Name }
								</strong>
								@WorkspaceRole(item.Role)
							</span>
							if item.ID == Workspace(ctx).ID {
								@CheckIcon()
							}
						</button>
					</form>
				}
				<div class="workspace-switcher-shortcuts">
					<a href={ PublicURL(ctx, WorkspaceURL(Workspace(ctx).ID, "members")) }>
						@TeamIcon()
						<span>Members & invitations</span>
					</a>
					if CanManage(ctx) {
						<a href={ PublicURL(ctx, WorkspaceURL(Workspace(ctx).ID, "settings")) }>
							@WrenchIcon()
							<span>Workspace settings</span>
						</a>
					}
					<a href="/workspaces">
						@OverviewIcon()
						<span>All workspaces</span>
					</a>
				</div>
			</div>
		</details>
	} else {
		<a class="nav-link" href="/workspaces">Choose a workspace</a>
	}
}

templ WorkspaceAvatar(name string, id, version int64) {
	<span class="workspace-avatar" aria-hidden="true">
		{ WorkspaceInitial(name) }
		if version>0 {
			<img src={ PublicURL(ctx, WorkspaceLogoURL(id, version)) } alt="" width="64" height="64" decoding="async"/>
		}
	</span>
}

templ WorkspaceRole(role string) {
	<span class={ "badge tone-neutral team-role",templ.KV("team-role-owner",role=="owner") } data-workspace-role={ role }>{ RoleName(role) }</span>
}

func workspaceCurrent(id, want int64) string {
	if id == want {

		return "true"
	}
	return "false"
}
