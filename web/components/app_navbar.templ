package components

import "strings"

templ AppNavbar(username string, title string) {
	<header class="app-header">
		<div class="app-breadcrumb"><span>Workspace</span><span aria-hidden="true">/</span><strong>{ title }</strong></div>
		<div class="app-header-actions">
			<a class="back-to-site" href="/">
				Home page
				@Arrow()
			</a>
			<details class="account-menu" data-menu>
				<summary aria-label={ "Account menu for " + username }><span class="user-avatar">{ strings.ToUpper(string([]rune(username + "u")[0])) }</span><span class="account-name">{ username }</span><span class="account-chevron" aria-hidden="true">⌄</span></summary>
				<div class="account-popover">
					<span class="eyebrow">SIGNED IN WITH GITHUB</span><strong>{ username }</strong><a href="/protected">View session</a>
					<button type="button" commandfor="logout-confirmation" command="show-modal" data-open-dialog="logout-confirmation" aria-haspopup="dialog" aria-controls="logout-confirmation">
						Log out
						@Arrow()
					</button>
				</div>
			</details>
		</div>
	</header>
	<details class="mobile-workspace-nav" data-mobile-nav>
		<summary>Workspace navigation <span aria-hidden="true">⌄</span></summary>
		@SidebarContent(title == "Dashboard")
	</details>
}
