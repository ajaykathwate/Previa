package components

import "strings"

// Initial returns the avatar letter for a GitHub login.
func Initial(username string) string {
	return strings.ToUpper(string([]rune(username + "u")[0]))
}

// AppNavbar is the workspace header. Its trail names only the previous level
// (a link back, keeping that page's filters) and the current page.
templ AppNavbar(username string, current string, parent Crumb, active NavItem) {
	<header class="app-header">
		<details class="mobile-workspace-nav" data-mobile-nav>
			<summary aria-label="Workspace navigation">
				@MenuIcon()
			</summary>
			<div class="mobile-drawer">
				<div class="mobile-drawer-brand">
					@Brand()
					<span class="version-label">Early access</span>
				</div>
				@SidebarContent(active)
			</div>
			<span class="mobile-drawer-backdrop" data-mobile-nav-close aria-hidden="true"></span>
		</details>
		<nav class="app-breadcrumb" aria-label="Breadcrumb">
			if parent.Href != "" {
				<a class="app-breadcrumb-parent" href={ templ.SafeURL(parent.Href) } title={ "Back to " + parent.Label } data-trail-parent>
					<span class="app-breadcrumb-back" aria-hidden="true">
						@ArrowLeft()
					</span>
					<span class="app-breadcrumb-label">{ parent.Label }</span>
				</a>
			} else {
				<span class="app-breadcrumb-root">{ parent.Label }</span>
			}
			<span class="app-breadcrumb-sep" aria-hidden="true">/</span>
			<span class="app-breadcrumb-current" title={ current }>{ current }</span>
		</nav>
		<div class="app-header-actions">
			<button type="button" class="command-trigger" data-command-open aria-haspopup="dialog" aria-controls="command-palette">
				@SearchIcon()
				<span class="command-trigger-label">Search or jump to…</span>
				<kbd class="kbd" data-shortcut-label>Ctrl K</kbd>
			</button>
			@ThemeToggle()
			<details class="account-menu" data-menu>
				<summary aria-label={ "Account menu for " + username }>
					<span class="user-avatar" aria-hidden="true">{ Initial(username) }</span>
					<span class="account-name">{ username }</span>
					<span class="account-chevron">
						@ChevronDownIcon()
					</span>
				</summary>
				<div class="account-popover">
					<div class="account-identity">
						<span class="user-avatar user-avatar-lg" aria-hidden="true">{ Initial(username) }</span>
						<div><strong>{ username }</strong><span>Signed in with GitHub</span></div>
					</div>
					<a href="/protected">
						@UserIcon()
						View session
					</a>
					<a href="/">
						@HomeIcon()
						Home page
					</a>
					<button type="button" class="account-logout" commandfor="logout-confirmation" command="show-modal" data-open-dialog="logout-confirmation" aria-haspopup="dialog" aria-controls="logout-confirmation">
						@LogoutIcon()
						Log out
					</button>
				</div>
			</details>
		</div>
	</header>
}
