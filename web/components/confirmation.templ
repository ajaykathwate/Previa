package components

import "github.com/ajaykathwatee/previa/web/components/button"

// ConfirmationDialog keeps a decision over the current page. Actions are supplied
// by the caller; authorization and CSRF validation remain in backend handlers.
templ ConfirmationDialog(id string, title string, description string) {
	<dialog id={ id } class="confirmation-dialog" aria-labelledby={ id + "-title" } aria-describedby={ id + "-description" } data-confirmation-dialog>
		<button type="button" class="dialog-close" aria-label="Close confirmation" commandfor={ id } command="close" data-close-dialog><span aria-hidden="true">×</span></button>
		<span class="dialog-icon" aria-hidden="true">
			@InfoIcon()
		</span>
		<span class="eyebrow">Please confirm</span>
		<h2 id={ id + "-title" }>{ title }</h2>
		<p id={ id + "-description" }>{ description }</p>
		{ children... }
	</dialog>
}

templ LogoutConfirmation(csrfToken string) {
	@ConfirmationDialog("logout-confirmation", "Log out of your workspace?", "This ends your Previa session. You stay signed in to GitHub, so next time you sign in, GitHub asks which account to use.") {
		<form method="post" action="/auth/logout" class="dialog-actions">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{"autofocus": true, "commandfor": "logout-confirmation", "command": "close", "data-close-dialog": true}}) {
				Cancel
			}
			@button.Button(button.Props{Type: button.TypeSubmit}) {
				Confirm logout
			}
		</form>
	}
}

// CreateWorkspaceDialog is part of the app shell, so "Create workspace" opens
// over the current page; only a successful create navigates.
templ CreateWorkspaceDialog(csrfToken string) {
	@ConfirmationDialog("create-workspace", "Create a workspace", "Give your team a name. Next, you'll invite teammates and connect repositories.") {
		<form method="post" action="/workspaces" class="team-form create-workspace-form">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<label for="workspace-name">Workspace name</label>
			<input id="workspace-name" name="name" autofocus maxlength="80" required placeholder="Acme Engineering" autocomplete="off"/>
			<div class="dialog-actions">
				<button type="button" class="secondary-action" commandfor="create-workspace" command="close" data-close-dialog>Cancel</button>
				<button class="primary-action" type="submit">Create workspace</button>
			</div>
		</form>
	}
}
