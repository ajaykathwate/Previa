package workspaces

import "github.com/ajaykathwatee/previa/web/components"

templ Settings(p Page) {
	<div class="team-settings-grid">
		<div class="team-settings-main">
			<section class="workspace-panel team-settings-panel" aria-labelledby="details-heading">
				<div class="team-section-heading">
					<span class="team-section-icon">
						@components.OverviewIcon()
					</span>
					<div><h2 id="details-heading">Workspace details</h2><p>A recognizable name and a short description for your team.</p></div>
				</div>
				<form method="post" action={ templ.SafeURL(p.Base() + "/settings") } class="team-form team-profile-form" data-workspace-profile>
					@ProfileHidden(p)
					<label for="rename-workspace">Workspace name</label><input id="rename-workspace" name="name" value={ p.FormName } maxlength="80" required aria-describedby="name-help"/>
					<p id="name-help" class="team-field-hint">Shown in navigation, invitations and the workspace picker.</p>
					<label for="workspace-description">Description <span class="team-optional">Optional</span></label><textarea id="workspace-description" name="description" maxlength="240" rows="3" placeholder="What does this team work on?" aria-describedby="description-help">{ p.FormDescription }</textarea>
					<p id="description-help" class="team-field-hint">Up to 240 characters. Visible to workspace members.</p>
					<div class="team-form-footer"><span class="team-field-hint" data-profile-dirty role="status"></span><button type="submit" class="primary-action" data-profile-save>Save changes</button></div>
				</form>
			</section>
			<section class="workspace-panel team-settings-panel" aria-labelledby="logo-heading">
				<div class="team-section-heading">
					<span class="team-section-icon">
						@components.BrowserIcon()
					</span>
					<div><h2 id="logo-heading">Workspace logo</h2><p>Help people recognize the workspace at a glance.</p></div>
				</div>
				<div class="team-branding">
					<div class="team-logo-preview" data-logo-preview>
						@components.WorkspaceAvatar(p.Name, p.ID, p.LogoVersion)
					</div>
					<form method="post" action={ templ.SafeURL(p.Base() + "/logo") } enctype="multipart/form-data" class="team-form" data-workspace-logo>
						@ProfileHidden(p)
						<label for="workspace-logo">Choose an image</label><input id="workspace-logo" name="logo" type="file" accept="image/png,image/jpeg" required aria-describedby="logo-help"/>
						<p id="logo-help" class="team-field-hint">PNG or JPEG · up to 192 KiB · maximum 512 × 512 pixels. A square image works best.</p>
						<p data-logo-filename class="team-field-hint" role="status"></p><button type="submit" class="secondary-action">Upload logo</button>
					</form>
				</div>
				if p.LogoVersion>0 {
					<form method="post" action={ templ.SafeURL(p.Base() + "/logo/remove") } class="team-logo-remove">
						@ProfileHidden(p)
						<button type="submit" class="team-text-action">Remove logo and use initial</button>
					</form>
				}
			</section>
			@Ownership(p)
		</div>
		<aside class="workspace-panel team-settings-summary" aria-label="Workspace information">
			<div class="team-summary-identity">
				@components.WorkspaceAvatar(p.Name, p.ID, p.LogoVersion)
				<h2>{ p.Name }</h2><span class="badge tone-ok"><span class="badge-dot" aria-hidden="true"></span>Active workspace</span>
			</div>
			<dl>
				<div><dt>Workspace owner</dt><dd>{ p.OwnerName }</dd></div>
				<div>
					<dt>Your role</dt>
					<dd>
						@components.WorkspaceRole(p.Role)
					</dd>
				</div>
				<div><dt>Members</dt><dd><a href={ templ.SafeURL(p.Base() + "/members") }>{ CountLabel(p.MemberCount,"member","members") }</a></dd></div>
				<div><dt>Repositories</dt><dd><a href="/repositories">{ CountLabel(p.RepositoryCount,"repository","repositories") }</a></dd></div>
				<div>
					<dt>Created</dt>
					<dd>
						@components.Time(p.Created, p.Created)
					</dd>
				</div>
				<div>
					<dt>Workspace ID</dt>
					<dd>
						<code>{ ID(p.ID) }</code>
						@components.CopyButton(ID(p.ID), "Copy workspace ID")
					</dd>
				</div>
			</dl>
			<p class="team-field-hint">A workspace is one team. Manage people in Members and connected code in Repositories.</p>
		</aside>
	</div>
}

templ ProfileHidden(p Page) {
	<input type="hidden" name="csrf_token" value={ p.CSRF }/><input type="hidden" name="profile_revision" value={ ID(p.ProfileRevision) }/>
}

templ Ownership(p Page) {
	<section id="ownership" class="workspace-panel team-settings-panel" aria-labelledby="ownership-heading">
		<div class="team-section-heading">
			<span class="team-section-icon">
				@components.ShieldIcon()
			</span>
			<div><h2 id="ownership-heading">Workspace ownership</h2><p>The owner controls handovers and administrator roles.</p></div>
		</div>
		if p.Transfer!=nil {
			<div class="team-ownership-notice">
				<div class="team-inline"><h3>Ownership transfer pending</h3><span class="badge tone-warn">Awaiting acceptance</span></div>
				<p>
					<strong>{ p.Transfer.Login }</strong>{ " must accept before " }
					@components.Time(p.Transfer.Expires, p.Transfer.Expires)
					.
				</p>
				if p.Transfer.Accept {
					<button type="button" class="primary-action" data-open-dialog="accept-owner" commandfor="accept-owner" command="show-modal" aria-haspopup="dialog">Accept ownership</button>
					@components.ConfirmationDialog("accept-owner", "Become the workspace owner?", "You become the owner and the previous owner becomes an administrator. Connections, previews and usage stay with this workspace.") {
						<form method="post" action={ templ.SafeURL(p.Base() + "/ownership") } class="dialog-actions">
							@Hidden(p)
							<input type="hidden" name="action" value="accept"/><input type="hidden" name="transfer_revision" value={ ID(p.Transfer.Revision) }/><button type="button" class="secondary-action" commandfor="accept-owner" command="close" data-close-dialog>Cancel</button><button type="submit" class="primary-action">Accept ownership</button>
						</form>
					}
				}
				if p.Owner() {
					<form method="post" action={ templ.SafeURL(p.Base() + "/ownership") }>
						@Hidden(p)
						<button type="submit" name="action" value="cancel" class="secondary-action">Cancel transfer</button>
					</form>
				}
			</div>
		} else if p.Owner() {
			<h3>Transfer ownership</h3>
			<p>You remain the owner until an existing admin accepts. You will then become an admin.</p>
			if len(p.Admins)>0 {
				<button type="button" class="secondary-action" data-open-dialog="nominate-owner" commandfor="nominate-owner" command="show-modal" aria-haspopup="dialog">Request handover</button>
				@components.ConfirmationDialog("nominate-owner", "Request an ownership handover?", "Choose an existing administrator. They will have seven days to accept in workspace settings.") {
					<form id="ownership-form" method="post" action={ templ.SafeURL(p.Base() + "/ownership") } class="team-form">
						@Hidden(p)
						<input type="hidden" name="action" value="nominate"/><label for="ownership-target">Administrator</label>
						<select id="ownership-target" name="target" required>
							<option value="">Choose an administrator</option>
							for _,m:=range p.Admins {
								<option value={ ID(m.ID) }>{ m.Login }</option>
							}
						</select>
						<div class="dialog-actions"><button type="button" class="secondary-action" commandfor="nominate-owner" command="close" data-close-dialog>Cancel</button><button type="submit" class="primary-action">Request transfer</button></div>
					</form>
				}
			} else {
				<div class="team-inline-notice"><p>Appoint an administrator before requesting a handover.</p><a class="secondary-action" href={ templ.SafeURL(p.Base() + "/members") }>Manage members</a></div>
			}
		} else {
			<p>Only the workspace owner can request a handover. Contact <strong>{ p.OwnerName }</strong>{ " for ownership changes." }</p>
		}
	</section>
}
