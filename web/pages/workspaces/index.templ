package workspaces

import (
	"github.com/ajaykathwatee/previa/web/components"
	"github.com/ajaykathwatee/previa/web/layouts"
)

templ Directory(username string, p Page) {
	@layouts.App("Workspaces", username, p.CSRF, components.NavWorkspaces) {
		<div class="team-page">
			<header class="team-heading">
				<div class="team-heading-copy">
					@components.PageTitle("Choose your workspace", "Each workspace is one team, with its own people, repositories and settings.")
				</div>
				<button class="primary-action" type="button" commandfor="create-workspace" command="show-modal" data-open-dialog="create-workspace" aria-haspopup="dialog">
					@components.PlusIcon()
					Create workspace
				</button>
			</header>
			if len(p.Workspaces)==0 {
				<section class="workspace-panel team-empty">
					<span class="team-empty-icon">
						@components.TeamIcon()
					</span>
					<h2>A shared home for your team</h2>
					<p>Create a workspace to connect repositories and invite teammates, or open an invitation from your administrator.</p><button class="primary-action" type="button" commandfor="create-workspace" command="show-modal" data-open-dialog="create-workspace" aria-haspopup="dialog">Create your first workspace</button>
				</section>
			}
			<div class="team-workspace-grid">
				for _,w:=range p.Workspaces {
					<article class="workspace-panel team-workspace-card">
						<div class="team-card-identity">
							@components.WorkspaceAvatar(w.Name, w.ID, w.LogoVersion)
							@components.WorkspaceRole(w.Role)
						</div>
						<div>
							<h2>{ w.Name }</h2>
							if w.Description!="" {
								<p class="team-description">{ w.Description }</p>
							}
						</div>
						<form method="post" action={ components.PublicURL(ctx, components.WorkspaceURL(w.ID, "select")) }><input type="hidden" name="csrf_token" value={ p.CSRF }/><button class="primary-action" type="submit">Open workspace</button></form>
						<div class="team-card-links">
							<a href={ components.PublicURL(ctx, components.WorkspaceURL(w.ID, "members")) }>Members</a>
							if w.Role=="owner" || w.Role=="admin" {
								<a href={ components.PublicURL(ctx, components.WorkspaceURL(w.ID, "settings")) }>Settings</a>
							}
						</div>
					</article>
				}
			</div>
		</div>
	}
}

templ Index(username string, p Page) {
	{{
		title := "Members"
		nav := components.NavMembers
		if p.Tab == "settings" {
			title = "Workspace settings"
			nav = components.NavWorkspaceSettings
		}
	}}
	@layouts.AppTrail(title+" · "+p.Name, components.Crumb{Label: p.Name, Href: "/workspaces"}, title, username, p.CSRF, nav) {
		<div class="team-page">
			<header class="team-heading">
				<div class="team-heading-copy">
					@components.PageTitle(title, headingInfo(p))
				</div>
				<div class="team-heading-actions">
					if p.Tab=="members" {
						if p.Manage() {
							<a class="secondary-action" href={ components.PublicURL(ctx, p.Base()+"/settings") }>
								@components.WrenchIcon()
								Settings
							</a>
							<button type="button" class="primary-action" commandfor="invite-member" command="show-modal" data-open-dialog="invite-member" aria-haspopup="dialog">
								@components.PlusIcon()
								Invite teammate
							</button>
						}
					} else {
						<a class="secondary-action" href={ components.PublicURL(ctx, p.Base()+"/members") }>
							@components.TeamIcon()
							Members
						</a>
					}
				</div>
			</header>
			if p.Error!="" && p.ErrorField=="" {
				<p class="connection-notice tone-danger" role="alert">{ p.Error }</p>
			}
			if p.InvitationURL!="" {
				<section class="workspace-panel team-link-notice" role="status">
					<div class="team-link-copy">
						<h2>
							<span class="team-success-icon">
								@components.CheckIcon()
							</span>
							Invitation ready
						</h2>
						<p>Share it with the invited GitHub account. Shown only once · expires in 7 days.</p>
					</div>
					<div class="team-copy-row">
						<label class="sr-only" for="invitation-link">Invitation link</label><input id="invitation-link" type="text" readonly value={ p.InvitationURL }/>
						<button type="button" class="secondary-action" data-copy-from="#invitation-link">
							@components.CopyIcon()
							<span data-copy-status>Copy link</span>
						</button>
					</div>
				</section>
			}
			if p.Tab=="members" {
				@Members(p)
				@Pagination(p)
			} else {
				@Settings(p)
			}
		</div>
		@components.Toasts(p.Message)
	}
}

func headingInfo(p Page) string {
	switch {
	case p.Tab == "settings":
		return "Name, description, logo and ownership for this team."
	case p.Manage():
		return "Invite teammates and choose what they can access. Owners and admins access every repository; developers and reviewers get explicit grants."
	default:
		return "The people in this workspace and their roles."
	}
}
