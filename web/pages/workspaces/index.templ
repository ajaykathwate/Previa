package workspaces

import (
	"github.com/ajaykathwatee/previa/web/components"
	"github.com/ajaykathwatee/previa/web/layouts"
)

templ Directory(username string, p Page) {
	@layouts.App("Workspaces", username, p.CSRF, components.NavWorkspaces) {
		<div class="team-page">
			<header class="team-heading">
				<div><span class="eyebrow">Your workspaces</span><h1>Choose your workspace</h1><p>Each workspace is one team, with its own people, repositories and settings.</p></div>
				<button class="primary-action" type="button" commandfor="create-workspace" command="show-modal" data-open-dialog="create-workspace" aria-haspopup="dialog">
					@components.PlusIcon()
					Create workspace
				</button>
			</header>
			if len(p.Workspaces)==0 {
				<section class="workspace-panel team-empty">
					<span class="team-empty-icon">
						@components.TeamIcon()
					</span>
					<h2>A shared home for your team</h2>
					<p>Create a workspace to connect repositories and invite teammates, or open an invitation from your administrator.</p><button class="primary-action" type="button" commandfor="create-workspace" command="show-modal" data-open-dialog="create-workspace" aria-haspopup="dialog">Create your first workspace</button>
				</section>
			}
			<div class="team-workspace-grid">
				for _,w:=range p.Workspaces {
					<article class="workspace-panel team-workspace-card">
						<div class="team-card-identity">
							@components.WorkspaceAvatar(w.Name, w.ID, w.LogoVersion)
							@components.WorkspaceRole(w.Role)
						</div>
						<div>
							<h2>{ w.Name }</h2>
							if w.Description!="" {
								<p class="team-description">{ w.Description }</p>
							}
						</div>
						<form method="post" action={ templ.SafeURL(components.WorkspaceURL(w.ID, "select")) }><input type="hidden" name="csrf_token" value={ p.CSRF }/><button class="primary-action" type="submit">Open workspace</button></form>
						<div class="team-card-links">
							<a href={ templ.SafeURL(components.WorkspaceURL(w.ID, "members")) }>Members</a>
							if w.Role=="owner" || w.Role=="admin" {
								<a href={ templ.SafeURL(components.WorkspaceURL(w.ID, "settings")) }>Settings</a>
							}
						</div>
					</article>
				}
			</div>
			@components.ConfirmationDialog("create-workspace", "Create a workspace", "Give your team a name. You can add a description and logo in workspace settings.") {
				<form method="post" action="/workspaces" class="team-form"><input type="hidden" name="csrf_token" value={ p.CSRF }/><label for="workspace-name">Workspace name</label><input id="workspace-name" name="name" autofocus maxlength="80" required placeholder="Acme Engineering"/><div class="dialog-actions"><button type="button" class="secondary-action" commandfor="create-workspace" command="close" data-close-dialog>Cancel</button><button class="primary-action" type="submit">Create workspace</button></div></form>
			}
		</div>
	}
}

templ Index(username string, p Page) {
	{{
		title := "Members"
		nav := components.NavMembers
		if p.Tab == "settings" {
			title = "Workspace settings"
			nav = components.NavWorkspaceSettings
		}
	}}
	@layouts.AppTrail(title+" · "+p.Name, components.Crumb{Label: p.Name, Href: "/workspaces"}, title, username, p.CSRF, nav) {
		<div class="team-page">
			<header class="team-heading">
				<div class="team-heading-copy">
					<div class="team-context">
						@components.WorkspaceAvatar(p.Name, p.ID, p.LogoVersion)
						<span>{ p.Name }</span>
						@components.WorkspaceRole(p.Role)
					</div>
					<h1>{ title }</h1>
					if p.Tab=="members" {
						if p.Manage() {
							<p>Invite teammates and choose what they can access.</p>
						} else {
							<p>See the people in your workspace and their roles.</p>
						}
					} else {
						<p>Manage your workspace identity, details and ownership.</p>
					}
				</div>
				<div class="team-heading-actions">
					if p.Tab=="members" {
						if p.Manage() {
							<a class="secondary-action" href={ templ.SafeURL(p.Base() + "/settings") }>
								@components.WrenchIcon()
								Settings
							</a>
							<button type="button" class="primary-action" commandfor="invite-member" command="show-modal" data-open-dialog="invite-member" aria-haspopup="dialog">
								@components.PlusIcon()
								Invite teammate
							</button>
						}
					} else {
						<a class="secondary-action" href={ templ.SafeURL(p.Base() + "/members") }>
							@components.TeamIcon()
							Manage members
						</a>
					}
				</div>
			</header>
			if p.Message!="" {
				<p class="connection-notice tone-ok" role="status">
					@components.CheckIcon()
					{ p.Message }
				</p>
			}
			if p.Error!="" {
				<p class="connection-notice tone-danger" role="alert">{ p.Error }</p>
			}
			if p.InvitationURL!="" {
				<section class="workspace-panel team-link-notice" role="status">
					<div class="team-inline">
						<span class="team-success-icon">
							@components.CheckIcon()
						</span>
						<h2>Invitation ready</h2><span class="badge tone-ok">Expires in 7 days</span>
					</div>
					<p>Share this link with the selected GitHub account. It grants only the role and repositories you selected.</p>
					<div class="team-copy-row">
						<label class="sr-only" for="invitation-link">Invitation link</label><input id="invitation-link" type="text" readonly value={ p.InvitationURL }/>
						<button type="button" class="secondary-action" data-copy-from="#invitation-link">
							@components.CopyIcon()
							<span data-copy-status>Copy invitation</span>
						</button>
					</div>
					<p class="team-field-hint">The full link is shown only here. You can generate a replacement from Invitations.</p>
				</section>
			}
			if p.Tab=="members" {
				@Members(p)
				@Pagination(p)
			} else {
				@Settings(p)
			}
		</div>
	}
}
