package repositories

import "strconv"
import "github.com/ajaykathwatee/previa/web/components"
import "github.com/ajaykathwatee/previa/web/components/button"
import "github.com/ajaykathwatee/previa/web/layouts"

templ Index(username string, csrfToken string, page Page) {
	@layouts.App("Repositories", username, csrfToken, components.NavRepositories) {
		<div class="repository-workspace repository-catalog">
			<header class="workspace-page-heading">
				<div><span class="eyebrow">YOUR SOURCE, CONNECTED</span><h1>Repositories</h1></div>
				<div class="repository-action">
					if page.Enabled {
						<form method="post" action="/installations/start">
							<input type="hidden" name="csrf_token" value={ csrfToken }/>
							@button.Button(button.Props{Type: button.TypeSubmit}) {
								if page.Installations > 0 {
									Manage connections
								} else {
									Install on a repo
								}
								<span aria-hidden="true">
									@components.ArrowUpRight()
								</span>
							}
						</form>
					} else {
						@button.Button(button.Props{Disabled: true, Attributes: templ.Attributes{"aria-describedby": "repository-availability"}}) {
							Connect a repository
						}
						<p id="repository-availability" class="availability-note">Not configured. See the development setup instructions.</p>
					}
				</div>
			</header>
			if page.Connected {
				<p class="connection-notice" role="status">GitHub connection verified. Your selected repositories are linked.</p>
			}
			<div class="repository-directory-view">
				<section class="repository-directory" aria-label="Repository browser">
					<form
						id="repository-filters"
						method="get"
						action="/repositories"
						class="repository-toolbar"
						role="search"
						hx-get="/repositories"
						hx-trigger="submit, input delay:300ms from:#repository-search, change from:.repository-access-option"
						hx-target="#repository-results"
						hx-swap="innerHTML"
						hx-sync="this:replace"
						hx-replace-url="true"
						hx-request='{"timeout":10000}'
						data-repository-search
					>
						<div class="repository-search"><label for="repository-search">Find a repository</label><input id="repository-search" name="q" type="search" value={ page.Search } maxlength="100" placeholder="Owner or repository name"/></div>
						<fieldset class="repository-access">
							<legend>Access</legend>
							<div class="repository-access-tabs">
								for _, option := range []struct{Value,Label string}{{"available","Available"},{"unavailable","Unavailable"},{"all","All"}} {
									<label><input class="sr-only repository-access-option" type="radio" name="access" value={ option.Value } checked?={ page.Access==option.Value }/><span>{ option.Label }</span></label>
								}
							</div>
						</fieldset>
						<noscript><p class="repository-search-hint">Press Enter in the search field to apply your search and access filter.</p></noscript>
						<p class="repository-search-feedback" data-repository-feedback role="status" aria-live="polite"></p>
					</form>
					<div id="repository-results" class="repository-results">
						@Results(page)
					</div>
				</section>
			</div>
		</div>
	}
}

templ Results(page Page) {
	<div data-directory-page={ strconv.FormatInt(page.Number, 10) } class="repository-results-content">
		<p class="repository-count" role="status" aria-live="polite">
			{ strconv.FormatInt(page.Total, 10) }
			if page.Total==1 {
				repository
			} else {
				repositories
			}
		</p>
		if len(page.Rows)>0 {
			<div class="repository-card-results" role="region" aria-label="Repository list">
				<ul class="repository-list">
					for _, row := range page.Rows {
						<li class="repository-row">
							<a
								class="repository-select"
								href={ templ.SafeURL(page.SelectURL(row.ID)) }
								data-repo-link={ strconv.FormatInt(row.ID, 10) }
							>
								<div class="repository-card-top">
									<span class="repository-card-icon" aria-hidden="true">
										@components.BranchIcon()
									</span>
									if row.Accessible {
										<span class="repository-status available">Available</span>
									} else {
										<span class="repository-status unavailable">Unavailable</span>
									}
								</div>
								<div class="repository-card-name"><h2>{ row.Name() }</h2><p>{ row.Owner() }</p></div>
								if row.Status!="active" {
									<span class="repository-status-detail">Installation { row.Status }</span>
								}
								<span class="repository-card-link">
									View pull requests
									@components.Arrow()
								</span>
							</a>
						</li>
					}
				</ul>
			</div>
			if page.Pages>1 {
				<footer class="repository-pagination">
					<p role="status" aria-live="polite">Showing { strconv.FormatInt(page.Start,10) }–{ strconv.FormatInt(page.End,10) } of { strconv.FormatInt(page.Total,10) } repositories</p>
					<nav aria-label="Repository pages">
						{{ numbers := PageNumbers(page.Number, page.Pages) }}
						if page.Number>1 {
							<a hx-get={ templ.SafeURL(page.URL(page.Number - 1)) } hx-target="#repository-results" hx-swap="innerHTML" hx-sync="#repository-filters:replace" hx-push-url="true" href={ templ.SafeURL(page.URL(page.Number - 1)) } rel="prev" aria-label="Previous page">
								@components.ArrowLeft()
							</a>
						} else {
							<span aria-disabled="true" aria-label="Previous page">
								@components.ArrowLeft()
							</span>
						}
						if numbers[0]>1 {
							<a hx-get={ templ.SafeURL(page.URL(1)) } hx-target="#repository-results" hx-swap="innerHTML" hx-sync="#repository-filters:replace" hx-push-url="true" href={ templ.SafeURL(page.URL(1)) }>1</a>
							if numbers[0]>2 {
								<span aria-hidden="true">…</span>
							}
						}
						for _, number := range numbers {
							<a
								hx-get={ templ.SafeURL(page.URL(number)) }
								hx-target="#repository-results"
								hx-swap="innerHTML"
								hx-sync="#repository-filters:replace"
								hx-push-url="true"
								href={ templ.SafeURL(page.URL(number)) }
								if number==page.Number {
									aria-current="page"
								}
							>{ strconv.FormatInt(number,10) }</a>
						}
						if numbers[len(numbers)-1]<page.Pages {
							if numbers[len(numbers)-1]<page.Pages-1 {
								<span aria-hidden="true">…</span>
							}
							<a hx-get={ templ.SafeURL(page.URL(page.Pages)) } hx-target="#repository-results" hx-swap="innerHTML" hx-sync="#repository-filters:replace" hx-push-url="true" href={ templ.SafeURL(page.URL(page.Pages)) }>{ strconv.FormatInt(page.Pages,10) }</a>
						}
						if page.Number<page.Pages {
							<a hx-get={ templ.SafeURL(page.URL(page.Number + 1)) } hx-target="#repository-results" hx-swap="innerHTML" hx-sync="#repository-filters:replace" hx-push-url="true" href={ templ.SafeURL(page.URL(page.Number + 1)) } rel="next" aria-label="Next page">
								@components.Arrow()
							</a>
						} else {
							<span aria-disabled="true" aria-label="Next page">
								@components.Arrow()
							</span>
						}
					</nav>
				</footer>
			}
		} else {
			<div class="repository-card-results" role="region" aria-label="Repository list">
				<div class="repository-empty">
					<div class="empty-source-icon" aria-hidden="true">
						@components.BranchIcon()
					</div>
					if page.Installations==0 && page.Search=="" {
						<h2>Connect your code.</h2>
						<p>Use the connection button above to select repositories on GitHub. Connecting does not start a build.</p>
					} else if page.Search!="" || page.Access!="all" {
						<h2>No repositories match these filters.</h2>
						<p>Try a different name or include all access states.</p>
						<a href={ templ.SafeURL(WorkspaceURL(0, nil)) } data-clear-directory hx-get={ WorkspaceURL(0, nil) } hx-target="#repository-results" hx-sync="#repository-filters:replace" hx-push-url="true" class="text-link">
							Clear filters
							@components.ArrowUpRight()
						</a>
					} else if page.Installations==0 {
						<h2>Connect your code, on your terms.</h2>
						<p>Use the connection button above to select repositories on GitHub and verify your account. Connecting does not start a build.</p>
					} else {
						<h2>No repositories are linked yet.</h2>
						<p>Manage connections above to select repositories and refresh their access.</p>
					}
				</div>
			</div>
		}
	</div>
}
