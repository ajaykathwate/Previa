package home

import (
	"strconv"

	"github.com/ajaykathwatee/previa/web/components"
	"github.com/ajaykathwatee/previa/web/components/button"
)

// story is "How it works": Kai asks Previa what happens to a pull request,
// one question at a time. Without JavaScript the whole conversation is shown
// and the stages are links into it; ui.js (initStory) turns it into a guided
// chat whose stage rail jumps ahead. Example cards are labelled as examples.
templ story(loggedIn bool) {
	<section id="how-it-works" class="story-section" aria-labelledby="story-title">
		<div class="site-container">
			<div class="section-heading" data-scroll-reveal>
				<span class="eyebrow">How it works</span>
				<h2 id="story-title">From pull request to preview, <em>in seven steps.</em></h2>
				<p>Kai maintains a busy repository and asked Previa what happens between opening a pull request and sharing a preview. Ask Kai's questions yourself, or jump to any step.</p>
			</div>
			<div class="story" data-story>
				<nav class="story-rail" aria-label="The seven steps">
					<p class="story-rail-label">Seven steps</p>
					<ol>
						for i, t := range storyTurns() {
							<li>
								<a class="story-stage" href={ components.PublicURL(ctx, "#story-"+t.ID) } data-story-stage={ strconv.Itoa(i) }>
									<span class="story-stage-icon">
										@t.Icon
									</span>
									<span class="story-stage-text"><strong><span class="story-stage-number">{ stepNumber(i) }</span>{ t.Stage }</strong><small>{ t.Hint }</small></span>
									<span class="story-stage-check" aria-hidden="true">
										@components.CheckIcon()
									</span>
								</a>
							</li>
						}
					</ol>
				</nav>
				<div class="story-window">
					<header class="story-head">
						<span class="story-head-avatars" aria-hidden="true">
							@components.PersonAvatar("K", false)
							@components.PreviaAvatar()
						</span>
						<span class="story-head-text">
							<strong>Kai and Previa</strong>
							<span>A guided conversation</span>
						</span>
						<span class="story-count" data-story-count aria-hidden="true"></span>
						<button type="button" class="icon-button story-restart" data-story-restart aria-label="Start the conversation over" title="Start over" hidden>
							@components.RestartIcon()
						</button>
						<span class="story-progress" aria-hidden="true"><span data-story-bar></span></span>
					</header>
					<div class="story-thread" data-story-thread role="log" aria-label="Conversation between Kai and Previa">
						<div class="story-intro">
							<span class="story-intro-avatars" aria-hidden="true">
								@components.PersonAvatar("K", false)
								@components.PreviaAvatar()
							</span>
							<p class="story-intro-title">How a pull request becomes a preview</p>
							<p class="story-intro-text">{ strconv.Itoa(len(storyTurns())) } questions, from opening a pull request to cleaning up after it. Previa answers each one with an example.</p>
						</div>
						@components.PreviaMessage(nil, nil) {
							<p>Hi Kai, I'm Previa. I turn every pull request into a live preview your team can open. Ask me how, one step at a time.</p>
						}
						for _, t := range storyTurns() {
							<div class="story-turn" id={ "story-" + t.ID } data-story-turn tabindex="-1">
								@components.AskerMessage("Kai", "K", false, templ.Attributes{"data-story-ask": true}) {
									<p>{ t.Ask }</p>
								}
								@components.PreviaMessage(templ.Attributes{"data-story-answer": true}, t.Card) {
									@t.Reply
								}
							</div>
						}
						<div class="story-outro" data-story-outro>
							@components.PreviaMessage(nil, nil) {
								<p>That's the whole journey, from pull request to preview and back. Want to see it on your own repository?</p>
								<p class="story-cta">
									if loggedIn {
										@button.Button(button.Props{Href: components.LandingURL(ctx), Size: button.SizeSm}) {
											Open your dashboard
											@components.Arrow()
										}
									} else {
										@button.Button(button.Props{Href: "/auth/github/login", Size: button.SizeSm}) {
											@components.GitHubMark()
											Try it with GitHub
										}
									}
								</p>
							}
						</div>
						<div class="chat-msg is-previa is-typing" data-story-typing aria-hidden="true" hidden>
							@components.PreviaAvatar()
							<div class="chat-body">
								<p class="chat-name">Previa</p>
								@components.Typing()
							</div>
						</div>
					</div>
					<div class="story-composer" data-story-composer hidden>
						<button type="button" class="story-ask" data-story-next>
							@components.PersonAvatar("K", false)
							<span class="story-ask-text">
								<span class="story-ask-label">Ask as Kai</span>
								<span class="story-ask-question" data-story-question></span>
							</span>
							<span class="story-ask-send" aria-hidden="true">
								@components.SendIcon()
							</span>
						</button>
						<button type="button" class="story-ask is-again" data-story-again hidden>
							<span class="story-ask-text">
								<span class="story-ask-label">Kai has no more questions</span>
								<span class="story-ask-question">Start the conversation over</span>
							</span>
							<span class="story-ask-send" aria-hidden="true">
								@components.RestartIcon()
							</span>
						</button>
						<button type="button" class="story-all" data-story-all>Show the whole conversation</button>
					</div>
				</div>
			</div>
		</div>
	</section>
}

// stepNumber is a step's two-digit position on the rail.
func stepNumber(i int) string {
	if i < 9 {
		return "0" + strconv.Itoa(i+1)
	}
	return strconv.Itoa(i + 1)
}

// exampleHead titles an example card; the tag keeps illustrations from
// reading as live data.
templ exampleHead(title string) {
	<span class="story-card-head"><span>{ title }</span><span class="soon-tag">Example</span></span>
}

templ tick() {
	<span class="story-tick" aria-hidden="true">
		@components.CheckIcon()
	</span>
}

templ replyDiscover() {
	<p>Right away. As soon as a pull request is opened or updated, I pick it up, note its latest commit and check whether it can merge.</p>
	<p>Missed an update? <strong>Sync</strong> in your dashboard catches me up in one click.</p>
}

templ cardDiscover() {
	<div class="story-card">
		@exampleHead("Pull request")
		<dl class="story-kv">
			<div><dt>Opened</dt><dd>#42 · feat: a cleaner task list</dd></div>
			<div><dt>Branch</dt><dd><code>feature/task-list</code> → <code>main</code></dd></div>
			<div><dt>Latest commit</dt><dd><code>3f9c2a7</code></dd></div>
		</dl>
		<p class="story-card-foot is-ok">
			@tick()
			Picked up, merge status checked
		</p>
	</div>
}

templ replyGate() {
	<p>When you say so. Press <strong>Build latest commit</strong>, or switch the repository to Automatic and I'll start five minutes after your last push.</p>
	<p>Right before anything runs I check with GitHub again: is the pull request still open, is this still its newest commit, can it merge? If anything changed, I wait.</p>
}

templ cardGate() {
	<div class="story-card">
		@exampleHead("Before building")
		<ul class="story-checks">
			<li>
				@tick()
				<span>You pressed <strong>Build latest commit</strong></span>
			</li>
			<li>
				@tick()
				<span>Still open, still commit <code>3f9c2a7</code></span>
			</li>
			<li>
				@tick()
				<span>No merge conflicts</span>
			</li>
			<li>
				@tick()
				<span>Your turn in the queue</span>
			</li>
		</ul>
	</div>
}

templ replyBuild() {
	<p>Yes, from exactly that commit. I build your own <code>Dockerfile</code> in a clean, isolated build with sensible time and size limits. No Dockerfile yet? My starter kits write one for your stack.</p>
	<p>The build log streams live while it runs, and your dashboard shows which step it's on.</p>
}

templ cardBuild() {
	<div class="story-card is-console">
		@exampleHead("Build log")
		<ol class="story-console">
			<li><span>›</span>Preparing commit 3f9c2a7</li>
			<li><span>#1</span>FROM node:22-alpine</li>
			<li><span>#3</span>RUN npm ci</li>
			<li><span>#5</span>RUN npm run build</li>
			<li class="is-ok">Build finished in 1 min 12 s</li>
		</ol>
		<p class="story-card-foot"><span class="story-chip">your Dockerfile</span><span class="story-chip">exact commit</span><span class="story-chip">live log</span></p>
	</div>
}

templ replyRun() {
	<p>In its own space, with firm CPU and memory limits, and it can't see your other previews or anything private.</p>
	<p>Your repository secrets are added when it starts, never for forks, and nobody can open it until its health check passes.</p>
}

templ cardRun() {
	<div class="story-card">
		@exampleHead("Preview")
		<dl class="story-kv">
			<div><dt>Size</dt><dd>standard · 1 vCPU · 1 GiB</dd></div>
			<div><dt>Secrets</dt><dd>added at start</dd></div>
			<div><dt>Network</dt><dd>private to this pull request</dd></div>
			<div><dt>Lifetime</dt><dd>48 hours</dd></div>
		</dl>
		<p class="story-card-foot is-ok">
			@tick()
			<span><code>GET /health</code> answered 200: healthy</span>
		</p>
	</div>
}

templ replyRoute() {
	<p>At one private HTTPS link for the whole pull request, with a random part nobody can guess.</p>
	<p>When you push again, the new version takes over only once it's healthy, so reviewers never land on a broken page.</p>
}

templ cardRoute() {
	<div class="story-card">
		@exampleHead("Preview link")
		<p class="story-url">
			@components.LockIcon()
			<span>https://pr-42-gc0uy9.preview.example.dev</span>
		</p>
		<ol class="story-swap">
			<li class="is-old"><span><code>3f9c2a7</code> keeps serving while the next commit builds</span></li>
			<li class="is-new"><span><code>8d41e0b</code> takes over once healthy</span></li>
		</ol>
	</div>
}

templ replyReport() {
	<p>I keep one comment on the pull request up to date, from Queued to Building to Ready with the link, and add a check to the exact commit.</p>
	<p>Your Previa dashboard updates live too, no refresh needed.</p>
}

templ cardReport() {
	<div class="story-card">
		@exampleHead("On the pull request")
		<div class="story-comment">
			<p class="story-comment-title">Previa preview: Ready</p>
			<p class="story-comment-link">https://pr-42-gc0uy9.preview.example.dev</p>
			<p class="story-comment-meta">Commit <code>3f9c2a7</code> · expires in 48 hours</p>
		</div>
		<p class="story-card-foot is-ok">
			@tick()
			<span><strong>Previa preview</strong> check: success</span>
		</p>
	</div>
}

templ replyTeardown() {
	<p>I tidy up after myself. When the pull request closes, the link stops working and the preview and its data are removed.</p>
	<p>A preview nobody closes expires 48 hours after it was last published. Building again brings it back at the same link.</p>
}

templ cardTeardown() {
	<div class="story-card">
		@exampleHead("After the merge")
		<ol class="story-checks">
			<li>
				@tick()
				<span>Link switched off</span>
			</li>
			<li>
				@tick()
				<span>Preview stopped</span>
			</li>
			<li>
				@tick()
				<span>Build removed</span>
			</li>
			<li>
				@tick()
				<span>Preview data removed</span>
			</li>
		</ol>
	</div>
}
