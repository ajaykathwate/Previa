package home

import (
	"github.com/ajaykathwatee/previa/web/components"
	"github.com/ajaykathwatee/previa/web/components/button"
	"github.com/ajaykathwatee/previa/web/layouts"
)

templ Index(loggedIn bool) {
	@layouts.Document("A clearer view of what's next") {
		@components.Navbar(loggedIn)
		<main id="content" tabindex="-1" class="marketing">
			<section class="site-container hero" aria-labelledby="hero-title">
				<div class="hero-copy">
					<div class="hero-eyebrow reveal"><span class="tiny-orbit" aria-hidden="true"></span>A fresh perspective on pull requests</div>
					<h1 id="hero-title" class="hero-title reveal delay-1">Review the branch.<br/>See the <em>possibility.</em></h1>
					<p class="hero-description reveal delay-2">Code tells part of the story. Previa is being built to give every pull request a shared place to come to life—on infrastructure you control.</p>
					<div class="hero-actions reveal delay-3">
						if loggedIn {
							@button.Button(button.Props{Href: "/dashboard", Class: "hero-cta", Size: button.SizeLg}) {
								Open your dashboard
								@components.Arrow()
							}
						} else {
							@button.Button(button.Props{Href: "/auth/github/login", Class: "hero-cta", Size: button.SizeLg}) {
								@components.GitHubMark()
								Get started with GitHub
								@components.Arrow()
							}
						}
						<a href="#workflow" class="text-link">Explore the workflow <span aria-hidden="true">↘</span></a>
					</div>
					<p class="hero-note reveal delay-3">Early access · GitHub sign-in is available today.</p>
				</div>
				<figure class="preview-art reveal delay-2" aria-label="An illustration of a pull request becoming a shared preview">
					<div class="art-grid" aria-hidden="true"></div>
					<div class="art-orbit orbit-one" aria-hidden="true"></div>
					<div class="art-orbit orbit-two" aria-hidden="true"></div>
					<div class="branch-tag">
						<span class="branch-symbol" aria-hidden="true">
							@components.BranchIcon()
						</span>your next pull request<span class="branch-tag-dot" aria-hidden="true"></span>
					</div>
					<div class="preview-layer layer-back" aria-hidden="true"></div>
					<div class="preview-layer layer-middle" aria-hidden="true"></div>
					<div class="preview-window">
						<div class="preview-window-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>the bigger picture</span><span aria-hidden="true">↗</span></div>
						<div class="preview-window-content"><div class="mini-brand" aria-hidden="true">p.</div><p>One branch.<br/><em>A shared perspective.</em></p><div class="art-line" aria-hidden="true"></div><div class="art-line short" aria-hidden="true"></div><span class="art-button">See it. Discuss it. Refine it.</span></div>
					</div>
					<div class="review-tag"><span class="review-tag-icon" aria-hidden="true">↗</span><div><strong>Beyond the diff</strong><span>Made for the conversation.</span></div></div>
					<figcaption><span class="art-caption-line" aria-hidden="true"></span>WORKFLOW CONCEPT · NOT A LIVE PREVIEW</figcaption>
				</figure>
			</section>
			<div class="principle-strip"><div class="site-container"><span>GitHub at the heart</span><span class="strip-cross" aria-hidden="true">✳</span><span>Your infrastructure</span><span class="strip-cross" aria-hidden="true">✳</span><span>Pull requests in focus</span><span class="strip-cross" aria-hidden="true">✳</span><span>Room for better feedback</span></div></div>
			<section id="workflow" class="site-container section-block" aria-labelledby="workflow-title">
				<div class="section-heading" data-scroll-reveal><div><span class="eyebrow">LESS GUESSWORK. MORE CONTEXT.</span><h2 id="workflow-title">A little closer to<br/>the <em>real thing.</em></h2></div><p>A screenshot is a moment. A preview is a place to explore. This is the pull-request workflow we're building toward.</p></div>
				<div class="workflow-grid">
					<article class="workflow-card" data-scroll-reveal><div class="workflow-symbol branch-diagram" aria-hidden="true"><span></span><span></span><span></span><i></i></div><span class="eyebrow">FROM YOUR BRANCH</span><h3>Make the change.</h3><p>Start where your team already works: a GitHub pull request. Keep the code, the conversation, and the context together.</p><div class="workflow-card-footer">A familiar starting point <span aria-hidden="true">↗</span></div></article>
					<article class="workflow-card featured" data-scroll-reveal><div class="workflow-symbol stacked-diagram" aria-hidden="true"><span></span><span></span><span></span></div><span class="eyebrow">INTO A SHARED VIEW</span><h3>Explore the idea.</h3><p>The goal: an isolated preview for each pull request, so reviewers can experience a change instead of imagining it.</p><div class="workflow-card-footer">Built around real feedback <span aria-hidden="true">↗</span></div></article>
					<article class="workflow-card" data-scroll-reveal><div class="workflow-symbol merge-diagram" aria-hidden="true"><span></span><i></i><b>↗</b></div><span class="eyebrow">BACK TO THE WORK</span><h3>Move it forward.</h3><p>Review, refine, and merge. The intended lifecycle keeps previews tied to their pull requests, from open to close.</p><div class="workflow-card-footer">A natural finish <span aria-hidden="true">↗</span></div></article>
				</div>
			</section>
			<section id="principles" class="principles-section" aria-labelledby="principles-title">
				<div class="site-container principles-grid" data-scroll-reveal>
					<div><span class="eyebrow">A PLATFORM WITH A POINT OF VIEW</span><h2 id="principles-title">Your work.<br/>Your infrastructure.<br/><em>Your perspective.</em></h2><p>Previa's direction is deliberately simple: make reviewing a change feel closer to using it, while keeping control in your hands.</p></div>
					<div class="principles-list">
						<article><span aria-hidden="true">↗</span><div><h3>Self-hosted by design</h3><p>A preview platform designed to run on infrastructure you own, with a clear boundary between the platform and previewed applications.</p></div></article>
						<article>
							<span aria-hidden="true">
								@components.BranchIcon()
							</span>
							<div><h3>A pull request is the starting point</h3><p>Repository connections, changes, and preview lifecycles are being designed around GitHub's existing workflow.</p></div>
						</article>
						<article><span aria-hidden="true">◎</span><div><h3>Clarity over noise</h3><p>A shared view should help you understand the change. No invented activity, inflated counters, or distractions.</p></div></article>
					</div>
				</div>
			</section>
			<section class="site-container start-section" data-scroll-reveal aria-labelledby="start-title">
				<div class="start-spark" aria-hidden="true">✳</div><span class="eyebrow">EVERY GOOD IDEA STARTS SOMEWHERE</span>
				<h2 id="start-title">See what comes <em>next.</em></h2>
				<p>Start with your GitHub identity. Your workspace is the first step.</p>
				if loggedIn {
					@button.Button(button.Props{Href: "/dashboard", Class: "hero-cta", Size: button.SizeLg}) {
						Open your dashboard
						@components.Arrow()
					}
				} else {
					@button.Button(button.Props{Href: "/auth/github/login", Class: "hero-cta", Size: button.SizeLg}) {
						@components.GitHubMark()
						Get started with GitHub
						@components.Arrow()
					}
				}
				<p class="start-disclosure">Sign-in is available now. Repository connections and live previews are coming next.<br/>Signing in does not grant access to your repositories.</p>
			</section>
		</main>
		<footer class="site-footer site-container">
			@components.Brand()
			<p>A clearer view of what comes next.</p><a href="#content">Back to top <span aria-hidden="true">↑</span></a>
		</footer>
	}
}
