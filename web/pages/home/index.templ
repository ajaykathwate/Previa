package home

import (
	"strconv"

	"github.com/ajaykathwatee/previa/web/components"
	"github.com/ajaykathwatee/previa/web/components/button"
	"github.com/ajaykathwatee/previa/web/layouts"
	"github.com/ajaykathwatee/previa/web/pages/faq"
	"github.com/ajaykathwatee/previa/web/pages/opensource"
)

// Index is the public home page. Every claim on it describes what works
// today, at the level a user needs: what Previa does for a pull request, not
// how it is built or hosted. Illustrations are labelled as examples.
templ Index(loggedIn bool) {
	@layouts.Document("A live preview for every pull request") {
		@components.Navbar(loggedIn)
		<main id="content" tabindex="-1" class="marketing">
			@hero(loggedIn)
			@film()
			@why()
			@story(loggedIn)
			@features()
			@security()
			@available()
			@openSourceTests()
			<section id="faq" class="site-container section-block faq-section" aria-labelledby="faq-title">
				<div class="faq-layout">
					<div class="section-heading faq-intro" data-scroll-reveal>
						<span class="eyebrow">FAQ</span>
						<h2 id="faq-title">Questions, <em>answered by Previa.</em></h2>
						<p>Kai gathered the { strconv.Itoa(len(faq.Questions())) } questions teams ask before they try Previa. Open one and Previa answers, or narrow them down by topic and search.</p>
						<ul class="faq-cast" aria-label="In this conversation">
							<li>
								@components.PersonAvatar("K", false)
								<span><strong>Kai</strong><small>Asks the questions</small></span>
							</li>
							<li>
								@components.PreviaAvatar()
								<span><strong>Previa</strong><small>Answers plainly</small></span>
							</li>
						</ul>
					</div>
					@faq.Conversation(faq.Guide)
				</div>
			</section>
			<section id="start" class="site-container start-section" data-scroll-reveal aria-labelledby="start-title">
				<div class="start-card">
					<span class="start-mark" aria-hidden="true">
						@components.BrandMark()
					</span>
					<span class="eyebrow">Early access</span>
					<h2 id="start-title">Ready to see your pull requests <em>running?</em></h2>
					<p>Sign in with GitHub, connect a repository and build your first preview. Previa is free while it's in early access.</p>
					@cta(loggedIn)
					<p class="start-disclosure">Signing in doesn't give Previa your code. Only the repositories where you install the GitHub App are used, and only to build their previews.</p>
				</div>
			</section>
		</main>
		@components.SiteFooter()
	}
}

templ hero(loggedIn bool) {
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero-backdrop" aria-hidden="true"><span class="hero-grid"></span><span class="hero-glow"></span></div>
		<div class="site-container hero-inner">
			<div class="hero-copy">
				<a href="#start" class="hero-pill reveal"><span class="pulse-dot" aria-hidden="true"></span>Early access · Free during early access</a>
				<h1 id="hero-title" class="hero-title reveal delay-1">Review the branch.<br/><span class="hero-title-accent">See it running.</span></h1>
				<p class="hero-description reveal delay-2">Previa turns every GitHub pull request into its own live preview: the exact commit, built from your own Dockerfile, running at a private HTTPS link that's posted right on the pull request. Reviewers click, try it and approve with confidence.</p>
				<div class="hero-actions reveal delay-3">
					@cta(loggedIn)
					<a href="#watch" class="text-link hero-secondary hero-watch">
						<span class="hero-watch-icon" aria-hidden="true">
							@components.PlayIcon()
						</span>
						Watch the story
						<span class="hero-watch-time">0:30</span>
					</a>
				</div>
				<dl class="hero-stats reveal delay-3">
					<div><dt>2 files</dt><dd>to get started: a Dockerfile and a small config</dd></div>
					<div><dt>1 link</dt><dd>per pull request, the same on every push</dd></div>
					<div><dt>48 h</dt><dd>a preview stays up after it's published</dd></div>
				</dl>
			</div>
			@heroArt()
		</div>
	</section>
}

// heroArt is an example of a pull request with its preview: Previa's steps
// and comment beside the running app. It is illustration, so its contents are
// hidden from assistive technology behind one description.
templ heroArt() {
	<figure class="preview-art reveal delay-2" aria-labelledby="hero-art-caption">
		<div class="preview-window">
			<div class="preview-window-bar" aria-hidden="true">
				<span class="window-dots"><i></i><i></i><i></i></span>
				<span class="preview-window-title">fernhill/taskboard · pull request #42</span>
				<span class="preview-window-status"><span class="pulse-dot"></span>live</span>
			</div>
			<div class="preview-window-body" aria-hidden="true">
				<div class="console-pane">
					<div class="console-pr">
						<span class="console-pr-icon">
							@components.PullRequestIcon()
						</span>
						<div><strong>feat: a cleaner task list</strong><span>#42 · feature/task-list → main</span></div>
					</div>
					<ol class="console-steps">
						@artStep("step-1", "Pull request noticed", "#42")
						@artStep("step-2", "Checked: no conflicts", "clean")
						@artStep("step-3", "Built from 3f9c2a7", "1m 12s")
						@artStep("step-4", "Healthy and live", "48 h")
					</ol>
					<div class="art-comment">
						<p class="art-comment-head">
							<span class="art-comment-avatar">
								@components.BrandMark()
							</span>
							previa commented
						</p>
						<p class="art-comment-title">Previa preview: Ready</p>
						<p class="console-url">
							@components.LockIcon()
							<span>pr-42-gc0uy9.preview.example.dev</span>
						</p>
					</div>
				</div>
				<div class="browser-pane">
					<div class="browser-bar">
						<span class="browser-lock">
							@components.LockIcon()
						</span>
						<span class="browser-url">pr-42-gc0uy9.preview.example.dev/tasks</span>
					</div>
					<div class="browser-content">
						<div class="demo-head">
							<strong>fernhill tasks</strong>
							<span class="demo-chip">3f9c2a7</span>
						</div>
						<ul class="demo-tasks">
							<li class="is-done">
								<span class="demo-check">
									@components.CheckIcon()
								</span>
								<span>Review pull request #42</span>
								<small>Today</small>
							</li>
							<li><span class="demo-check"></span><span>Write the release notes</span><small>Fri</small></li>
							<li><span class="demo-check"></span><span>Plan the next sprint</span><small>Mon</small></li>
						</ul>
						<span class="demo-add">
							@components.PlusIcon()
							Add a task
						</span>
					</div>
				</div>
			</div>
		</div>
		<figcaption id="hero-art-caption"><span class="art-caption-line" aria-hidden="true"></span>Example: a pull request and its live preview</figcaption>
	</figure>
}

templ artStep(class, label, value string) {
	<li class={ "console-step", class }>
		<span class="console-dot">
			@components.CheckIcon()
		</span>
		<span>{ label }</span>
		<code>{ value }</code>
	</li>
}

// film is the 30-second story of one review, with and without Previa. It
// does not play on its own: nothing downloads until the visitor presses play
// (preload none, a poster frame), and the transcript tells the same story in
// text. ui.js (initFilm) adds the large play button; without JavaScript the
// native controls play it.
templ film() {
	<section id="watch" class="site-container section-block film-section" aria-labelledby="film-title">
		<div class="section-heading film-heading" data-scroll-reveal>
			<span class="eyebrow">Watch</span>
			<h2 id="film-title">One review, <em>two ways.</em></h2>
			<p>Thirty seconds on what changes when every pull request comes with a link to the running app.</p>
		</div>
		<figure class="film" data-film data-scroll-reveal>
			<div class="film-frame">
				<video class="film-video" controls preload="none" playsinline poster="/static/video/previa-story-poster.jpg" aria-label="Previa in 30 seconds: one review, two ways" data-film-video>
					<source src="/static/video/previa-story.mp4" type="video/mp4"/>
					<p>Your browser can't play this video. <a href="/static/video/previa-story.mp4">Download it</a> instead.</p>
				</video>
				<button type="button" class="film-play" data-film-play hidden>
					<span class="film-play-badge">
						<span class="film-play-icon" aria-hidden="true">
							@components.PlayIcon()
						</span>
						Play the story
						<span class="film-play-time">0:30</span>
					</span>
				</button>
			</div>
			<figcaption>
				<details class="film-transcript">
					<summary>
						@components.ChevronDownIcon()
						Read the story instead
					</summary>
					<ol>
						<li>Maya asks Kai to review a pull request. Kai replies: “Sure! Let me set it up first.”</li>
						<li>Kai pulls the branch, installs everything and sets up a test database. 52 minutes later, the app still won't start: “It worked on Maya's machine…”</li>
						<li>What if every pull request came with a link to the running app?</li>
						<li>With Previa, Maya opens a pull request. Previa builds that commit and shares a private link on it.</li>
						<li>Kai clicks the link and the app is already running. Kai tries the change and approves it.</li>
						<li>Minutes, not an afternoon. Maya: “That was fast!” Kai: “I didn't even pull the branch.”</li>
						<li>Designers, QA, backend teams and maintainers all see the real thing.</li>
						<li>Previa. Review the branch, see it running. Free during early access.</li>
					</ol>
				</details>
			</figcaption>
		</figure>
	</section>
}

// why contrasts reviewing with and without a preview, and names who it helps.
templ why() {
	<section id="why" class="site-container section-block why-section" aria-labelledby="why-title">
		<div class="why-grid">
			<div class="section-heading why-intro" data-scroll-reveal>
				<span class="eyebrow">Why Previa</span>
				<h2 id="why-title">A screenshot is a moment. <em>A preview is a place to explore.</em></h2>
				<p>Reviewing a change should feel like using it. Previa puts the running commit one click away from the review, so nobody has to check out a branch to see what it does.</p>
				<ul class="audience-list" aria-label="Who it helps">
					@audience("Frontend teams", "Click through the real interface on every push, not a picture of it.", components.BrowserIcon())
					@audience("API and backend teams", "Databases, migrations and background workers come along for the ride.", components.DatabaseIcon())
					@audience("Open-source maintainers", "Preview contributions from forks safely. Forks never get your secrets.", components.BranchIcon())
					@audience("Product and QA", "Test the real thing from a link on the pull request, with no local setup.", components.ChecklistIcon())
				</ul>
			</div>
			<figure class="compare" data-scroll-reveal aria-labelledby="compare-title">
				<figcaption class="compare-head">
					<span id="compare-title">How your team reviews a pull request</span>
					<span class="compare-legend"><span class="is-before">Before</span><span class="is-after">With Previa</span></span>
				</figcaption>
				<ol class="compare-rows">
					@comparison("Pull the branch, install and seed a database, just to click one button", "Open the link on the pull request: that exact commit, already running")
					@comparison("One shared staging server, where the last deploy wins", "One preview per pull request, at a link that stays put")
					@comparison("Screenshots in the thread, stale by the next push", "One living comment, updated from Queued to Ready")
					@comparison("“Works on my machine”", "Everyone reviews the same running commit")
					@comparison("Forgotten test environments left running for weeks", "Removed on merge, and expired after 48 hours")
				</ol>
			</figure>
		</div>
	</section>
}

templ audience(title, detail string, icon templ.Component) {
	<li>
		<span class="tile-icon" aria-hidden="true">
			@icon
		</span>
		<span><strong>{ title }</strong>{ detail }</span>
	</li>
}

templ comparison(before, after string) {
	<li>
		<p class="compare-before"><span class="compare-sign" aria-hidden="true">−</span><span class="sr-only">Before: </span>{ before }</p>
		<p class="compare-after"><span class="compare-sign" aria-hidden="true">+</span><span class="sr-only">With Previa: </span>{ after }</p>
	</li>
}

// features groups what Previa does into build, run, review and control.
templ features() {
	<section id="features" class="site-container section-block" aria-labelledby="features-title">
		<div class="section-heading" data-scroll-reveal>
			<span class="eyebrow">Features</span>
			<h2 id="features-title">Everything between a push <em>and a preview.</em></h2>
			<p>From the moment a pull request opens to the moment it merges, Previa builds it, runs it, shares it and cleans up after it.</p>
		</div>
		<div class="feature-groups">
			@featureGroup("Build") {
				@feature("Manual or Automatic", "Manual by default: you press Build latest commit. Or switch on Automatic and Previa builds five minutes after your last push.", components.SyncIcon())
				@feature("Only buildable changes", "Pull requests with merge conflicts don't build. Previa checks again right before it starts, so nothing runs by mistake.", components.MergeIcon())
				@feature("Your Dockerfile, or ours", "If it runs in Docker and answers HTTP, it runs on Previa. No setup yet? Starter kits write both files for Next.js, Django, Rails, Laravel and more.", components.BuildIcon())
			}
			@featureGroup("Run") {
				@feature("Databases included", "Ask for PostgreSQL or Redis, run a setup command and up to three background processes. Each preview gets fresh data.", components.DatabaseIcon())
				@feature("Pick a size", "small, standard or large, set in one line of .previewrc.yaml, each with firm CPU and memory limits.", components.ServerIcon())
				@feature("Encrypted secrets", "Write-only in the dashboard, or paste a whole .env file. Added when a preview starts and masked in logs.", components.KeyIcon())
			}
			@featureGroup("Review") {
				@feature("A private HTTPS link", "One unguessable link per pull request that stays the same for its whole life.", components.LinkIcon())
				@feature("No broken links", "A new commit takes over only once it's healthy. Until then, the previous version keeps serving.", components.EnvironmentIcon())
				@feature("One living comment", "One comment on the pull request, updated from Queued to Building to Ready, plus a check on the exact commit.", components.MessageIcon())
			}
			@featureGroup("Control") {
				@feature("Live build logs", "Watch the build as it happens, step by step, then copy or download the log. Secrets are masked.", components.LogsIcon())
				@feature("A dashboard that explains", "Every pull request's state at a glance. When a build fails, it says why in plain words and what to do next.", components.OverviewIcon())
				@feature("Automatic cleanup", "Closing or merging removes the preview at once. Forgotten previews expire 48 hours after they're published.", components.TrashIcon())
			}
		</div>
	</section>
}

templ featureGroup(name string) {
	<section class="feature-group" data-scroll-reveal aria-label={ name }>
		<h3 class="feature-group-title">{ name }</h3>
		<ul class="feature-list">
			{ children... }
		</ul>
	</section>
}

templ feature(title, detail string, icon templ.Component) {
	<li class="feature">
		<span class="tile-icon" aria-hidden="true">
			@icon
		</span>
		<h4>{ title }</h4>
		<p>{ detail }</p>
	</li>
}

// security lists the guarantees a reviewer of untrusted code needs.
templ security() {
	<section id="security" class="security-section" aria-labelledby="security-title">
		<div class="site-container security-grid" data-scroll-reveal>
			<div class="section-heading security-intro">
				<span class="eyebrow">Security</span>
				<h2 id="security-title">Built for code you <em>haven't reviewed yet.</em></h2>
				<p>Every pull request is treated as untrusted, even your own team's. Previews are kept apart from each other and from your Previa account.</p>
			</div>
			<ul class="security-list">
				@guarantee("Every build is isolated", "Each build and preview runs on its own, without admin rights, with firm limits and no way into anything private.", components.ShieldIcon())
				@guarantee("Forks get less", "Pull requests from forks never receive your secrets or your approved connections.", components.BranchIcon())
				@guarantee("Secrets stay secret", "Encrypted, added only when a preview starts, masked in logs and never shown again.", components.KeyIcon())
				@guarantee("Your account stays separate", "Previews never run on Previa's own address, so a preview can't touch your sign-in.", components.UserIcon())
				@guarantee("Unguessable links", "Each link has a random part. Previews aren't behind a login, so use test data.", components.LockIcon())
				@guarantee("Gone when you're done", "Merged, closed or expired: the preview and its data are removed.", components.TrashIcon())
			</ul>
		</div>
	</section>
}

templ guarantee(title, detail string, icon templ.Component) {
	<li>
		<span class="tile-icon" aria-hidden="true">
			@icon
		</span>
		<h3>{ title }</h3>
		<p>{ detail }</p>
	</li>
}

// available is the current release at a glance: only what works today.
templ available() {
	<section id="available" class="site-container section-block available-section" aria-labelledby="available-title">
		<div class="section-heading" data-scroll-reveal>
			<span class="eyebrow">Built in the open</span>
			<h2 id="available-title">Everything here <em>works today.</em></h2>
			<p>Previa is in early access, and every part of the journey is ready to use now, free.</p>
		</div>
		<div class="available-panel" data-scroll-reveal>
			<p class="available-status"><span class="badge tone-ok"><span class="badge-dot" aria-hidden="true"></span>Available today</span>Early access</p>
			<div class="available-columns">
				@availableArea("Connect", []string{"Sign in with GitHub", "Install on the repositories you choose", "Pull requests appear by themselves", "Sync on demand"})
				@availableArea("Build", []string{"Starter kits for popular stacks", "Manual or Automatic builds", "Only mergeable pull requests build", "Your Dockerfile, from the exact commit", "Live build logs, secrets masked"})
				@availableArea("Run", []string{"Isolated previews in three sizes", "PostgreSQL, Redis, setup and workers", "Encrypted secrets, never for forks", "Approved outside connections"})
				@availableArea("Review", []string{"A private HTTPS link per pull request", "Health-checked switch to new commits", "A living comment and a commit check", "Cleanup on merge, close or after 48 h"})
			</div>
		</div>
	</section>
}

// openSourceTests introduces the Open Source Tests: well-known open-source apps
// Previa is tested against. Statuses come from that page's data, so nothing
// here claims a result that hasn't been verified.
templ openSourceTests() {
	<section id="open-source-tests" class="site-container section-block lab-teaser" aria-labelledby="open-source-tests-title">
		<div class="lab-teaser-head" data-scroll-reveal>
			<div class="section-heading">
				<span class="eyebrow">Open Source Tests</span>
				<h2 id="open-source-tests-title">Real apps, <em>not toy demos.</em></h2>
				<p>We test Previa against { strconv.Itoa(len(opensource.Repos())) } well-known open-source projects, from a static SvelteKit editor to a Rails finance app with background jobs and a GraphQL commerce API. See what each one proves, and exactly how we test it.</p>
			</div>
			<a class="text-link" href="/open-source-tests">
				See the Open Source Tests
				@components.Arrow()
			</a>
		</div>
		<ul class="lab-teaser-grid" aria-label="The core ten" data-scroll-reveal>
			for _, r := range opensource.Core() {
				<li>
					<a href={ components.PublicURL(ctx, templ.URL("/open-source-tests#repo-"+r.ID)) }>
						<span class="lab-teaser-kind">{ r.Kind } · { r.Level }</span>
						<strong>{ r.Label() }</strong>
						<span class="lab-teaser-stack">{ r.StackLine() }</span>
						@opensource.StatusBadge(r.Status)
					</a>
				</li>
			}
		</ul>
	</section>
}

templ availableArea(name string, items []string) {
	<div class="available-area">
		<h3>{ name }</h3>
		<ul>
			for _, item := range items {
				<li>
					<span class="available-check" aria-hidden="true">
						@components.CheckIcon()
					</span>
					{ item }
				</li>
			}
		</ul>
	</div>
}

templ cta(loggedIn bool) {
	if loggedIn {
		@button.Button(button.Props{Href: "/dashboard", Class: "hero-cta", Size: button.SizeLg}) {
			Open your dashboard
			@components.Arrow()
		}
	} else {
		@button.Button(button.Props{Href: "/auth/github/login", Class: "hero-cta", Size: button.SizeLg}) {
			@components.GitHubMark()
			Get started with GitHub
			@components.Arrow()
		}
	}
}
