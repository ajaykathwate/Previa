package secrets

import (
	"strconv"
	"github.com/ajaykathwatee/previa/web/components"
	"github.com/ajaykathwatee/previa/web/components/button"
	"github.com/ajaykathwatee/previa/web/layouts"
)

templ Index(username, csrf string, p Page) {
	@layouts.App("Secrets", username, csrf, components.NavRepositories) {
		<div class="repository-workspace secrets-page">
			<header class="pr-panel-heading">
				<div class="pr-heading-text">
					<nav aria-label="Repository location" class="pr-location">
						<a href="/repositories" class="text-link pr-directory-link">
							@components.ArrowLeft()
							Repositories
						</a>
						<div class="pr-title-row">
							<span class="pr-repo-icon" aria-hidden="true">
								@components.RepositoryIcon()
							</span>
							<h1 class="pr-breadcrumb">
								<a href="/repositories" title={ p.Owner() }>{ p.Owner() }</a>
								<span aria-hidden="true">/</span>
								<a href={ templ.SafeURL("/repositories/" + strconv.FormatInt(p.RepoID, 10)) } title={ p.RepositoryName() }>{ p.RepositoryName() }</a>
							</h1>
						</div>
					</nav>
				</div>
			</header>
			@components.RepositoryTabs(p.RepoID, "secrets")
			if p.Notice != "" {
				<p class="connection-notice tone-ok" role="status">
					@components.CheckIcon()
					{ p.Notice }
				</p>
			}
			if !p.Configured {
				<p class="connection-notice tone-warn" role="status">
					@components.AlertIcon()
					Repository secrets are not configured on this server. An administrator must set SECRETS_ENCRYPTION_KEYS and SECRETS_ACTIVE_KEY_VERSION; existing names stay visible.
				</p>
			} else if !p.Available {
				<p class="connection-notice tone-warn" role="status">
					@components.AlertIcon()
					GitHub access to this repository was removed. You can delete secrets, but not add or replace them.
				</p>
			}
			<div class="secrets-layout">
				<section class="workspace-panel secrets-list" aria-labelledby="secrets-title">
					<header class="secrets-panel-header">
						<h2 id="secrets-title">Secrets</h2>
						<span class="badge tone-neutral">{ strconv.Itoa(len(p.Secrets)) } of { strconv.Itoa(p.Limit) }</span>
					</header>
					if len(p.Secrets) == 0 {
						<div class="repository-empty">
							<span class="empty-source-icon" aria-hidden="true">
								@components.KeyIcon()
							</span>
							<h3>No secrets yet</h3>
							<p>Add values your preview needs at runtime, such as a sandbox API key or a test database URL.</p>
						</div>
					} else {
						<div class="repository-table-scroll" tabindex="0" role="region" aria-label="Secret names">
							<table class="pr-table secrets-table">
								<thead><tr><th>Name</th><th>Updated</th><th><span class="sr-only">Actions</span></th></tr></thead>
								<tbody>
									for i, secret := range p.Secrets {
										<tr>
											<td class="secret-name" data-label="Name"><code>{ secret.Name }</code></td>
											<td class="secret-updated" data-label="Updated"><time datetime={ secret.UpdatedISO() }>{ secret.UpdatedLabel() }</time></td>
											<td class="secret-actions">
												if p.CanEdit() {
													<a class="text-link" href={ templ.SafeURL("/repositories/" + strconv.FormatInt(p.RepoID, 10) + "/secrets?replace=" + secret.Name) } aria-label={ "Replace " + secret.Name }>Replace</a>
												}
												<button type="button" class="text-link danger-link" commandfor={ "delete-secret-" + strconv.Itoa(i) } command="show-modal" data-open-dialog={ "delete-secret-" + strconv.Itoa(i) } aria-haspopup="dialog" aria-label={ "Delete " + secret.Name }>Delete</button>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</section>
				<section class="workspace-panel secrets-form" aria-labelledby="secret-form-title">
					if p.Replacing {
						<h2 id="secret-form-title">Replace { p.FormName }</h2>
						<p class="secrets-form-help">Enter a new value. The current value is never shown and is overwritten when you save.</p>
					} else {
						<h2 id="secret-form-title">Add a secret</h2>
						<p class="secrets-form-help">Saving an existing name replaces its value. Values are encrypted immediately and never shown again.</p>
					}
					if p.Error != "" && p.ErrorField == "" {
						<p class="connection-notice tone-danger" role="alert" id="secret-form-error">
							@components.AlertIcon()
							{ p.Error }
						</p>
					}
					<form method="post" action={ templ.SafeURL("/repositories/" + strconv.FormatInt(p.RepoID, 10) + "/secrets") } class="secret-form" autocomplete="off">
						<input type="hidden" name="csrf_token" value={ csrf }/>
						<div class="field">
							<label for="secret-name">Name</label>
							if p.Replacing {
								<input id="secret-name" class="secret-input" type="text" name="name" value={ p.FormName } readonly/>
							} else {
								<input
									id="secret-name"
									class="secret-input"
									type="text"
									name="name"
									value={ p.FormName }
									required
									maxlength="128"
									pattern="[A-Za-z_][A-Za-z0-9_]*"
									spellcheck="false"
									autocapitalize="characters"
									placeholder="API_KEY"
									disabled?={ !p.CanEdit() || p.AtLimit() }
									if p.ErrorField == "name" {
										aria-invalid="true"
										aria-describedby="secret-name-error"
									}
								/>
							}
							if p.ErrorField == "name" {
								<p class="field-error" id="secret-name-error">{ p.Error }</p>
							}
						</div>
						<div class="field">
							<label for="secret-value">Value</label>
							<textarea
								id="secret-value"
								class="secret-input secret-value"
								name="value"
								rows="4"
								required
								maxlength="32768"
								spellcheck="false"
								autocomplete="off"
								data-1p-ignore
								data-lpignore="true"
								disabled?={ !p.CanEdit() || p.AtLimit() }
								if p.ErrorField == "value" {
									aria-invalid="true"
									aria-describedby="secret-value-error"
								}
							></textarea>
							if p.ErrorField == "value" {
								<p class="field-error" id="secret-value-error">{ p.Error }</p>
							}
						</div>
						<div class="secret-form-actions">
							@button.Button(button.Props{Type: button.TypeSubmit, Disabled: !p.CanEdit() || p.AtLimit()}) {
								@components.KeyIcon()
								if p.Replacing {
									Replace secret
								} else {
									Save secret
								}
							}
							if p.Replacing {
								<a class="text-link" href={ templ.SafeURL("/repositories/" + strconv.FormatInt(p.RepoID, 10) + "/secrets") }>Cancel</a>
							}
						</div>
						if p.AtLimit() && p.CanEdit() {
							<p class="field-help">This repository has reached { strconv.Itoa(p.Limit) } secrets. Delete one to add another.</p>
						}
					</form>
				</section>
			</div>
			<aside class="policy-hint secrets-guidance" aria-label="How secrets are used">
				@components.InfoIcon()
				<ul>
					<li><strong>Runtime only.</strong> Values become environment variables of the preview container when it starts; they are never build arguments, part of the build context or baked into images.</li>
					<li><strong>Never for forks.</strong> Pull requests from forks, or whose source cannot be verified, receive no secrets in any build mode.</li>
					<li><strong>Owner values win.</strong> A secret replaces a variable with the same name in <code>.previewrc.yaml</code>.</li>
					<li><strong>Preview-only credentials.</strong> Previews run pull request code. Use sandbox keys and test databases, never production credentials.</li>
					<li><strong>Logs.</strong> Values of 4 or more characters are redacted from build and preview logs. Redaction cannot stop code that receives a value from encoding or sending it elsewhere.</li>
				</ul>
			</aside>
			for i, secret := range p.Secrets {
				@components.ConfirmationDialog("delete-secret-"+strconv.Itoa(i), "Delete "+secret.Name+"?", "Previews started after this will not receive it. Running previews keep their current environment until they are rebuilt.") {
					<form method="post" action={ templ.SafeURL("/repositories/" + strconv.FormatInt(p.RepoID, 10) + "/secrets/delete") } class="dialog-actions">
						<input type="hidden" name="csrf_token" value={ csrf }/>
						<input type="hidden" name="name" value={ secret.Name }/>
						@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{"autofocus": true, "commandfor": "delete-secret-" + strconv.Itoa(i), "command": "close", "data-close-dialog": true}}) {
							Cancel
						}
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
							Delete secret
						}
					</form>
				}
			}
		</div>
	}
}
