package secrets

import (
	"github.com/ajaykathwatee/previa/web/components"
	"github.com/ajaykathwatee/previa/web/components/button"
	"github.com/ajaykathwatee/previa/web/layouts"
	"strconv"
)

templ Index(username, csrf string, p Page) {
	@layouts.AppTrail(p.RepositoryName()+" · Secrets", components.Crumb{Label: p.RepositoryName(), Href: "/repositories/" + strconv.FormatInt(p.RepoID, 10)}, "Secrets", username, csrf, components.NavRepositories) {
		<div class="repository-workspace secrets-page">
			@components.RepositoryHero(p.Owner(), p.RepositoryName(), "One .env file your previews receive as environment variables when they start.")
			@components.RepositoryTabs(p.RepoID, "secrets")
			if p.Notice != "" {
				<p class="connection-notice tone-ok" role="status">
					@components.CheckIcon()
					{ p.Notice }
				</p>
			}
			if !p.Configured {
				<p class="connection-notice tone-warn" role="status">
					@components.AlertIcon()
					Repository secrets are not configured on this server. An administrator must set SECRETS_ENCRYPTION_KEYS and SECRETS_ACTIVE_KEY_VERSION; existing names stay visible.
				</p>
			} else if !p.Available {
				<p class="connection-notice tone-warn" role="status">
					@components.AlertIcon()
					GitHub access to this repository was removed. You can remove variables or edit comments, but not add or change values.
				</p>
			}
			<div class="secrets-layout">
				@envFile(p, csrf)
				<aside class="secrets-aside" aria-labelledby="secrets-guidance-title">
					<section class="workspace-panel guidance-card secrets-guidance" tabindex="0">
						<h2 id="secrets-guidance-title">
							@components.ShieldIcon()
							How the .env file reaches your previews
						</h2>
						<ul class="guidance-list">
							<li><strong>One file, as you write it.</strong> Every <code>NAME=value</code> becomes an environment variable of the preview container when it starts. Comments, blank lines and order are kept; a name left empty (<code>NAME=</code>) is not set. <code>REGISTRY_AUTH</code> is reserved for base image pulls and never reaches the app.</li>
							<li><strong>Owners and Admins only.</strong> Only they can open this tab and see values. The file is encrypted at rest and values are hidden until you choose to edit.</li>
							<li><strong>Builds only when you allow it.</strong> For private packages, choose <strong>Allow</strong> under Build access: Dockerfile steps can then read the value with <code>RUN --mount=type=secret,id=NPM_TOKEN,env=NPM_TOKEN npm ci</code>. Allow <code>REGISTRY_AUTH</code> with one <code>ghcr.io username token</code> line per registry for private base images. Previa does not use build arguments or write credentials into the context; your Dockerfile must keep mounted values out of image layers and caches.</li>
							<li><strong>Trust the branch code.</strong> Allowed builds can read and send these credentials elsewhere. Use narrowly scoped test tokens and review the Dockerfile before allowing access.</li>
							<li><strong>Never for forks.</strong> Pull requests from forks, or whose source cannot be verified, receive no secrets, at build time or at start, in any build mode.</li>
							<li><strong>Your values win.</strong> A variable here replaces one with the same name in <code>.previewrc.yaml</code>; values Previa sets for managed services, such as <code>DATABASE_URL</code>, replace both.</li>
							<li><strong>Running previews keep their values.</strong> A saved file reaches a preview when it is next built: use Rebuild preview on the pull request.</li>
							<li><strong>Test credentials only.</strong> Previews run pull request code. Use sandbox keys and test databases, never production credentials.</li>
							<li><strong>Masked in logs.</strong> Values of 4 or more characters are redacted from build and preview logs. Redaction cannot stop code that receives a value from encoding or sending it elsewhere.</li>
						</ul>
					</section>
				</aside>
				if len(p.Secrets) > 0 {
					@buildAccess(p, csrf)
				}
			</div>
			for i, secret := range p.Secrets {
				if !secret.Build && p.Available {
					@components.ConfirmationDialog("allow-build-secret-"+strconv.Itoa(i), "Allow builds to read "+secret.Name+"?", "Builds of this repository's own branches can use this credential. Branch code can copy it into an image or send it elsewhere; review the Dockerfile and use a narrowly scoped test token. Forks never receive it.") {
						<form method="post" action={ components.PublicURL(ctx, templ.SafeURL(p.URL()+"/build")) } class="dialog-actions">
							<input type="hidden" name="csrf_token" value={ csrf }/>
							<input type="hidden" name="name" value={ secret.Name }/>
							<input type="hidden" name="build" value="true"/>
							@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{"autofocus": true, "commandfor": "allow-build-secret-" + strconv.Itoa(i), "command": "close", "data-close-dialog": true}}) {
								Cancel
							}
							@button.Button(button.Props{Type: button.TypeSubmit}) {
								Allow builds
							}
						</form>
					}
				}
			}
			if p.Editing && len(p.Removals) > 0 {
				<dialog id="confirm-env-removals" class="confirmation-dialog" aria-labelledby="confirm-env-removals-title" aria-describedby="confirm-env-removals-description" data-confirmation-dialog data-open-on-load>
					<button type="button" class="dialog-close" aria-label="Close confirmation" commandfor="confirm-env-removals" command="close" data-close-dialog><span aria-hidden="true">×</span></button>
					<span class="dialog-icon" aria-hidden="true">
						@components.AlertIcon()
					</span>
					<span class="eyebrow">Please confirm</span>
					<h2 id="confirm-env-removals-title">{ p.RemovalTitle() }</h2>
					<p id="confirm-env-removals-description">The edited file no longer sets these names. Previews built after you save will not receive them; running previews keep their values until they are rebuilt.</p>
					@removalList(p.Removals)
					<div class="dialog-actions">
						@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{"autofocus": true, "commandfor": "confirm-env-removals", "command": "close", "data-close-dialog": true}}) {
							Keep editing
						}
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive, Attributes: templ.Attributes{"form": "env-form", "name": "confirm_removals", "value": "1"}}) {
							Remove and save
						}
					</div>
				</dialog>
			}
		</div>
	}
}

// envFile is the repository's .env file: values hidden by default, or the
// editor with every value after Show values and edit.
templ envFile(p Page, csrf string) {
	<section id="env-file" class="workspace-panel env-file" aria-labelledby="env-title">
		<header class="secrets-panel-header">
			<div>
				<h2 id="env-title"><code>.env</code></h2>
				<p>{ p.Summary() }</p>
			</div>
			if !p.Editing && p.CanEdit() && len(p.Lines) > 0 {
				<div class="secrets-panel-actions">
					@button.Button(button.Props{Href: p.URL() + "?edit=1#env-file", Variant: button.VariantOutline, Size: button.SizeSm}) {
						@components.EyeIcon()
						Show values and edit
					}
				</div>
			}
		</header>
		if p.Error != "" {
			<p class="connection-notice tone-danger" role="alert" id="env-error">
				@components.AlertIcon()
				{ p.Error }
			</p>
		}
		if p.Editing {
			<form id="env-form" method="post" action={ components.PublicURL(ctx, templ.SafeURL(p.URL()+"?edit=1")) } class="env-form" autocomplete="off" data-env-editor>
				<input type="hidden" name="csrf_token" value={ csrf }/>
				<input type="hidden" name="revision" value={ strconv.FormatInt(p.Revision, 10) }/>
				<label for="env-text" class="sr-only">.env file</label>
				<textarea
					id="env-text"
					name="env"
					class="env-editor"
					rows="16"
					spellcheck="false"
					autocomplete="off"
					autocapitalize="off"
					data-1p-ignore
					data-lpignore="true"
					placeholder="# Sandbox credentials for previews&#10;STRIPE_SECRET_KEY=sk_test_…&#10;SENTRY_DSN=https://…"
					if p.Error != "" {
						aria-invalid="true"
						aria-describedby="env-error env-help"
					} else {
						aria-describedby="env-help"
					}
				>{ p.Text }</textarea>
				<p id="env-help" class="field-help">One <code>NAME=value</code> per line. Quotes are optional; a double-quoted value may span lines, for example a private key. Comments and blank lines are kept, and a name left empty is not set.</p>
				<p class={ "field-help", "env-size", templ.KV("is-over", p.OverLimit()) } data-env-size data-env-max={ strconv.Itoa(p.MaxKiB * 1024) }>{ p.SizeLabel() }</p>
				if len(p.Removals) > 0 {
					<noscript>
						<div class="connection-notice tone-warn env-removals-fallback">
							<p><strong>{ p.RemovalTitle() }</strong> The edited file no longer sets these names; previews built after you save will not receive them.</p>
							@removalList(p.Removals)
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive, Attributes: templ.Attributes{"name": "confirm_removals", "value": "1"}}) {
								Remove and save
							}
						</div>
					</noscript>
				}
				<div class="env-actions">
					@button.Button(button.Props{Type: button.TypeSubmit, Attributes: templ.Attributes{"data-env-submit": true}}) {
						@components.KeyIcon()
						Save .env
					}
					<label class="text-link env-file-load">
						<input type="file" accept=".env,.txt,text/plain" class="sr-only" data-env-file/>
						Load a file…
					</label>
					if len(p.Lines) > 0 || p.Revision > 0 {
						<a class="text-link" href={ components.PublicURL(ctx, templ.SafeURL(p.URL()+"#env-file")) }>Cancel</a>
					}
					<p class="field-help env-feedback" data-env-feedback role="status" aria-live="polite"></p>
				</div>
			</form>
		} else if len(p.Lines) == 0 {
			<div class="repository-empty">
				<span class="empty-source-icon" aria-hidden="true">
					@components.KeyIcon()
				</span>
				<h3>No variables yet</h3>
				<p>Encryption must be configured on this server before you can add a .env file.</p>
			</div>
		} else {
			<div class="env-view" role="group" aria-label=".env file with values hidden">
				for _, line := range p.Lines {
					if line.Name == "" {
						<div class="env-line env-comment">{ line.Comment }</div>
					} else if line.HasValue {
						<div class="env-line"><span class="env-name">{ line.Name }</span>=<span class="env-mask" title="Hidden">••••••••</span></div>
					} else {
						<div class="env-line"><span class="env-name">{ line.Name }</span>=<span class="env-unset">not set</span></div>
					}
				}
			</div>
		}
	</section>
}

// buildAccess lists the names the file sets and whether builds may read them.
templ buildAccess(p Page, csrf string) {
	<section class="workspace-panel secrets-list" aria-labelledby="build-access-title">
		<header class="secrets-panel-header">
			<div>
				<h2 id="build-access-title">Build access</h2>
				<p>Previews get every variable when they start. Dockerfile steps read only the ones you allow.</p>
			</div>
		</header>
		<div class="repository-table-scroll" tabindex="0" role="region" aria-label="Build access by name">
			<table class="pr-table secrets-table">
				<thead>
					<tr>
						<th>Name</th>
						<th>Builds</th>
						<th>Value changed</th>
					</tr>
				</thead>
				<tbody>
					for i, secret := range p.Secrets {
						<tr>
							<td class="secret-name" data-label="Name"><code>{ secret.Name }</code></td>
							<td class="secret-build" data-label="Builds">
								<form method="post" action={ components.PublicURL(ctx, templ.SafeURL(p.URL()+"/build")) } class="secret-build-form">
									<input type="hidden" name="csrf_token" value={ csrf }/>
									<input type="hidden" name="name" value={ secret.Name }/>
									if secret.Build {
										<input type="hidden" name="build" value="false"/>
										<span class="badge tone-info" title={ secret.BuildTitle() }>{ secret.BuildLabel() }</span>
										<button type="submit" class="text-link" aria-label={ "Stop giving " + secret.Name + " to builds" }>Stop</button>
									} else if p.Available {
										<span class="secret-build-off">Not allowed</span>
										<button type="button" class="text-link" aria-label={ "Let builds read " + secret.Name } title="Dockerfile steps of this repository's own branches may read it; forks never do." commandfor={ "allow-build-secret-" + strconv.Itoa(i) } command="show-modal" data-open-dialog={ "allow-build-secret-" + strconv.Itoa(i) } aria-haspopup="dialog">Allow</button>
									} else {
										<span class="secret-build-off">Not allowed</span>
									}
								</form>
							</td>
							<td class="secret-updated" data-label="Value changed">
								@components.Time(secret.UpdatedISO(), secret.UpdatedLabel())
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
}

templ removalList(names []string) {
	<ul class="env-removals">
		for _, name := range names {
			<li><code>{ name }</code></li>
		}
	</ul>
}
