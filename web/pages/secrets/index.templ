package secrets

import (
	"github.com/ajaykathwatee/previa/web/components"
	"github.com/ajaykathwatee/previa/web/components/button"
	"github.com/ajaykathwatee/previa/web/layouts"
	"strconv"
)

templ Index(username, csrf string, p Page) {
	@layouts.AppTrail(p.RepositoryName()+" · Secrets", components.Crumb{Label: p.RepositoryName(), Href: "/repositories/" + strconv.FormatInt(p.RepoID, 10)}, "Secrets", username, csrf, components.NavRepositories) {
		<div class="repository-workspace secrets-page">
			@components.RepositoryHero(p.Owner(), p.RepositoryName(), "Encrypted values your previews receive as environment variables when they start.")
			@components.RepositoryTabs(p.RepoID, "secrets")
			if p.Notice != "" {
				<p class="connection-notice tone-ok" role="status">
					@components.CheckIcon()
					{ p.Notice }
				</p>
			}
			if !p.Configured {
				<p class="connection-notice tone-warn" role="status">
					@components.AlertIcon()
					Repository secrets are not configured on this server. An administrator must set SECRETS_ENCRYPTION_KEYS and SECRETS_ACTIVE_KEY_VERSION; existing names stay visible.
				</p>
			} else if !p.Available {
				<p class="connection-notice tone-warn" role="status">
					@components.AlertIcon()
					GitHub access to this repository was removed. You can delete secrets, but not add or replace them.
				</p>
			}
			<div class="section-grid">
				<div class="section-main">
					<section class="workspace-panel secrets-list" aria-labelledby="secrets-title">
						<header class="secrets-panel-header">
							<div>
								<h2 id="secrets-title">Stored secrets</h2>
								<p>Names only: values are encrypted and never shown again.</p>
							</div>
							<div class="secrets-panel-actions">
								<span class="badge tone-neutral">{ strconv.Itoa(len(p.Secrets)) } of { strconv.Itoa(p.Limit) }</span>
								if len(p.Secrets) > 0 {
									@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Size: button.SizeSm, Class: "bulk-delete-trigger", Attributes: templ.Attributes{"data-open-dialog": "delete-selected-secrets", "commandfor": "delete-selected-secrets", "command": "show-modal", "aria-haspopup": "dialog", "data-bulk-delete": true}}) {
										Delete selected
										<span class="bulk-delete-count" data-bulk-delete-count></span>
									}
								}
							</div>
						</header>
						if len(p.Secrets) == 0 {
							<div class="repository-empty">
								<span class="empty-source-icon" aria-hidden="true">
									@components.KeyIcon()
								</span>
								<h3>No secrets yet</h3>
								if p.CanEdit() {
									<p>Add values your preview needs at runtime, such as a sandbox API key or a test database URL. You can paste a whole .env file below.</p>
								}
							</div>
						} else {
							<div class="repository-table-scroll" tabindex="0" role="region" aria-label="Secret names">
								<table class="pr-table secrets-table">
									<thead>
										<tr>
											<th class="secret-select">
												<input type="checkbox" class="secret-select-all" aria-label="Select all secrets" data-select-all/>
											</th>
											<th>Name</th>
											<th>Builds</th>
											<th>Updated</th>
											<th><span class="sr-only">Actions</span></th>
										</tr>
									</thead>
									<tbody>
										for i, secret := range p.Secrets {
											<tr>
												<td class="secret-select">
													<input type="checkbox" name="name" value={ secret.Name } form="delete-selected-form" aria-label={ "Select " + secret.Name } data-select-secret/>
												</td>
												<td class="secret-name" data-label="Name"><code>{ secret.Name }</code></td>
												<td class="secret-build" data-label="Builds">
													<form method="post" action={ components.PublicURL(ctx, "/repositories/"+strconv.FormatInt(p.RepoID, 10)+"/secrets/build") } class="secret-build-form">
														<input type="hidden" name="csrf_token" value={ csrf }/>
														<input type="hidden" name="name" value={ secret.Name }/>
														if secret.Build {
															<input type="hidden" name="build" value="false"/>
															<span class="badge tone-info" title={ secret.BuildTitle() }>{ secret.BuildLabel() }</span>
															<button type="submit" class="text-link" aria-label={ "Stop giving " + secret.Name + " to builds" }>Stop</button>
														} else if p.CanEdit() {
															<input type="hidden" name="build" value="true"/>
															<button type="button" class="text-link" aria-label={ "Let builds read " + secret.Name } title="Dockerfile steps of this repository's own branches may read it; forks never do." commandfor={ "allow-build-secret-" + strconv.Itoa(i) } command="show-modal" data-open-dialog={ "allow-build-secret-" + strconv.Itoa(i) } aria-haspopup="dialog">Allow</button>
														}
													</form>
												</td>
												<td class="secret-updated" data-label="Updated">
													@components.Time(secret.UpdatedISO(), secret.UpdatedLabel())
												</td>
												<td class="secret-actions">
													if p.CanEdit() {
														<a class="text-link" href={ components.PublicURL(ctx, "/repositories/"+strconv.FormatInt(p.RepoID, 10)+"/secrets?replace="+secret.Name+"#add-secrets") } aria-label={ "Replace " + secret.Name } data-replace-secret={ secret.Name }>Replace</a>
													}
													<button type="button" class="text-link danger-link" commandfor={ "delete-secret-" + strconv.Itoa(i) } command="show-modal" data-open-dialog={ "delete-secret-" + strconv.Itoa(i) } aria-haspopup="dialog" aria-label={ "Delete " + secret.Name }>Delete</button>
												</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						}
					</section>
					if p.CanEdit() {
						@editor(p, csrf)
					}
				</div>
				<aside class="section-aside" aria-labelledby="secrets-guidance-title">
					<section class="workspace-panel guidance-card secrets-guidance">
						<h2 id="secrets-guidance-title">
							@components.ShieldIcon()
							How secrets reach your previews
						</h2>
						<ul class="guidance-list">
							<li><strong>Added at start.</strong> Values become environment variables of the preview container when it starts. <code>REGISTRY_AUTH</code> is reserved for base image pulls and never reaches the app.</li>
							<li><strong>Builds only when you allow it.</strong> For private packages, choose <strong>Allow</strong> under Builds: Dockerfile steps can then read the value with <code>RUN --mount=type=secret,id=NPM_TOKEN,env=NPM_TOKEN npm ci</code>. Allow <code>REGISTRY_AUTH</code> with one <code>ghcr.io username token</code> line per registry for private base images. Previa does not use build arguments or write credentials into the context; your Dockerfile must keep mounted values out of image layers and caches.</li>
							<li><strong>Trust the branch code.</strong> Allowed builds can read and send these credentials elsewhere. Use narrowly scoped test tokens and review the Dockerfile before allowing access.</li>
							<li><strong>Never for forks.</strong> Pull requests from forks, or whose source cannot be verified, receive no secrets, at build time or at start, in any build mode.</li>
							<li><strong>Your values win.</strong> A secret replaces a variable with the same name in <code>.previewrc.yaml</code>.</li>
							<li><strong>Running previews keep their values.</strong> A saved or deleted secret reaches a preview when it is next built: use Rebuild preview on the pull request.</li>
							<li><strong>Test credentials only.</strong> Previews run pull request code. Use sandbox keys and test databases, never production credentials.</li>
							<li><strong>Masked in logs.</strong> Values of 4 or more characters are redacted from build and preview logs. Redaction cannot stop code that receives a value from encoding or sending it elsewhere.</li>
						</ul>
					</section>
				</aside>
			</div>
			for i, secret := range p.Secrets {
				if !secret.Build && p.CanEdit() {
					@components.ConfirmationDialog("allow-build-secret-"+strconv.Itoa(i), "Allow builds to read "+secret.Name+"?", "Builds of this repository's own branches can use this credential. Branch code can copy it into an image or send it elsewhere; review the Dockerfile and use a narrowly scoped test token. Forks never receive it.") {
						<form method="post" action={ components.PublicURL(ctx, "/repositories/"+strconv.FormatInt(p.RepoID, 10)+"/secrets/build") } class="dialog-actions">
							<input type="hidden" name="csrf_token" value={ csrf }/>
							<input type="hidden" name="name" value={ secret.Name }/>
							<input type="hidden" name="build" value="true"/>
							@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{"autofocus": true, "commandfor": "allow-build-secret-" + strconv.Itoa(i), "command": "close", "data-close-dialog": true}}) {
								Cancel
							}
							@button.Button(button.Props{Type: button.TypeSubmit}) {
								Allow builds
							}
						</form>
					}
				}
				@components.ConfirmationDialog("delete-secret-"+strconv.Itoa(i), "Delete "+secret.Name+"?", "Previews started after this will not receive it. Running previews keep their current environment until they are rebuilt.") {
					<form method="post" action={ components.PublicURL(ctx, "/repositories/"+strconv.FormatInt(p.RepoID, 10)+"/secrets/delete") } class="dialog-actions">
						<input type="hidden" name="csrf_token" value={ csrf }/>
						<input type="hidden" name="name" value={ secret.Name }/>
						@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{"autofocus": true, "commandfor": "delete-secret-" + strconv.Itoa(i), "command": "close", "data-close-dialog": true}}) {
							Cancel
						}
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
							Delete secret
						}
					</form>
				}
			}
			if len(p.Secrets) > 0 {
				@components.ConfirmationDialog("delete-selected-secrets", "Delete the selected secrets?", "Previews started after this will not receive them. Running previews keep their current environment until they are rebuilt.") {
					<form id="delete-selected-form" method="post" action={ components.PublicURL(ctx, "/repositories/"+strconv.FormatInt(p.RepoID, 10)+"/secrets/delete") } class="dialog-actions">
						<input type="hidden" name="csrf_token" value={ csrf }/>
						<p class="repository-search-feedback" data-bulk-delete-summary role="status" aria-live="polite"></p>
						@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{"autofocus": true, "commandfor": "delete-selected-secrets", "command": "close", "data-close-dialog": true}}) {
							Cancel
						}
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
							Delete selected
						}
					</form>
				}
			}
		</div>
	}
}

// editor adds or replaces several secrets at once: one name and value per
// line, plus optional pasted .env text. Values are never rendered back.
templ editor(p Page, csrf string) {
	<section id="add-secrets" class="workspace-panel secrets-form" aria-labelledby="secret-form-title">
		<header class="secrets-form-header">
			if p.Replacing != "" {
				<h2 id="secret-form-title">Replace { p.Replacing }</h2>
				<p class="secrets-form-help">Enter its new value. The current value is never shown and is overwritten when you save.</p>
			} else {
				<h2 id="secret-form-title">Add or replace secrets</h2>
				<p class="secrets-form-help">Add as many as you need, one per line, or paste a .env file. Saving a name that already exists replaces its value. { p.RemainingLabel() }</p>
			}
		</header>
		if p.Error != "" {
			<p class="connection-notice tone-danger" role="alert" id="secret-form-error">
				@components.AlertIcon()
				{ p.Error }
			</p>
		}
		<form method="post" action={ components.PublicURL(ctx, "/repositories/"+strconv.FormatInt(p.RepoID, 10)+"/secrets") } class="secret-form" autocomplete="off" data-secret-editor data-existing-names={ p.ExistingNames() } data-remaining={ strconv.Itoa(p.Remaining()) }>
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<fieldset class="secret-rows">
				<legend class="sr-only">Secrets to save</legend>
				<div class="secret-rows-head" aria-hidden="true"><span>Name</span><span>Value</span></div>
				<div class="secret-row-list" data-secret-rows>
					for i, row := range p.EditorRows() {
						@secretRow(row, i+1, p.Exists(row.Name))
					}
					<noscript>
						for i := range 3 {
							@secretRow(Row{}, len(p.EditorRows())+i+1, false)
						}
					</noscript>
				</div>
				<template data-secret-row-template>
					@secretRow(Row{}, 0, false)
				</template>
				<button type="button" class="text-link secret-add-row" data-add-secret-row>
					@components.PlusIcon()
					Add another line
				</button>
				<details class="dotenv-import" open?={ p.DotenvError != "" }>
					<summary>Paste or import a .env file</summary>
					<div class="dotenv-body">
						<label for="secret-dotenv" class="sr-only">Pasted .env text</label>
						<textarea
							id="secret-dotenv"
							name="dotenv"
							class="secret-input secret-dotenv"
							rows="6"
							spellcheck="false"
							autocomplete="off"
							data-1p-ignore
							data-lpignore="true"
							placeholder="STRIPE_TEST_KEY=sk_test_…&#10;SENTRY_DSN=https://…&#10;# Comments and blank lines are ignored"
							if p.DotenvError != "" {
								aria-invalid="true"
								aria-describedby="secret-dotenv-error"
							}
							data-dotenv-text
						></textarea>
						if p.DotenvError != "" {
							<p class="field-error" id="secret-dotenv-error">{ p.DotenvError }</p>
						}
						<p class="field-help">One NAME=value per line. Quotes are optional; a double-quoted value may span lines (for example a private key). Everything here is saved together with the lines above.</p>
						<div class="dotenv-actions">
							<label class="text-link dotenv-file">
								<input type="file" accept=".env,.txt,text/plain" class="sr-only" data-dotenv-file/>
								Choose a .env file…
							</label>
							<button type="button" class="text-link" data-dotenv-split>Move into lines above to review</button>
							<p class="field-help" data-dotenv-feedback role="status" aria-live="polite"></p>
						</div>
					</div>
				</details>
			</fieldset>
			<div class="secret-form-actions">
				@button.Button(button.Props{Type: button.TypeSubmit, Attributes: templ.Attributes{"data-secret-submit": true}}) {
					@components.KeyIcon()
					<span data-secret-submit-label>Save secrets</span>
				}
				if p.Replacing != "" {
					<a class="text-link" href={ components.PublicURL(ctx, "/repositories/"+strconv.FormatInt(p.RepoID, 10)+"/secrets") }>Cancel</a>
				}
				<p class="field-help" data-secret-editor-feedback role="status" aria-live="polite"></p>
			</div>
		</form>
	</section>
}

// secretRow is one editor line. number 0 marks the template ui.js clones.
templ secretRow(row Row, number int, exists bool) {
	<div
		if row.Error != "" {
			class="secret-row has-error"
		} else {
			class="secret-row"
		}
		data-secret-row
	>
		<input
			type="text"
			name="name"
			class="secret-input secret-name-input"
			value={ row.Name }
			maxlength="128"
			pattern="[A-Za-z_][A-Za-z0-9_]*"
			spellcheck="false"
			autocapitalize="characters"
			autocomplete="off"
			placeholder="NAME"
			aria-label={ lineLabel("Name", number) }
			if row.Error != "" {
				aria-invalid="true"
			}
		/>
		<textarea
			name="value"
			class="secret-input secret-value"
			rows="1"
			maxlength="32768"
			spellcheck="false"
			autocomplete="off"
			data-1p-ignore
			data-lpignore="true"
			placeholder="Value"
			aria-label={ lineLabel("Value", number) }
		></textarea>
		<button type="button" class="secret-row-remove" aria-label={ lineLabel("Remove", number) } data-remove-secret-row>
			<span aria-hidden="true">×</span>
		</button>
		<p class="secret-row-note" data-row-note>
			if row.Error != "" {
				<span class="field-error">{ row.Error }</span>
			} else if exists {
				Replaces the stored value.
			}
		</p>
	</div>
}

func lineLabel(field string, number int) string {
	if number == 0 {
		return field
	}
	return field + ", line " + strconv.Itoa(number)
}
