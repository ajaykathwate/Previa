package opensource

import (
	"strconv"

	"github.com/ajaykathwatee/previa/web/components"
	"github.com/ajaykathwatee/previa/web/components/button"
	"github.com/ajaykathwatee/previa/web/layouts"
)

// Page is the public Open Source Tests page: the open-source apps Previa is
// tested against, what each one proves and exactly how it is tested. Nothing
// is called verified unless its Repo.Status says so.
templ Page(loggedIn bool) {
	@layouts.Document("Open Source Tests") {
		@components.Navbar(loggedIn)
		<main id="content" tabindex="-1" class="marketing lab">
			@intro()
			@method()
			@index()
			@coverage()
			@repoSection("core", "The core ten", "Ten apps that cover ", "the whole journey.", coreLead(), Core())
			@repoSection("more", "Beyond the core", "More languages, ", "harder edges.", "Rust, Elixir, .NET, Nuxt, a Docker Compose project and more, including the builds that push hardest against preview limits.", More())
			@closing(loggedIn)
		</main>
		@components.SiteFooter()
	}
}

templ intro() {
	<header class="lab-hero" aria-labelledby="lab-title">
		<div class="hero-backdrop" aria-hidden="true"><span class="hero-grid"></span><span class="hero-glow"></span></div>
		<div class="site-container">
			<span class="eyebrow reveal">Open Source Tests</span>
			<h1 id="lab-title" class="lab-title reveal delay-1">Real apps, <em>not toy demos.</em></h1>
			<p class="lab-lead reveal delay-2">A preview platform is only as good as the projects it can run. So we test Previa against well-known open-source apps: static sites, full-stack products, and APIs with databases, queues and workers, in TypeScript, Go, Python, Ruby, Java, PHP and more. Each one below shows its stack, what it proves and exactly how we test it.</p>
			<dl class="lab-stats reveal delay-3">
				<div><dt>{ strconv.Itoa(len(Repos())) }</dt><dd>open-source apps</dd></div>
				<div><dt>{ strconv.Itoa(len(Capabilities())) }</dt><dd>capabilities exercised</dd></div>
				<div><dt>3</dt><dd>managed services: PostgreSQL, MySQL and Redis</dd></div>
				if VerifiedCount() > 0 {
					<div><dt>{ strconv.Itoa(VerifiedCount()) }</dt><dd>verified end to end on a live preview</dd></div>
				} else {
					<div><dt>{ strconv.Itoa(len(Core())) }</dt><dd>core apps covering the whole journey</dd></div>
				}
			</dl>
			<nav class="lab-jump reveal delay-3" aria-label="On this page">
				<a href="#method">How we test</a>
				<a href="#all">Every app</a>
				<a href="#coverage">Coverage</a>
				<a href="#core">The core ten</a>
				<a href="#more">Beyond the core</a>
			</nav>
		</div>
	</header>
}

// method is the routine every app goes through, stated once.
templ method() {
	<section id="method" class="site-container lab-section" aria-labelledby="method-title">
		<div class="lab-before" data-scroll-reveal>
			<div class="lab-before-intro">
				<span class="eyebrow">How we test</span>
				<h2 id="method-title">The same routine, <em>every app.</em></h2>
				<p>Each app runs as a customer's would: its own code and Dockerfile, a real pull request and the same checks. Any change a project needs is listed with it, and an app is marked verified only when every expected result holds.</p>
			</div>
			<ol class="lab-routine">
				<li><strong>The project's own code.</strong> A copy of the upstream repository, changed only where its test says so.</li>
				<li><strong>A real pull request.</strong> Previa is installed on that copy and builds the pull request like any other.</li>
				<li><strong>Its own Dockerfile, or a Starter kit.</strong> Projects without one get the files Previa's Starter kits write.</li>
				<li><strong>Real services.</strong> Managed PostgreSQL, MySQL or Redis, setup commands, workers and secrets, as the app needs them.</li>
				<li><strong>Checks that matter.</strong> Health, the app's own features, and the lifecycle: rebuilds, failures, forks, cleanup.</li>
				<li><strong>Verified, or not yet.</strong> Each result is dated. Known limits are published beside it, not hidden.</li>
			</ol>
		</div>
	</section>
}

templ index() {
	<section id="all" class="site-container lab-section" aria-labelledby="all-title">
		<div class="lab-heading" data-scroll-reveal>
			<span class="eyebrow">Every app</span>
			<h2 id="all-title">From a static editor <em>to a commerce API.</em></h2>
			<p>Stack, size and configuration effort at a glance. Select an app to see what it proves and how we test it.</p>
		</div>
		<div class="lab-table-wrap" role="region" aria-labelledby="all-title" tabindex="0" data-scroll-reveal>
			<table class="lab-table">
				<thead>
					<tr>
						<th scope="col">App</th>
						<th scope="col" class="lab-col-wide">Type</th>
						<th scope="col" class="lab-col-wide">Stack</th>
						<th scope="col" class="lab-col-wide">Size</th>
						<th scope="col">Config</th>
						<th scope="col">Status</th>
					</tr>
				</thead>
				<tbody>
					for _, r := range Repos() {
						<tr>
							<th scope="row">
								<a href={ components.PublicURL(ctx, templ.URL("#repo-"+r.ID)) }><span class="lab-owner">{ r.Owner() }/</span>{ r.Title() }</a>
								if r.Core {
									<span class="lab-core">Core</span>
								}
							</th>
							<td class="lab-col-wide">{ r.Kind }</td>
							<td class="lab-col-wide lab-mono">{ r.StackLine() }</td>
							<td class="lab-col-wide">{ r.Size }</td>
							<td>{ r.Level }</td>
							<td>
								@StatusBadge(r.Status)
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
}

// coverage maps each capability to the repositories that exercise it.
templ coverage() {
	<section id="coverage" class="site-container lab-section" aria-labelledby="coverage-title">
		<div class="lab-heading" data-scroll-reveal>
			<span class="eyebrow">Coverage</span>
			<h2 id="coverage-title">Every capability, <em>on real code.</em></h2>
			<p>Each part of Previa below is exercised by at least one real app. Highlighted apps are in the core ten.</p>
		</div>
		<div class="lab-coverage" data-scroll-reveal>
			for i, group := range CapabilityGroups() {
				<section class={ "lab-coverage-group", "is-group-" + strconv.Itoa(i+1) } aria-labelledby={ "coverage-group-" + strconv.Itoa(i+1) }>
					<h3 id={ "coverage-group-" + strconv.Itoa(i+1) }>{ group }</h3>
					<ul>
						for _, c := range InGroup(group) {
							<li>
								<span class="lab-cap">{ c.Name }</span>
								<span class="lab-cap-repos">
									for _, r := range Covering(c.ID) {
										<a href={ components.PublicURL(ctx, templ.URL("#repo-"+r.ID)) } class={ "lab-mini", templ.KV("is-core", r.Core) } title={ r.Name }>{ r.Label() }</a>
									}
								</span>
							</li>
						}
					</ul>
				</section>
			}
		</div>
	</section>
}

templ repoSection(id, eyebrow, title, accent, lead string, repos []Repo) {
	<section id={ id } class="site-container lab-section" aria-labelledby={ id + "-title" }>
		<div class="lab-heading" data-scroll-reveal>
			<span class="eyebrow">{ eyebrow }</span>
			<h2 id={ id + "-title" }>{ title }<em>{ accent }</em></h2>
			<p>{ lead }</p>
		</div>
		<div class="lab-repos">
			for _, r := range repos {
				@card(r)
			}
		</div>
	</section>
}

// card is one app: what it is and proves, then how we test it behind a
// native disclosure.
templ card(r Repo) {
	<article id={ "repo-" + r.ID } class="lab-repo" aria-labelledby={ "repo-" + r.ID + "-title" } data-scroll-reveal>
		<div class="lab-repo-head">
			<div class="lab-repo-name">
				<p class="lab-repo-meta">
					if r.Core {
						<span class="lab-core">Core</span>
					}
					<span>{ r.Kind }</span>
					<span aria-hidden="true">·</span>
					<span>{ r.Size }</span>
					<span aria-hidden="true">·</span>
					<span>{ r.Level } config</span>
				</p>
				<h3 id={ "repo-" + r.ID + "-title" }>
					<a href={ components.PublicURL(ctx, templ.URL(r.URL)) } rel="noopener noreferrer">
						<span class="lab-owner">{ r.Owner() }/</span>{ r.Title() }
						@components.ArrowUpRight()
						<span class="sr-only">(opens on GitHub)</span>
					</a>
				</h3>
			</div>
			@StatusBadge(r.Status)
		</div>
		<p class="lab-repo-why">{ r.Why }</p>
		<ul class="lab-stack" aria-label="Tech stack">
			for _, s := range r.Stack {
				<li>{ s }</li>
			}
		</ul>
		<dl class="lab-repo-facts">
			<div><dt>Architecture</dt><dd>{ r.Architecture }</dd></div>
			<div>
				<dt>Exercises</dt>
				<dd>
					<ul class="lab-covers">
						for _, c := range r.Covers {
							<li>{ CapabilityName(c) }</li>
						}
					</ul>
				</dd>
			</div>
		</dl>
		if r.Status.Note != "" {
			<p class="lab-repo-note">{ r.Status.Note }</p>
		}
		<details class="lab-plan">
			<summary>
				@components.ChevronDownIcon()
				<span>How we test it</span>
				<small>{ planSummary(r) }</small>
			</summary>
			<div class="lab-plan-body">
				<div class="lab-plan-files">
					<div class="lab-code">
						<div class="lab-code-bar">
							<code>.previewrc.yaml</code>
							<button type="button" class="kit-action kit-copy" data-copy={ r.Config } aria-label={ "Copy the .previewrc.yaml used for " + r.Name }>
								@components.CopyIcon()
								<span data-copy-status aria-live="polite">Copy</span>
							</button>
						</div>
						<pre><code>{ r.Config }</code></pre>
					</div>
					if len(r.Secrets) > 0 {
						<h4>Secrets set</h4>
						<ul class="lab-secrets">
							for _, s := range r.Secrets {
								<li><code>{ s.Name }</code><span>{ s.Hint }</span></li>
							}
						</ul>
					}
					if len(r.Changes) > 0 {
						<h4>Changes to the project</h4>
						<ul class="lab-list">
							for _, c := range r.Changes {
								<li>
									@inline(c)
								</li>
							}
						</ul>
					}
				</div>
				<div class="lab-plan-steps">
					<h4>Steps</h4>
					<ol class="lab-steps">
						for _, s := range r.Steps {
							<li>
								@inline(s)
							</li>
						}
					</ol>
					<h4>What must hold</h4>
					<ul class="lab-expect">
						for _, e := range r.Expect {
							<li>
								<span class="available-check" aria-hidden="true">
									@components.CheckIcon()
								</span>
								<span>
									@inline(e)
								</span>
							</li>
						}
					</ul>
					if len(r.Watch) > 0 {
						<h4>Known limits</h4>
						<ul class="lab-watch">
							for _, w := range r.Watch {
								<li>
									@components.InfoIcon()
									<span>
										@inline(w)
									</span>
								</li>
							}
						</ul>
					}
				</div>
			</div>
		</details>
	</article>
}

// closing turns the page's proof into the next step: the visitor's own
// repository.
templ closing(loggedIn bool) {
	<section class="site-container start-section lab-closing" data-scroll-reveal aria-labelledby="lab-closing-title">
		<div class="start-card">
			<span class="start-mark" aria-hidden="true">
				@components.BrandMark()
			</span>
			<span class="eyebrow">Early access</span>
			<h2 id="lab-closing-title">Your stack <em>is next.</em></h2>
			<p>Connect a repository and see your own pull requests running. Previa is free while it's in early access.</p>
			if loggedIn {
				@button.Button(button.Props{Href: components.LandingURL(ctx), Class: "hero-cta", Size: button.SizeLg}) {
					Open your dashboard
					@components.Arrow()
				}
			} else {
				@button.Button(button.Props{Href: "/auth/github/login", Class: "hero-cta", Size: button.SizeLg}) {
					@components.GitHubMark()
					Get started with GitHub
					@components.Arrow()
				}
			}
		</div>
	</section>
}

// StatusBadge says whether an app has passed every check on a live preview.
// Nothing is marked verified until Status.Verified is set.
templ StatusBadge(s Status) {
	if s.Verified != "" {
		<span class="badge tone-ok"><span class="badge-dot" aria-hidden="true"></span>Verified { s.Verified }</span>
	} else {
		<span class="badge badge-quiet tone-info"><span class="badge-dot" aria-hidden="true"></span>In testing</span>
	}
}
