package builds

import (
	"github.com/ajaykathwatee/previa/web/components"
	"github.com/ajaykathwatee/previa/web/components/button"
	"github.com/ajaykathwatee/previa/web/layouts"
	pages "github.com/ajaykathwatee/previa/web/pages/pullrequests"
	"strconv"
)

// Logs renders the current build attempt's output for one pull request. Lines
// are text nodes, so build output can never become markup.
templ Logs(username, csrf string, p LogPage) {
	@layouts.AppTrail("Build logs · #"+strconv.Itoa(int(p.Number))+" "+p.Name(), p.TrailParent(), "Build logs", username, csrf, components.NavBuilds) {
		<div class="repository-workspace build-logs-page">
			<header class="page-hero">
				<div class="page-hero-main">
					<span class="page-hero-icon" aria-hidden="true">
						@components.LogsIcon()
					</span>
					<div class="page-hero-text">
						<p class="page-hero-kicker">
							<span>{ p.Repository }</span>
							<span class="page-hero-kicker-sep" aria-hidden="true">·</span>
							<span>#{ strconv.Itoa(int(p.Number)) }</span>
						</p>
						<h1>Build logs</h1>
						if p.Title != "" {
							<p class="page-hero-sub log-pr-title">{ p.Title }</p>
						}
					</div>
				</div>
				<div class="page-hero-actions">
					<a class="hero-link" href={ templ.SafeURL(p.PRURL()) }>
						@components.PullRequestIcon()
						Pull request
					</a>
				</div>
			</header>
			<section class="workspace-panel log-status" aria-labelledby="log-status-title">
				<div class="log-status-main">
					<h2 id="log-status-title" class="sr-only">Build status</h2>
					<span class={ "badge", p.StatusTone } data-log-badge><span class="badge-dot" aria-hidden="true"></span><span data-log-label>{ p.StatusLabel }</span></span>
					<p class="log-summary" role="status" data-log-summary>{ p.Summary }</p>
					if p.StreamSHA != "" {
						<code class="sha" title={ p.StreamSHA } data-log-sha>{ pages.Short(p.StreamSHA) }</code>
					}
					if p.EventsURL != "" {
						<span class="log-live" data-log-connection aria-live="polite">Live updates off</span>
					}
				</div>
				if progress, ok := p.Progress(); ok {
					@pages.Tracker(progress, "")
				}
				<ul class="log-notices" data-log-notices>
					for _, n := range p.Notices {
						<li class={ "connection-notice", n.Tone }>
							@components.InfoIcon()
							<span>{ n.Text }</span>
						</li>
					}
				</ul>
				<template data-log-notice-template>
					<li class="connection-notice">
						@components.InfoIcon()
						<span></span>
					</li>
				</template>
			</section>
			<section
				class="workspace-panel log-panel"
				aria-labelledby="log-output-title"
				if p.EventsURL != "" {
					data-log-events={ p.EventsURL }
					data-log-cursor={ p.Cursor() }
				}
			>
				<header class="log-panel-header">
					<div class="log-panel-title">
						<span class="log-window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
						<h2 id="log-output-title">Output</h2>
						<span class="log-panel-note">Secrets are masked</span>
					</div>
					<nav class="log-pager" aria-label="Log pages">
						if p.Before > 0 {
							<a class="log-tool" href={ templ.SafeURL(p.EarlierURL()) } rel="prev">
								@components.ArrowLeft()
								Earlier lines
							</a>
						}
						if p.Tail {
							<a class="log-tool" href={ templ.SafeURL(p.LatestURL()) }>
								@components.RestartIcon()
								Refresh
							</a>
						} else {
							<a class="log-tool" href={ templ.SafeURL(p.LatestURL()) }>Latest lines</a>
						}
						if p.HasOutput {
							<button type="button" class="copy-button log-tool" data-copy-lines="[data-log-lines]" aria-label="Copy the lines shown">
								@components.CopyIcon()
								<span data-copy-status aria-live="polite">Copy</span>
							</button>
							<a class="log-tool" href={ templ.SafeURL(p.DownloadURL()) } download>
								@components.DownloadIcon()
								Download
							</a>
						}
						if p.CanDelete {
							<button type="button" class="log-tool log-tool-danger" data-open-dialog="delete-logs" commandfor="delete-logs" command="show-modal" aria-haspopup="dialog">
								@components.TrashIcon()
								Delete logs
							</button>
						}
						if p.EventsURL != "" {
							<label class="log-follow" hidden data-log-follow-control>
								<input type="checkbox" checked data-log-follow/>
								Follow output
							</label>
						}
					</nav>
				</header>
				<p class="log-empty" data-log-empty hidden?={ len(p.Lines) > 0 }>{ p.Empty }</p>
				<ol class="log-lines" aria-label="Build output" data-log-lines>
					for _, line := range p.Lines {
						<li id={ line.Anchor() } class={ "log-line", templ.KV("log-system", line.System), templ.KV("log-error", line.IsError()) }>
							<a class="log-number" href={ templ.SafeURL("#" + line.Anchor()) } tabindex="-1">{ line.Number() }</a>
							if line.Time() != "" {
								<time class="log-time" datetime={ line.ISOTime() } title={ line.ISOTime() } data-log-time>{ line.Time() }</time>
							} else {
								<span class="log-time"></span>
							}
							<span class="log-text">{ line.Text }</span>
						</li>
					}
				</ol>
				if p.More {
					<footer class="log-panel-footer">
						<a class="text-link" href={ templ.SafeURL(p.LaterURL()) } rel="next">
							Later lines
							@components.Arrow()
						</a>
					</footer>
				}
			</section>
			if p.CanDelete {
				@components.ConfirmationDialog("delete-logs", "Delete these build logs?", "This attempt's output is removed from Previa now and can't be recovered. Database backups keep it until they expire, at most 30 days. Building again records new logs.") {
					<form method="post" action={ templ.SafeURL(p.DeleteURL()) } class="dialog-actions">
						<input type="hidden" name="csrf_token" value={ csrf }/>
						<input type="hidden" name="epoch" value={ strconv.FormatInt(p.Epoch, 10) }/>
						@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{"autofocus": true, "commandfor": "delete-logs", "command": "close", "data-close-dialog": true}}) {
							Cancel
						}
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
							Delete logs
						}
					</form>
				}
			}
		</div>
	}
}
