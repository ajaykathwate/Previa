package auth

import (
	"net/url"

	"github.com/ajaykathwatee/previa/web/components"
	"github.com/ajaykathwatee/previa/web/components/button"
	"github.com/ajaykathwatee/previa/web/layouts"
)

// LoginOptions lets a person choose how to sign in. With Google off it still
// works as a one-button page, for links that name no method.
templ LoginOptions(next string, google bool) {
	@layouts.Document("Sign in") {
		@components.Navbar(false)
		<main id="content" tabindex="-1" class="auth-main">
			<div class="auth-backdrop" aria-hidden="true"><span class="hero-grid"></span><span class="hero-glow"></span></div>
			<div class="auth-stack">
				<section class="auth-card panel" aria-labelledby="login-title">
					<span class="auth-mark">
						@components.BrandMark()
					</span>
					<h1 id="login-title">Sign in to Previa</h1>
					<p class="auth-lead">
						if google {
							Choose how you sign in. Your workspace role decides what you can do.
						} else {
							Sign in with your GitHub account. Your workspace role decides what you can do.
						}
					</p>
					<div class="auth-providers">
						@button.Button(button.Props{Href: "/auth/github/login?next=" + url.QueryEscape(next), Size: button.SizeLg, Class: "auth-provider"}) {
							@components.GitHubMark()
							Continue with GitHub
						}
						if google {
							@button.Button(button.Props{Href: "/auth/google/login?next=" + url.QueryEscape(next), Variant: button.VariantOutline, Size: button.SizeLg, Class: "auth-provider"}) {
								@components.GoogleMark()
								Continue with Google
							}
						}
					</div>
					if google {
						<ul class="auth-hints" aria-label="Which one to use">
							<li>
								<span class="auth-hint-icon">
									@components.BranchIcon()
								</span>
								<span><strong>Building previews?</strong> Use GitHub. It connects your repositories.</span>
							</li>
							<li>
								<span class="auth-hint-icon">
									@components.EyeIcon()
								</span>
								<span><strong>Only reviewing?</strong> Google is enough. You don't need a GitHub account.</span>
							</li>
						</ul>
					}
					<p class="auth-footnote">
						Already use Previa? Sign in the way you did before, then add another method from Your profile. Adding one never changes your role.
					</p>
				</section>
				<p class="auth-legal">By continuing, you agree to the <a href="/policies/terms">Terms</a> and <a href="/policies/privacy">Privacy policy</a>.</p>
			</div>
		</main>
	}
}
