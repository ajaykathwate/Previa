package auth

import (
	"github.com/ajaykathwatee/previa/web/components"
	"github.com/ajaykathwatee/previa/web/components/alert"
	"github.com/ajaykathwatee/previa/web/components/button"
	"github.com/ajaykathwatee/previa/web/layouts"
)

templ Error(message string) {
	@layouts.Base("Sign-in") {
		<section class="standalone-card panel" aria-labelledby="signin-error-title">
			<span class="standalone-icon" aria-hidden="true">
				@components.AlertIcon()
			</span>
			<span class="eyebrow">Account sign-in</span>
			<h1 id="signin-error-title">Sign-in</h1>
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive, Class: "standalone-alert"}) {
				@alert.Description() {
					{ message }
				}
			}
			<div class="standalone-actions">
				@button.Button(button.Props{Href: "/auth/login"}) {
					@components.GitHubMark()
					Try signing in again
				}
				@button.Button(button.Props{Href: "/", Variant: button.VariantOutline}) {
					Back to home 
				}
			</div>
		</section>
	}
}
