package faq

import (
	"strconv"

	"github.com/ajaykathwatee/previa/web/components"
	"github.com/ajaykathwatee/previa/web/layouts"
)

// Page is the workspace FAQ: the same conversation as the home page, asked by
// the signed-in owner.
templ Page(username string, csrfToken string) {
	@layouts.App("FAQ", username, csrfToken, components.NavFAQ) {
		<header class="page-header">
			<div class="page-header-text">
				@components.PageTitle("Frequently asked questions", "Ask Previa about connecting repositories, builds, previews and security. Every answer describes how this release works today.")
			</div>
			<a class="text-link" href="/#how-it-works">
				How it works, step by step
				@components.Arrow()
			</a>
		</header>
		<section class="faq-page" aria-labelledby="faq-page-title">
			<h2 id="faq-page-title" class="sr-only">Questions and answers</h2>
			@Conversation(Owner(components.Initial(username)))
		</section>
	}
}

// Conversation is the FAQ as a chat. Without JavaScript every question is a
// native disclosure that opens Previa's answer; ui.js adds topic filters,
// search, a short typing pause and #faq-… links that open their answer.
templ Conversation(asker Asker) {
	<div class="faq" data-faq>
		<div class="faq-toolbar" data-faq-tools hidden>
			<div class="faq-filters" role="group" aria-label="Show questions about">
				@filter("all", "All topics", len(Questions()), true)
				for _, t := range Topics() {
					@filter(t.ID, t.Short, len(InTopic(t.ID)), false)
				}
			</div>
			<div class="search-field faq-search">
				<span class="search-field-icon">
					@components.SearchIcon()
				</span>
				<input type="search" data-faq-search placeholder="Search questions and answers" aria-label="Search questions and answers" autocomplete="off" spellcheck="false"/>
			</div>
		</div>
		<p class="sr-only" data-faq-status role="status" aria-live="polite"></p>
		<div class="faq-thread">
			@components.PreviaMessage(nil, nil) {
				<p>Hi, I'm Previa. These are the questions people ask me most. Open any of them and I'll answer.</p>
			}
			for _, t := range Topics() {
				<section class="faq-group" data-faq-group={ t.ID } aria-labelledby={ "faq-topic-" + t.ID }>
					<h3 class="faq-topic" id={ "faq-topic-" + t.ID }>{ t.Title }</h3>
					for _, q := range InTopic(t.ID) {
						@item(q, asker)
					}
				</section>
			}
			<div class="faq-empty" data-faq-empty hidden>
				@components.PreviaMessage(nil, nil) {
					<p>I don't have an answer that matches that yet. Try another word, or <button type="button" class="faq-reset" data-faq-reset>show every question</button>.</p>
				}
			</div>
		</div>
	</div>
}

templ filter(id, title string, count int, pressed bool) {
	<button type="button" class="faq-filter" data-faq-filter={ id } aria-pressed={ strconv.FormatBool(pressed) }>
		{ title }
		<span class="faq-filter-count">{ strconv.Itoa(count) }</span>
	</button>
}

// item is one question and its answer. The summary holds only phrasing
// content, so its accessible name is the question itself.
templ item(q Question, asker Asker) {
	<details class="faq-item" id={ "faq-" + q.ID } data-faq-item data-topic={ q.Topic }>
		<summary class="chat-msg is-asker faq-question">
			<span class="faq-toggle" aria-hidden="true">
				@components.PlusIcon()
			</span>
			<span class="chat-bubble">{ q.Ask }</span>
			@components.PersonAvatar(asker.Initial, asker.You)
		</summary>
		<div class="chat-msg is-previa faq-answer">
			@components.PreviaAvatar()
			<div class="chat-body">
				<p class="chat-name">Previa</p>
				@components.Typing()
				<div class="chat-bubble">
					@q.Answer
				</div>
			</div>
		</div>
	</details>
}

// Answers, in Previa's voice. Keep them true to the current release: update an
// answer in the same change that alters the behaviour it describes.
templ whatIsPrevia() {
	<p>I turn every GitHub pull request into its own live preview: the exact commit, built from your own <code>Dockerfile</code>, running at a private HTTPS link that I post right on the pull request.</p>
	<p>Reviewers click the link, try the change and approve with confidence, without checking out the branch.</p>
}

templ isItFree() {
	<p>Yes. I'm free while I'm in early access, so you can try me on your own pull requests.</p>
	<p>Each workspace has a monthly allowance of build minutes and live previews; its <strong>Usage</strong> page shows how much is left.</p>
}

templ repositoryFiles() {
	<p>Two files at its root: a <code>Dockerfile</code> and a <code>.previewrc.yaml</code>. The config can be as short as <code>{ "{}" }</code>; by default I expect your app on port 3000.</p>
	<p>When you need more, it sets the Dockerfile path, the port, a health check path, plain environment variables and a size: <code>small</code>, <code>standard</code> or <code>large</code>.</p>
	<p>Don't have them yet? Open <strong>Starter kits</strong>, pick your stack and what it uses, and I'll write both files, already checked, for you to edit and copy.</p>
	<p>Not sure they're right? On the repository's <strong>Setup</strong> tab, choose <strong>Check setup</strong>: I read both files on a pull request's latest commit and tell you what to fix, before anything builds.</p>
}

templ languages() {
	<p>Anything that runs in a Docker container and answers HTTP: Node.js, Python, Ruby, Go, Java, PHP, static sites and more. APIs work too.</p>
}

templ signInAccess() {
	<p>No. Signing in only tells me who you are.</p>
	<p>I read code only in the repositories where you install my GitHub App, and only to build previews and post a comment and a check on the pull request.</p>
}

templ connectRepository() {
	<p>Open <strong>Repositories</strong> and choose <strong>Install on GitHub</strong>. Pick the repositories there, then authorize as the same account you signed in with. I make sure the installation is really yours before linking anything.</p>
	<p>New repositories start in Manual mode, so nothing builds until you ask. Then open the repository's <strong>Setup</strong> tab: it walks one pull request to its first preview.</p>
	<p>While I'm in early access, each new workspace is approved by hand first. Its <strong>Early access</strong> page shows where it stands; connecting opens once it's approved.</p>
}

templ whenItBuilds() {
	<p>In <strong>Manual</strong> mode, the default, when you press <strong>Build latest commit</strong> on a pull request. In <strong>Automatic</strong> mode, five minutes after your last push, so a burst of pushes becomes one build.</p>
	<p>In Automatic mode the pull request counts down to its build, and another push restarts the five minutes. If GitHub's notice of a push goes missing, I find the commit on my next check of your live previews, or when you choose <strong>Sync Pull Requests</strong>.</p>
	<p>Either way I check with GitHub right before building, and I only build a pull request that can merge.</p>
}

templ previewLink() {
	<p>In the comment I keep up to date on the pull request, and on the pull request's page in your Previa dashboard.</p>
	<p>The link stays the same for the life of the pull request, through every rebuild.</p>
}

templ newCommit() {
	<p>Your current preview keeps serving while the new commit builds: on its own in Automatic mode, or when you press <strong>Build latest commit</strong> in Manual mode.</p>
	<p>The new version takes over the same link only once it passes its health check, so reviewers never land on a broken page. If the build fails, the previous preview stays up and my comment says what went wrong.</p>
}

templ previewLifetime() {
	<p>Until its pull request is closed or merged, which removes it right away, or until 48 hours after it was last published.</p>
	<p>You can also tear it down yourself. Building again brings it back at the same link.</p>
}

templ backendApps() {
	<p>Yes. An API's preview link answers requests just like a website's does.</p>
	<p>In <code>.previewrc.yaml</code> you can ask for PostgreSQL, Redis or MySQL from the server's catalog, run a setup command for migrations and seed data, keep up to three background processes running and link your API docs. Each preview gets its own databases; turn on <strong>Test data</strong> to seed them, start from a snapshot of your default branch and keep data between pushes. Docker Compose and separate app images are not available; processes use the same image as the app.</p>
	<p>If a preview needs an outside test database or service, approve it on the repository's <strong>Outbound</strong> tab.</p>
}

templ buildFailed() {
	<p>The comment and the check on the pull request say it failed, and your dashboard says what went wrong in plain words, with the next steps and the full build log one click away.</p>
	<p>When it's fixed, push again or choose <strong>Retry build</strong>.</p>
}

templ buildDisabled() {
	<p>When I can't build it right now, its page says why and what fixes it instead of offering the button. The usual reasons:</p>
	<ul>
		<li>GitHub is still checking whether the pull request can merge, or it has conflicts;</li>
		<li>the pull request is closed or merged;</li>
		<li>I no longer have access to the repository, or GitHub no longer lets you read its code;</li>
		<li>your workspace is still waiting for early-access approval.</li>
	</ul>
	<p>Reviewers don't build: they open previews and leave feedback.</p>
}

templ waitingForCapacity() {
	<p>I'm busy right now, so your build waits its turn instead of failing. It starts on its own as soon as there's room.</p>
}

templ forkPullRequests() {
	<p>Yes. Every build and every preview runs on its own, without admin rights and with firm limits.</p>
	<p>Pull requests from forks never receive your secrets or your approved connections, and they can't affect your other builds.</p>
}

templ secretsProtected() {
	<ul>
		<li>Kept as one encrypted .env file per repository. Values stay hidden on the page until an Owner or Admin chooses to edit the file; nobody else can open it.</li>
		<li>Added when a preview starts by default. Builds receive a value only when you explicitly allow it, through a BuildKit secret mount. REGISTRY_AUTH is reserved for private base image pulls and never reaches the app.</li>
		<li>Masked in build and preview logs.</li>
		<li>Never given to pull requests from forks.</li>
	</ul>
	<p>Use sandbox keys and test databases, never production credentials. Review branch code before allowing build access: it can copy a mounted secret into an image or send it elsewhere. Previa never uses secret build arguments.</p>
}

templ internalNetwork() {
	<p>No. A preview can reach public websites and services, plus the destinations you approve on the <strong>Outbound</strong> tab. Private networks stay out of reach.</p>
}

templ whoCanOpen() {
	<p>By default, anyone who has its link. Each link has a random part, so previews can't be guessed.</p>
	<p>An Owner or Admin can make a repository's previews <strong>private</strong>: visitors sign in first, and only people with access to that repository can open them.</p>
	<p>Either way, use test data and sandbox credentials in previews, never production ones.</p>
}

templ teams() {
	<p>Yes. Create a workspace and invite people by their GitHub username. Each person gets a role:</p>
	<ul>
		<li><strong>Owners</strong> and <strong>Admins</strong> manage the workspace, its repositories and its members;</li>
		<li><strong>Developers</strong> build and inspect the repositories you grant them;</li>
		<li><strong>Reviewers</strong> open previews and leave feedback, without seeing code, logs or secrets.</li>
	</ul>
	<p>Everyone sees only what their role allows, and removing someone ends their access at once.</p>
}

templ reviewFeedback() {
	<p>On the pull request's <strong>review page</strong> in Previa. Developers write what to test; anyone with preview access records findings against the exact deployment they tested, replies and resolves them.</p>
	<p>My comment on the pull request links straight to it, and feedback stays in Previa rather than in the GitHub thread.</p>
}

templ dashboardSafety() {
	<p>No. Previews never run on my own address, so a preview can't read or use your Previa sign-in, and every change in the dashboard is protected.</p>
}

templ whereCodeGoes() {
	<p>It's used only to build and run your preview. I download each commit from GitHub when it's time to build it.</p>
	<p>When the pull request closes or the preview expires, the preview and its data are removed. Build logs stay for 14 days so you can read them, then they're deleted too.</p>
}

templ interruptedBuild() {
	<p>Nothing is lost. Every request is saved before it runs, so an interrupted build simply starts again on its own, and anything left half-done is cleaned up automatically.</p>
}

templ buildHistory() {
	<p>Not a long one, on purpose: previews are meant to be disposable. I keep the log of the latest attempt for 14 days and one living comment per pull request.</p>
	<p>The checks I add to each commit stay on GitHub, so that history lives where your team already looks.</p>
}
