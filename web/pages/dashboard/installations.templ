package dashboard

import "strconv"
import "github.com/ajaykathwatee/previa/web/components"

templ RepositoryConnections(csrfToken string, enabled bool, installations []Installation) {
	<section id="repositories" tabindex="-1" class="workspace-panel repository-panel" aria-labelledby="repositories-title">
		<div class="workspace-panel-top"><div><span class="eyebrow">START WITH YOUR SOURCE</span><h2 id="repositories-title">Repositories</h2></div></div>
		if enabled {
			<div class="repository-empty">
				if len(installations)==0 {
					<div class="empty-source-icon" aria-hidden="true">
						@components.BranchIcon()
					</div>
					<h3>Connect your code, on your terms.</h3>
					<p>Choose repositories through the GitHub App, then authorize the same GitHub account to verify your connection. Connecting does not start a build.</p>
				}
				<form method="post" action="/installations/start">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button type="submit" class="hero-cta">Install on a repo <span aria-hidden="true">↗</span></button>
				</form>
			</div>
			for _, installation := range installations {
				<div class="installation-summary">
					<h3>{ installation.Account }</h3>
					<p>Installation { strconv.FormatInt(installation.ID,10) } · { installation.Status }</p>
					if len(installation.Repositories)==0 {
						<p>No repositories are linked. Reconnect after selecting repositories on GitHub.</p>
					}
					<ul class="installation-repositories">
						for _, repo := range installation.Repositories {
							<li>
								<span>{ repo.FullName }</span>
								if repo.Accessible {
									<span class="installation-access">Access granted</span>
								} else {
									<span class="availability-note">Access unavailable</span>
								}
							</li>
						}
					</ul>
				</div>
			}
		} else {
			<div class="repository-empty">
				<div class="empty-source-icon" aria-hidden="true">
					@components.BranchIcon()
				</div>
				<h3>Give your code a place to come to life.</h3>
				<p>GitHub App installation linking requires the server's App credentials. Signing in only verifies your identity.</p>
				<button type="button" class="upcoming-action" disabled aria-describedby="repository-availability">Connect a repository <span aria-hidden="true">↗</span></button>
				<p id="repository-availability" class="availability-note">Not configured. See the development setup instructions.</p>
			</div>
		}
		<div class="repository-footer">
			<span>GitHub identity connected</span>
			<a href="/#workflow" class="text-link">
				How the workflow fits together
				@components.Arrow()
			</a>
		</div>
	</section>
}
