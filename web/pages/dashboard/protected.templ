package dashboard

import (
	"github.com/ajaykathwatee/previa/web/layouts"
	"github.com/ajaykathwatee/previa/web/components/button"
	"github.com/ajaykathwatee/previa/web/components/card"
)

templ Protected(username string) {
	@layouts.Base("Protected page") {
		@card.Card(card.Props{Class: "mx-auto max-w-lg"}) {
			@card.Header() {
				<h1 class="text-2xl font-semibold tracking-tight">Protected page</h1>
				<p class="text-muted-foreground">Signed in as { username }</p>
			}
			@card.Content() {
				@button.Button(button.Props{Href: "/", Variant: button.VariantOutline}) { Home }
			}
		}
	}
}
