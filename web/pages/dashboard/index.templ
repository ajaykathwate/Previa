package dashboard

import "strconv"
import "github.com/ajaykathwatee/previa/web/components"
import "github.com/ajaykathwatee/previa/web/layouts"

templ Index(username string, csrfToken string, summary Summary) {
	@layouts.App("Overview", username, csrfToken, components.NavOverview) {
		<header class="page-header dashboard-heading">
			<div class="page-header-text">
				<span class="eyebrow">Overview</span>
				<h1>Welcome back, <span class="accent-text">{ username }</span></h1>
				<p>Your workspace at a glance. Every number here comes from your own linked installations.</p>
			</div>
			<a href="/protected" class="identity-badge"><span class="status-dot" aria-hidden="true"></span>Signed in with GitHub</a>
		</header>
		<section class="stat-grid overview-stats" aria-label="Workspace counts">
			@statTile("/repositories", "Linked installations", summary.Installations, "Manage connections", components.ServerIcon())
			@statTile("/repositories?access=all", "Repositories", summary.Repositories, "Browse your source", components.RepositoryIcon())
			@statTile("/repositories?access=available", "Access available", summary.Available, "View accessible repositories", components.ShieldIcon())
			@statTile("/repositories?access=unavailable", "Access unavailable", summary.Unavailable(), "Review removed access", components.AlertIcon())
		</section>
		<div class="overview-grid">
			<section class="panel pipeline-panel" aria-labelledby="pipeline-title">
				<header class="panel-header">
					<div><span class="eyebrow">Preview pipeline</span><h2 id="pipeline-title">From pull request to preview</h2></div>
					<p class="legend"><span class="legend-item is-live">Connected</span><span class="legend-item is-soon">Coming next</span></p>
				</header>
				<ol class="pipeline">
					for i, stage := range PipelineStages {
						<li
							if stage.Live {
								class="pipeline-stage is-live"
							} else {
								class="pipeline-stage is-soon"
							}
						>
							<span class="pipeline-node" aria-hidden="true">
								if stage.Live {
									@components.CheckIcon()
								} else {
									{ strconv.Itoa(i + 1) }
								}
							</span>
							<strong>{ stage.Name }</strong>
							<span class="pipeline-detail">{ stage.Detail }</span>
							if stage.Live {
								<span class="badge tone-ok">Connected</span>
							} else {
								<span class="badge tone-neutral">Coming next</span>
							}
						</li>
					}
				</ol>
				<p class="panel-note">
					@components.InfoIcon()
					Build execution stays disabled until source, runtime, routing and cleanup adapters are connected. Nothing on this page is simulated.
				</p>
			</section>
			<section class="panel checklist-panel" aria-labelledby="setup-title">
				<header class="panel-header"><div><span class="eyebrow">Getting set up</span><h2 id="setup-title">Your next steps</h2></div></header>
				<ol class="checklist">
					@checkItem(true, false, "Sign in with GitHub", "Your Previa session is active.", "", "")
					@checkItem(summary.Installations > 0, false, "Connect the GitHub App", "Choose which repositories Previa may read.", "/repositories", "Open repositories")
					@checkItem(summary.Repositories > 0, false, "Link repositories", "Verified repositories appear in your directory.", "/repositories?access=all", "View directory")
					@checkItem(false, false, "Sync pull requests", "Open a repository, then choose Sync Pull Requests.", "/repositories?access=available", "Pick a repository")
					@checkItem(false, true, "Build a preview", "Arrives with the execution adapters.", "", "")
				</ol>
			</section>
			<section class="shortcut-grid" aria-label="Workspace areas">
				@shortcut("/builds", "Builds", "Current and latest build requests across your repositories, with their captured commits.", "View builds", components.BuildIcon())
				@shortcut("/environments", "Environments", "Persisted deployment state and deployed commits for each pull request.", "View environments", components.EnvironmentIcon())
				@shortcut("/developer-tools", "Developer tools", "Send a harmless queue ping to confirm the River worker is connected.", "Open tools", components.TerminalIcon())
			</section>
		</div>
	}
}

templ statTile(href, label string, value int64, action string, icon templ.Component) {
	<a class="stat-tile" href={ templ.SafeURL(href) }>
		<span class="stat-head">
			<span class="stat-icon">
				@icon
			</span><span class="stat-label">{ label }</span>
		</span>
		<strong class="stat-value">{ strconv.FormatInt(value, 10) }</strong>
		<span class="stat-action">
			{ action }
			@components.ArrowUpRight()
		</span>
	</a>
}

templ checkItem(done, soon bool, title, detail, href, action string) {
	<li
		if done {
			class="check-item is-done"
		}
		else
		if soon {
			class="check-item is-soon"
		} else {
			class="check-item"
		}
	>
		<span class="check-mark" aria-hidden="true">
			if done {
				@components.CheckIcon()
			}
		</span>
		<div class="check-text">
			<strong>
				{ title }
				if done {
					<span class="sr-only">(complete)</span>
				}
			</strong>
			<span>{ detail }</span>
		</div>
		if soon {
			<span class="soon-tag">Soon</span>
		} else if !done && href != "" {
			<a class="check-action" href={ templ.SafeURL(href) }>
				{ action }
				@components.Arrow()
			</a>
		}
	</li>
}

templ shortcut(href, title, detail, action string, icon templ.Component) {
	<a class="shortcut-card" href={ templ.SafeURL(href) }>
		<span class="shortcut-icon">
			@icon
		</span>
		<h2>{ title }</h2>
		<p>{ detail }</p>
		<span class="shortcut-action">
			{ action }
			@components.Arrow()
		</span>
	</a>
}
