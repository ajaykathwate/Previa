package pullrequests

import "strconv"
import "github.com/ajaykathwatee/previa/web/components"
import "github.com/ajaykathwatee/previa/web/components/button"
import "github.com/ajaykathwatee/previa/web/layouts"

templ Index(username, csrf string, p Page) {
	@layouts.App("Repositories", username, csrf, components.NavRepositories) {
		<div class="repository-workspace">
			<p class="repository-search-feedback" data-detail-feedback role="status" aria-live="polite"></p>
			<section id="repository-detail" class="repository-page" aria-label="Repository details" hx-sync="this:replace" hx-request='{"timeout":10000}'>
				@Panel(p, csrf)
			</section>
			if p.LiveURL != "" {
				// Server-sent change signals refetch the panel through the ordinary
				// GET handler; ui.js keeps the stream and defers refreshes while
				// filters are focused or a confirmation is open.
				<div hidden data-live-events={ p.LiveURL } data-live-refresh hx-get={ p.CurrentURL() } hx-trigger="live-update from:body" hx-target="#repository-detail" hx-sync="#repository-detail:drop"></div>
			}
		</div>
	}
}

templ Panel(p Page, csrf string) {
	<div class="pr-workspace" data-selected-repo={ strconv.FormatInt(p.RepoID, 10) }>
		<header class="pr-panel-heading">
			<div class="pr-heading-text">
				<nav aria-label="Repository location" class="pr-location">
					<a href={ templ.SafeURL(p.CloseURL()) } class="text-link pr-directory-link">
						@components.ArrowLeft()
						Repositories
					</a>
					<div class="pr-title-row">
						<span class="pr-repo-icon" aria-hidden="true">
							if p.SelectedPR!=nil {
								@components.PullRequestIcon()
							} else {
								@components.RepositoryIcon()
							}
						</span>
						<h1 tabindex="-1" data-detail-heading class="pr-breadcrumb">
							<a href={ templ.SafeURL(p.CloseURL()) } title={ p.Owner() }>{ p.Owner() }</a>
							<span aria-hidden="true">/</span>
							<a
								href={ templ.SafeURL(p.PageURL(p.Number)) }
								title={ p.RepositoryName() }
								if p.SelectedPR==nil {
									aria-current="page"
								}
							>{ p.RepositoryName() }</a>
							if p.SelectedPR!=nil {
								<span aria-hidden="true">/</span><span aria-current="page" class="pr-current-crumb" title={ p.Selected().Title }>#{ strconv.Itoa(int(p.Selected().Number)) } · { p.Selected().Title }</span>
							}
						</h1>
					</div>
				</nav>
				<p class="pr-summary" role="status">
					<span class="pr-summary-item">
						@components.ClockIcon()
						<span>
							Last synced ·
							if p.LastRefresh!="" {
								<time datetime={ p.LastRefresh }>{ TimeLabel(p.LastRefresh) }</time>
							} else {
								<span>Never</span>
							}
						</span>
					</span>
					<span class="pr-summary-item pr-mode">
						@components.BuildIcon()
						<span>{ Label(p.Mode) } builds</span>
					</span>
					if !p.Available {
						<span class="sync-state tone-neutral">Repository unavailable</span>
					} else if !p.DiscoveryEnabled {
						<span class="sync-state tone-neutral">Sync not configured</span>
					}
					if p.SyncState=="queued" || p.SyncState=="syncing" {
						<span class="sync-state tone-info is-syncing">Syncing</span>
					} else if p.SyncState=="failed" {
						<span class="sync-state sync-failed tone-danger" title={ p.SyncMessage }>Sync failed</span>
					}
					<span class="live-indicator" aria-hidden="true"><span class="live-dot"></span><span class="live-label-live">Live</span><span class="live-label-reconnecting">Reconnecting</span><span class="live-label-offline">Live updates paused · reload to resume</span></span>
				</p>
			</div>
			if p.SelectedPR==nil {
				<div class="pr-header-actions">
					<form method="post" action={ RepoURL(p.RepoID) + "/refresh" } hx-post={ RepoURL(p.RepoID) + "/refresh" } hx-target="#repository-detail" hx-sync="#repository-detail:replace">
						<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="workspace_query" value={ p.Query() }/>
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Class: "sync-button", Disabled: !p.Available || !p.DiscoveryEnabled || p.SyncState == "queued" || p.SyncState == "syncing"}) {
							@components.SyncIcon()
							Sync Pull Requests
						}
					</form>
					@AutomaticSwitch(p, csrf)
				</div>
			}
		</header>
		if p.SelectedPR!=nil {
			@PRDetail(p, p.Selected())
		} else {
			<p class="policy-hint">
				@components.InfoIcon()
				if p.Mode=="automatic" {
					<span><strong>Automatic mode.</strong> New commits on open pull requests schedule work after five quiet minutes. Existing pull requests are not bulk-built.</span>
				} else {
					<span><strong>Manual mode.</strong> Pull request events update tracking only. Nothing builds without an explicit request.</span>
				}
			</p>
			<section class="workspace-panel repository-browser" aria-label="Pull request browser">
				<form id="pull-request-filters" method="get" action={ RepoURL(p.RepoID) } class="repository-toolbar" role="search" hx-get={ RepoURL(p.RepoID) } hx-trigger="submit, input delay:300ms from:#pull-request-search, change from:.pr-state-option" hx-target="#pull-request-results" hx-sync="#repository-detail:replace" hx-replace-url="true" hx-request='{"timeout":10000}' data-repository-search="pull requests">
					@ContextFields(p)
					<div class="repository-search search-field">
						<label for="pull-request-search" class="sr-only">Find a pull request</label>
						<span class="search-field-icon">
							@components.SearchIcon()
						</span>
						<input id="pull-request-search" type="search" name="pr_q" value={ p.Search } maxlength="100" placeholder="Search title, number, author or branch" autocomplete="off"/>
					</div>
					<fieldset class="repository-access">
						<legend class="sr-only">State</legend>
						<div class="repository-access-tabs segmented">
							for _,state:=range []string{"open","closed","merged","all"} {
								<label><input class="sr-only pr-state-option" type="radio" name="pr_state" value={ state } checked?={ p.State==state }/><span>{ Label(state) }</span></label>
							}
						</div>
					</fieldset>
					<noscript><button type="submit" class="text-link">Apply filters</button></noscript>
					<p class="repository-search-feedback" data-repository-feedback role="status" aria-live="polite"></p>
				</form>
				<div id="pull-request-results" class="repository-results">
					@Results(p)
				</div>
			</section>
		}
		if p.SelectedPR==nil {
			@components.ConfirmationDialog("build-policy", "Enable automatic builds?", "Future PR updates will schedule work after five quiet minutes. Existing PRs are not bulk-built. Build execution is not available yet.") {
				@PolicyForm(p, csrf, true)
			}
			<noscript>
				<section class="workspace-panel pr-policy-fallback">
					<h3>Automatic builds</h3>
					<p>Automatic applies only to future events. Manual cancels unstarted automatic requests.</p>
					@PolicyForm(p, csrf, false)
				</section>
			</noscript>
		}
	</div>
}

templ AutomaticSwitch(p Page, csrf string) {
	if p.Mode=="automatic" {
		<form method="post" action={ RepoURL(p.RepoID) + "/policy" } hx-post={ RepoURL(p.RepoID) + "/policy" } hx-target="#repository-detail" hx-sync="#repository-detail:replace" hx-disabled-elt="find button">
			<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="workspace_query" value={ p.Query() }/><input type="hidden" name="mode" value="manual"/>
			<button type="submit" role="switch" aria-checked="true" class="automatic-switch" disabled?={ !p.Available }><span>Enable Automatic Builds</span><span class="switch-track" aria-hidden="true"><span></span></span></button>
		</form>
	} else {
		<button type="button" role="switch" aria-checked="false" class="automatic-switch" disabled?={ !p.Available } data-open-dialog="build-policy" commandfor="build-policy" command="show-modal" aria-haspopup="dialog"><span>Enable Automatic Builds</span><span class="switch-track" aria-hidden="true"><span></span></span></button>
	}
}

templ ContextFields(p Page) {
	for key,value:=range p.DirectoryFilters() {
		<input type="hidden" name={ key } value={ value }/>
	}
}

templ PolicyForm(p Page, csrf string, modal bool) {
	<form method="post" action={ RepoURL(p.RepoID) + "/policy" } class="dialog-actions" hx-disabled-elt="find button[type=submit]" hx-post={ RepoURL(p.RepoID) + "/policy" } hx-target="#repository-detail" hx-sync="#repository-detail:replace">
		<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="workspace_query" value={ p.Query() }/>
		<p class="repository-search-feedback" data-policy-feedback role="status" aria-live="polite"></p>
		<input type="hidden" name="mode" value={ p.PolicyMode(modal) }/>
		if modal {
			@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-close-dialog": true, "commandfor": "build-policy", "command": "close"}}) {
				Cancel
			}
		}
		@button.Button(button.Props{Type: button.TypeSubmit, Disabled: !p.Available}) {
			{ p.PolicyAction(modal) }
		}
	</form>
}

templ Results(p Page) {
	<div class="repository-table-scroll" tabindex="0" role="region" aria-label="Pull request list">
		if len(p.Rows)==0 {
			<div class="repository-empty">
				<span class="empty-source-icon" aria-hidden="true">
					@components.PullRequestIcon()
				</span>
				<h3>No pull requests in this view</h3>
				<p>Try another state or search. Sync Pull Requests refreshes what Previa knows from GitHub.</p>
			</div>
		} else {
			<table class="pr-table">
				<thead><tr><th>Pull request</th><th>Head commit</th><th>State</th><th>Latest request</th></tr></thead>
				<tbody>
					for _,pr:=range p.Rows {
						<tr>
							<td class="pr-cell-main">
								<div class="pr-cell-wrap">
									<span class={ "pr-state-icon", Tone(pr.State) } aria-hidden="true">
										@components.PullRequestIcon()
									</span>
									<div class="pr-cell-text">
										<a href={ templ.SafeURL(p.DetailURL(pr.Number)) }>#{ strconv.Itoa(int(pr.Number)) } · { pr.Title }</a>
										<small>
											<span>{ pr.Author }</span>
											<code class="branch-chip">{ pr.Branch }</code>
											if pr.Fork {
												<span class="meta-flag">· Fork</span>
											}
											if pr.NeedsRefresh {
												<span class="meta-flag tone-warn">· Refresh required</span>
											}
										</small>
									</div>
								</div>
							</td>
							<td class="pr-cell-sha" data-label="Head"><code class="sha">{ Short(pr.SHA) }</code></td>
							<td class="pr-cell-state" data-label="State"><span class={ "repository-status", "badge", Tone(pr.State) }><span class="badge-dot" aria-hidden="true"></span>{ Label(pr.State) }</span></td>
							<td class="pr-cell-build" data-label="Latest request"><span class={ "badge", "badge-quiet", Tone(pr.Build) }>{ Label(pr.Build) }</span></td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
	<footer class="repository-pagination">
		<p role="status" aria-live="polite">
			{ strconv.FormatInt(p.Total,10) } pull requests · Page { strconv.FormatInt(p.Number,10) } of { strconv.FormatInt(p.Pages,10) }
		</p>
		<nav aria-label="Pull request pages" class="pager">
			if p.Number>1 {
				<a href={ templ.SafeURL(p.PageURL(p.Number - 1)) } hx-get={ p.PageURL(p.Number - 1) } hx-target="#pull-request-results" hx-sync="#repository-detail:replace" hx-push-url="true" rel="prev">
					@components.ArrowLeft()
					Previous
				</a>
			}
			if p.Number<p.Pages {
				<a href={ templ.SafeURL(p.PageURL(p.Number + 1)) } hx-get={ p.PageURL(p.Number + 1) } hx-target="#pull-request-results" hx-sync="#repository-detail:replace" hx-push-url="true" rel="next">
					Next
					@components.Arrow()
				</a>
			}
		</nav>
	</footer>
}

templ PRDetail(p Page, pr PR) {
	<div class="pr-detail-content">
		<header class="pr-detail-heading">
			<a href={ templ.SafeURL(p.PageURL(p.Number)) } class="text-link back-link">
				@components.ArrowLeft()
				Back to pull requests
			</a>
			<p class="pr-meta">
				<span class={ "badge", Tone(pr.State) }><span class="badge-dot" aria-hidden="true"></span>{ Label(pr.State) }</span>
				if pr.Author!="" {
					<span class="pr-meta-item"><span class="user-avatar user-avatar-sm" aria-hidden="true">{ components.Initial(pr.Author) }</span>{ pr.Author }</span>
				}
				if pr.Branch!="" {
					<code class="branch-chip">
						@components.BranchIcon()
						{ pr.Branch }
					</code>
				}
				if pr.Fork {
					<span class="badge tone-warn">Fork</span>
				}
			</p>
		</header>
		if pr.State=="conflicts" {
			<p class="connection-notice tone-warn">
				@components.AlertIcon()
				Build refused: resolve merge conflicts and push a new commit first.
			</p>
		} else if pr.State=="checking" {
			<p class="connection-notice tone-info">
				@components.ClockIcon()
				Build paused: GitHub is checking mergeability. Wait for the check or sync pull requests again.
			</p>
		}
		if pr.NeedsRefresh {
			<p class="connection-notice tone-warn">
				@components.AlertIcon()
				Conflicting upstream observations need a fresh GitHub snapshot. Refresh this repository before requesting work.
			</p>
		}
		<div class="pr-detail-grid lifecycle" role="list" aria-label="Commit lifecycle">
			<section class="workspace-panel lifecycle-step" role="listitem">
				<header>
					<span class="lifecycle-index" aria-hidden="true">01</span>
					<span class="lifecycle-icon" aria-hidden="true">
						@components.CommitIcon()
					</span>
				</header>
				<h2>Latest observed commit</h2>
				<code class="sha sha-full">{ pr.SHA }</code>
				<p><span class={ "badge", Tone(pr.State) }>{ Label(pr.State) }</span></p>
			</section>
			<section class="workspace-panel lifecycle-step" role="listitem">
				<header>
					<span class="lifecycle-index" aria-hidden="true">02</span>
					<span class="lifecycle-icon" aria-hidden="true">
						@components.BuildIcon()
					</span>
				</header>
				<h2>Current build request</h2>
				<code class="sha">{ Short(pr.RequestedSHA) }</code>
				<p>
					<span class={ "badge", Tone(pr.Build) }>{ Label(pr.Build) }</span>
				</p>
				if pr.Deadline!="" && pr.Build=="pending" {
					<p class="lifecycle-note">Eligible after <time datetime={ pr.Deadline }>{ TimeLabel(pr.Deadline) }</time>.</p>
				}
			</section>
			<section class="workspace-panel lifecycle-step" role="listitem">
				<header>
					<span class="lifecycle-index" aria-hidden="true">03</span>
					<span class="lifecycle-icon" aria-hidden="true">
						@components.EnvironmentIcon()
					</span>
				</header>
				<h2>Deployed preview</h2>
				<code class="sha">{ Short(pr.DeployedSHA) }</code>
				<p>
					<span class={ "badge", Tone(pr.Environment) }>{ Label(pr.Environment) }</span>
				</p>
				if pr.DeployedSHA!="" && pr.DeployedSHA!=pr.SHA {
					<p class="lifecycle-note tone-warn">This deployment reflects an older commit.</p>
				}
			</section>
		</div>
		<div class="pr-detail-actions">
			@button.Button(button.Props{Disabled: true, Attributes: templ.Attributes{"aria-describedby": "build-unavailable"}}) {
				@components.BuildIcon()
				Build latest commit
			}
			if pr.URL!="" {
				<a class="text-link github-link" href={ templ.SafeURL(pr.URL) } target="_blank" rel="noopener noreferrer">
					View on GitHub
					@components.ArrowUpRight()
				</a>
			}
			<p id="build-unavailable" class="repository-help">Build execution, runtime health, live logs and teardown controls are not available yet.</p>
		</div>
		<section class="upcoming-grid" aria-labelledby="upcoming-title">
			<h2 id="upcoming-title" class="upcoming-title">Coming with build execution</h2>
			@upcoming("Live build logs", "Streamed output for this pull request's current build.", components.LogsIcon())
			@upcoming("Preview URL and health", "A routed subdomain with readiness checks.", components.LinkIcon())
			@upcoming("Teardown control", "Remove the preview on demand, before it expires.", components.EyeIcon())
		</section>
	</div>
}

templ upcoming(title, detail string, icon templ.Component) {
	<div class="upcoming-card">
		<span class="upcoming-icon" aria-hidden="true">
			@icon
		</span>
		<div><strong>{ title }</strong><span>{ detail }</span></div>
		<span class="soon-tag">Soon</span>
	</div>
}

templ ActivityIndex(username, csrf string, p Activity) {
	{{
		title := "Builds"
		nav := components.NavBuilds
		if p.Environments {
			title = "Environments"
			nav = components.NavEnvironments
		}
	}}
	@layouts.App(title, username, csrf, nav) {
		<div class="repository-workspace activity-page">
			<header class="page-header workspace-page-heading">
				<div class="page-header-text">
					<span class="eyebrow">Delivery</span>
					<h1>{ title }</h1>
					if p.Environments {
						<p>Persisted deployment state. Runtime health and public routing are not connected yet.</p>
					} else {
						<p>Current/latest authorized requests, not a permanent attempt history. Execution is not available yet.</p>
					}
				</div>
				<nav class="segmented segmented-nav" aria-label="Delivery views">
					<a
						href="/builds"
						if !p.Environments {
							aria-current="page"
						}
					>
						@components.BuildIcon()
						<span>Builds</span>
					</a>
					<a
						href="/environments"
						if p.Environments {
							aria-current="page"
						}
					>
						@components.EnvironmentIcon()
						<span>Environments</span>
					</a>
				</nav>
			</header>
			<section class="workspace-panel repository-browser">
				<div class="repository-results">
					<div class="repository-table-scroll" tabindex="0" role="region" aria-label={ title + " list" }>
						if len(p.Rows)==0 {
							<div class="repository-empty activity-empty">
								<span class="empty-source-icon" aria-hidden="true">
									if p.Environments {
										@components.EnvironmentIcon()
									} else {
										@components.BuildIcon()
									}
								</span>
								<h2>No { title } to show.</h2>
								<p>Only real saved records appear here. Connecting or discovering a repository does not create a deployment.</p>
								<ul class="empty-explainer">
									if p.Environments {
										<li><strong>Status</strong><span>Deployment lifecycle per pull request</span></li>
										<li><strong>Deployed SHA</strong><span>The commit a preview is serving</span></li>
										<li><strong>URL, health, expiry</strong><span class="soon-tag">Soon</span></li>
									} else {
										<li><strong>Status</strong><span>Waiting, queued, running and outcome</span></li>
										<li><strong>Requested SHA</strong><span>The exact commit captured for work</span></li>
										<li><strong>Live logs</strong><span class="soon-tag">Soon</span></li>
									}
								</ul>
								<a class="text-link" href="/repositories">
									Browse repositories
									@components.Arrow()
								</a>
							</div>
						} else {
							<table class="pr-table activity-table">
								<thead>
									<tr>
										<th>Repository / PR</th>
										<th>Status</th>
										<th>Latest SHA</th>
										<th>
											if p.Environments {
												Deployed SHA
											} else {
												Requested SHA
											}
										</th>
									</tr>
								</thead>
								<tbody>
									for _,row:=range p.Rows {
										<tr>
											<td class="pr-cell-main">
												<div class="pr-cell-wrap">
													<span class={ "pr-state-icon", Tone(row.State) } aria-hidden="true">
														if p.Environments {
															@components.EnvironmentIcon()
														} else {
															@components.BuildIcon()
														}
													</span>
													<div class="pr-cell-text">
														<a href={ PRURL(row.RepoID, row.Number) }>{ row.Name } · #{ strconv.Itoa(int(row.Number)) }</a>
														if !row.Available {
															<small>Access unavailable</small>
														}
													</div>
												</div>
											</td>
											<td class="pr-cell-state" data-label="Status">
												<span class={ "badge", Tone(row.State) }><span class="badge-dot" aria-hidden="true"></span>{ Label(row.State) }</span>
												if !p.Environments&&row.State=="pending" {
													<small>
														Eligible: { row.Deadline }
													</small>
												}
											</td>
											<td class="pr-cell-sha" data-label="Latest"><code class="sha">{ Short(row.Latest) }</code></td>
											<td
												class="pr-cell-sha"
												if p.Environments {
													data-label="Deployed"
												} else {
													data-label="Requested"
												}
											>
												if p.Environments {
													<code class="sha">{ Short(row.Deployed) }</code>
												} else {
													<code class="sha">{ Short(row.Requested) }</code>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						}
					</div>
					<footer class="repository-pagination">
						<p>
							{ strconv.FormatInt(p.Total,10) } records · Page { strconv.FormatInt(p.Number,10) } of { strconv.FormatInt(p.Pages,10) }
						</p>
						<nav aria-label={ title + " pages" } class="pager">
							if p.Number>1 {
								<a href={ templ.SafeURL(p.PageURL(p.Number - 1)) } rel="prev">
									@components.ArrowLeft()
									Previous
								</a>
							}
							if p.Number<p.Pages {
								<a href={ templ.SafeURL(p.PageURL(p.Number + 1)) } rel="next">
									Next
									@components.Arrow()
								</a>
							}
						</nav>
					</footer>
				</div>
			</section>
		</div>
	}
}
