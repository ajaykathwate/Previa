package pullrequests

import (
	"strconv"
	"strings"
)
import "github.com/ajaykathwatee/previa/web/components"
import "github.com/ajaykathwatee/previa/web/components/button"
import "github.com/ajaykathwatee/previa/web/layouts"

templ Index(username, csrf string, p Page) {
	@layouts.AppTrail(p.DocumentTitle(), p.TrailParent(), p.TrailCurrent(), username, csrf, components.NavRepositories) {
		<div class="repository-workspace">
			<p class="repository-search-feedback" data-detail-feedback role="status" aria-live="polite"></p>
			<section id="repository-detail" class="repository-page" aria-label="Repository details" hx-sync="this:replace" hx-request='{"timeout":10000}'>
				@Panel(p, csrf)
			</section>
			if p.LiveURL != "" {
				// Server-sent change signals refetch the panel through the ordinary
				// GET handler; ui.js keeps the stream and defers refreshes while
				// filters are focused or a confirmation is open.
				<div hidden data-live-events={ components.PublicURL(ctx, p.LiveURL) } data-live-refresh hx-get={ components.PublicURL(ctx, p.CurrentURL()) } hx-trigger="live-update from:body" hx-target="#repository-detail" hx-sync="#repository-detail:drop"></div>
			}
		</div>
	}
}

templ Panel(p Page, csrf string) {
	<div class="pr-workspace" data-selected-repo={ components.PublicValue(ctx, "repository", p.RepoID) }>
		if p.SelectedPR!=nil {
			@prHero(p, p.Selected())
			@components.PullRequestTabs(p.RepoID, p.Selected().Number, "preview", p.Selected().OpenFindings)
			@PRDetail(p, p.Selected(), csrf)
		} else {
			@repositoryHero(p, csrf)
			@components.RepositoryTabs(p.RepoID, "pull-requests")
			if p.Available && p.DiscoveryEnabled && p.WorkerMissing {
				<p class="connection-notice tone-warn" role="status" data-worker-missing>
					@components.AlertIcon()
					<span>
						<strong>No worker is running</strong> (or it runs without the GitHub App). Syncs, mergeability checks and builds wait until one starts: run <code>make run-worker</code> during development, and check its log if it stops. Waiting work then continues by itself.
					</span>
				</p>
			} else if p.SyncStale {
				<p class="connection-notice tone-danger" role="status" data-sync-stalled>
					@components.AlertIcon()
					<span>
						<strong>This sync did not finish within 5 minutes.</strong> Choose Sync Pull Requests to start it again. If it stalls again, check the worker's log.
					</span>
				</p>
			}
			<p class={ "policy-hint", templ.KV("is-automatic", p.Mode == "automatic") }>
				<span class="policy-hint-icon" aria-hidden="true">
					if p.Mode=="automatic" {
						@components.BuildIcon()
					} else {
						@components.InfoIcon()
					}
				</span>
				if p.Mode=="automatic" {
					<span><strong>Automatic mode.</strong> New commits on open pull requests schedule work after five quiet minutes. Existing pull requests are not bulk-built.</span>
				} else {
					<span><strong>Manual mode.</strong> Pull request events update tracking only. Nothing builds without an explicit request.</span>
				}
			</p>
			<section class="workspace-panel repository-browser" aria-label="Pull request browser">
				<form id="pull-request-filters" method="get" action={ components.PublicURL(ctx, RepoURL(p.RepoID)) } class="repository-toolbar" role="search" hx-get={ components.PublicURL(ctx, RepoURL(p.RepoID)) } hx-trigger="submit, input delay:300ms from:#pull-request-search, change from:.pr-state-option" hx-target="#pull-request-results" hx-sync="#repository-detail:replace" hx-replace-url="true" hx-request='{"timeout":10000}' data-repository-search="pull requests">
					@ContextFields(p)
					<div class="repository-search search-field">
						<label for="pull-request-search" class="sr-only">Find a pull request</label>
						<span class="search-field-icon">
							@components.SearchIcon()
						</span>
						<input id="pull-request-search" type="search" name="pr_q" value={ p.Search } maxlength="100" placeholder="Search title, number, author or branch" autocomplete="off"/>
					</div>
					<fieldset class="repository-access">
						<legend class="sr-only">State</legend>
						<div class="repository-access-tabs segmented">
							for _,state:=range []string{"open","closed","merged","all"} {
								<label><input class="sr-only pr-state-option" type="radio" name="pr_state" value={ state } checked?={ p.State==state }/><span>{ Label(state) }</span></label>
							}
						</div>
					</fieldset>
					<noscript><button type="submit" class="text-link">Apply filters</button></noscript>
					<p class="repository-search-feedback" data-repository-feedback role="status" aria-live="polite"></p>
				</form>
				<div id="pull-request-results" class="repository-results">
					@Results(p)
				</div>
			</section>
			if components.CanManage(ctx) {
				@components.ConfirmationDialog("build-policy", "Enable automatic builds?", "Future PR updates will schedule work after five quiet minutes. Existing PRs are not bulk-built.") {
					@PolicyForm(p, csrf, true)
				}
				@PreviewAccessDialog(p, csrf)
				<noscript>
					<section class="workspace-panel pr-policy-fallback">
						<h3>Automatic builds</h3>
						<p>Automatic applies only to future events. Manual cancels unstarted automatic requests.</p>
						@PolicyForm(p, csrf, false)
					</section>
				</noscript>
			}
		}
	</div>
}

// repositoryHero heads a repository's pull request list: its name, when it
// last synced, its build mode and the sync and Automatic controls.
templ repositoryHero(p Page, csrf string) {
	<header class="page-hero pr-panel-heading">
		<div class="page-hero-main">
			<span class="page-hero-icon" aria-hidden="true">
				@components.RepositoryIcon()
			</span>
			<div class="page-hero-text">
				<p class="page-hero-kicker">{ p.Owner() }</p>
				<h1 tabindex="-1" data-detail-heading title={ p.Name }>{ p.RepositoryName() }</h1>
				<p class="pr-summary page-hero-meta" role="status">
					<span class="pr-summary-item">
						@components.ClockIcon()
						<span>
							Last synced{ " " }
							if p.LastRefresh!="" {
								@components.Time(p.LastRefresh, TimeLabel(p.LastRefresh))
							} else {
								<span>never</span>
							}
						</span>
					</span>
					<span class={ "pr-summary-item", "pr-mode", templ.KV("is-automatic", p.Mode == "automatic") }>
						@components.BuildIcon()
						<span>{ Label(p.Mode) } builds</span>
					</span>
					if !p.Available {
						<span class="sync-state tone-neutral">Repository unavailable</span>
					} else if !p.DiscoveryEnabled {
						<span class="sync-state tone-neutral">Sync not configured</span>
					}
					if p.Syncing() && p.WorkerMissing {
						<span class="sync-state tone-warn" title="No worker is running to fetch pull requests from GitHub.">Waiting for a worker</span>
					} else if p.Syncing() && p.SyncStale {
						<span class="sync-state tone-danger" title="This sync did not finish in time. Sync Pull Requests starts it again.">Sync stalled</span>
					} else if p.Syncing() {
						<span class="sync-state tone-info is-syncing" data-refresh-at={ p.SyncStaleAt }>Syncing</span>
					} else if p.SyncState=="failed" {
						<span class="sync-state sync-failed tone-danger" title={ p.SyncMessage }>Sync failed</span>
					}
					@liveIndicator()
				</p>
			</div>
		</div>
		<div class="pr-header-actions page-hero-actions">
			<form method="post" action={ components.PublicURL(ctx, RepoURL(p.RepoID)+"/refresh") } hx-post={ components.PublicURL(ctx, RepoURL(p.RepoID)+"/refresh") } hx-target="#repository-detail" hx-sync="#repository-detail:replace">
				<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="workspace_query" value={ components.PublicQuery(ctx, p.RepoID, p.Query()) }/>
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Class: "sync-button", Disabled: p.SyncDisabled()}) {
					@components.SyncIcon()
					Sync Pull Requests
				}
			</form>
			if components.CanManage(ctx) {
				@AutomaticSwitch(p, csrf)
				<button type="button" role="switch" aria-checked={ strconv.FormatBool(p.PrivatePreviews) } class="automatic-switch" disabled?={ !p.Available || (!p.PrivatePreviews && !p.PrivatePreviewsReady) } data-open-dialog="preview-access" commandfor="preview-access" command="show-modal" aria-haspopup="dialog" aria-describedby={ privateSetupDescription(p) } title={ privateTitle(p.PrivatePreviews) }><span>Private previews</span><span class="switch-track" aria-hidden="true"><span></span></span></button>
			}
		</div>
	</header>
	if !p.PrivatePreviewsReady || p.PrivatePreviewUnavailable {
		<p id="private-preview-setup" class="tone-warning">
			Private previews need authentication configured on all routing workers. Ask the operator to set PREVIEW_ACCESS_URL and restart the workers.
			if p.PrivatePreviews {
				Existing previews remain private and may be unavailable until configuration is restored.
			}
		</p>
	}
}

func privateTitle(private bool) string {
	if private {
		return "Previews are private: visitors sign in with GitHub and need workspace preview access or GitHub repository permission."
	}
	return "Previews are public: anyone with a preview's address can open it."
}

func privateSetupDescription(p Page) string {
	if !p.PrivatePreviewsReady || p.PrivatePreviewUnavailable {
		return "private-preview-setup"
	}
	return ""
}

// PreviewAccessDialog confirms making the repository's previews private or
// public again.
templ PreviewAccessDialog(p Page, csrf string) {
	if p.PrivatePreviews {
		@components.ConfirmationDialog("preview-access", "Make previews public?", "Anyone with a preview's address will be able to open it again, without signing in.") {
			@previewAccessForm(p, csrf, "Make public")
		}
	} else if p.PrivatePreviewsReady {
		@components.ConfirmationDialog("preview-access", "Make previews private?", "Visitors sign in with GitHub. Workspace members need a repository grant; GitHub-readable outsiders can also open the preview. Removing a member or grant ends their access immediately.") {
			@previewAccessForm(p, csrf, "Make private")
		}
	}
}

templ previewAccessForm(p Page, csrf, label string) {
	<form method="post" action={ components.PublicURL(ctx, RepoURL(p.RepoID)+"/preview-access") } class="dialog-actions">
		<input type="hidden" name="csrf_token" value={ csrf }/>
		<input type="hidden" name="private" value={ strconv.FormatBool(!p.PrivatePreviews) }/>
		@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{"autofocus": true, "commandfor": "preview-access", "command": "close", "data-close-dialog": true}}) {
			Cancel
		}
		@button.Button(button.Props{Type: button.TypeSubmit, Disabled: !p.PrivatePreviews && !p.PrivatePreviewsReady}) {
			{ label }
		}
	</form>
}

// prHero heads a pull request page: where it lives, its title and who opened
// it from which branch, with a link to it on GitHub.
templ prHero(p Page, pr PR) {
	<header class="page-hero pr-panel-heading pr-hero">
		<div class="page-hero-main">
			<span class={ "page-hero-icon", "pr-hero-icon", Tone(pr.State) } aria-hidden="true">
				if pr.State=="merged" {
					@components.MergeIcon()
				} else {
					@components.PullRequestIcon()
				}
			</span>
			<div class="page-hero-text">
				<p class="page-hero-kicker">
					<span>{ p.Name }</span>
					<span class="page-hero-kicker-sep" aria-hidden="true">·</span>
					<span>#{ strconv.Itoa(int(pr.Number)) }</span>
				</p>
				<h1 tabindex="-1" data-detail-heading class="pr-hero-title">{ pr.Title }</h1>
				<div class="page-hero-meta pr-meta">
					<span class={ "badge", Tone(pr.State) }><span class="badge-dot" aria-hidden="true"></span>{ Label(pr.State) }</span>
					if pr.Author!="" {
						<span class="pr-meta-item"><span class="user-avatar user-avatar-sm" aria-hidden="true">{ components.Initial(pr.Author) }</span>{ pr.Author }</span>
					}
					if pr.Branch!="" {
						<code class="branch-chip">
							@components.BranchIcon()
							{ pr.Branch }
						</code>
					}
					if pr.Fork && p.Mode == "automatic" {
						<span class="badge tone-warn" title="Automatic builds never start a fork's pull request, and forks never receive repository secrets. Choose Build latest commit to build this commit.">Fork · waits for your approval</span>
					} else if pr.Fork {
						<span class="badge tone-warn" title="Pull requests from forks never receive repository secrets.">Fork · no secrets</span>
					}
					<span class={ "pr-meta-item", "pr-mode", templ.KV("is-automatic", p.Mode == "automatic") }>
						@components.BuildIcon()
						{ Label(p.Mode) } builds
					</span>
					@liveIndicator()
				</div>
			</div>
		</div>
		if pr.GitHubURL() != "" {
			<div class="page-hero-actions">
				<a class="hero-link github-link" href={ components.PublicURL(ctx, pr.GitHubURL()) } target="_blank" rel="noopener noreferrer">
					@components.GitHubMark()
					View on GitHub
					@components.ArrowUpRight()
				</a>
			</div>
		}
	</header>
}

// liveIndicator shows the page's live-update connection; ui.js sets its state
// on <html> only when a stream exists, so it stays hidden otherwise.
templ liveIndicator() {
	<span class="live-indicator" aria-hidden="true"><span class="live-dot"></span><span class="live-label-live">Live updates</span><span class="live-label-reconnecting">Reconnecting</span><span class="live-label-offline">Live updates paused · reload to resume</span></span>
}

templ AutomaticSwitch(p Page, csrf string) {
	if p.Mode=="automatic" {
		<form method="post" action={ components.PublicURL(ctx, RepoURL(p.RepoID)+"/policy") } hx-post={ components.PublicURL(ctx, RepoURL(p.RepoID)+"/policy") } hx-target="#repository-detail" hx-sync="#repository-detail:replace" hx-disabled-elt="find button">
			<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="workspace_query" value={ components.PublicQuery(ctx, p.RepoID, p.Query()) }/><input type="hidden" name="mode" value="manual"/>
			<button type="submit" role="switch" aria-checked="true" class="automatic-switch" disabled?={ !p.Available } title="Automatic builds are on. Turn them off to build only on request."><span>Automatic builds</span><span class="switch-track" aria-hidden="true"><span></span></span></button>
		</form>
	} else {
		<button type="button" role="switch" aria-checked="false" class="automatic-switch" disabled?={ !p.Available } data-open-dialog="build-policy" commandfor="build-policy" command="show-modal" aria-haspopup="dialog" title="Automatic builds are off: nothing builds until you ask."><span>Automatic builds</span><span class="switch-track" aria-hidden="true"><span></span></span></button>
	}
}

templ ContextFields(p Page) {
	for key,value:=range p.DirectoryFilters() {
		<input type="hidden" name={ key } value={ value }/>
	}
}

templ PolicyForm(p Page, csrf string, modal bool) {
	<form method="post" action={ components.PublicURL(ctx, RepoURL(p.RepoID)+"/policy") } class="dialog-actions" hx-disabled-elt="find button[type=submit]" hx-post={ components.PublicURL(ctx, RepoURL(p.RepoID)+"/policy") } hx-target="#repository-detail" hx-sync="#repository-detail:replace">
		<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="workspace_query" value={ components.PublicQuery(ctx, p.RepoID, p.Query()) }/>
		<p class="repository-search-feedback" data-policy-feedback role="status" aria-live="polite"></p>
		<input type="hidden" name="mode" value={ p.PolicyMode(modal) }/>
		if modal {
			@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-close-dialog": true, "commandfor": "build-policy", "command": "close"}}) {
				Cancel
			}
		}
		@button.Button(button.Props{Type: button.TypeSubmit, Disabled: !p.Available}) {
			{ p.PolicyAction(modal) }
		}
	</form>
}

templ Results(p Page) {
	<div class="repository-table-scroll" tabindex="0" role="region" aria-label="Pull request list">
		if len(p.Rows)==0 {
			<div class="repository-empty">
				<span class="empty-source-icon" aria-hidden="true">
					@components.PullRequestIcon()
				</span>
				if p.LastRefresh=="" && p.Search=="" && p.Total==0 && p.Available && p.DiscoveryEnabled {
					<h3>No pull requests found yet</h3>
					<p>Previa has not looked for this repository's open pull requests yet. Sync once; after that, GitHub keeps the list current.</p>
					<form method="post" action={ components.PublicURL(ctx, RepoURL(p.RepoID)+"/refresh") } hx-post={ components.PublicURL(ctx, RepoURL(p.RepoID)+"/refresh") } hx-target="#repository-detail" hx-sync="#repository-detail:replace">
						<input type="hidden" name="csrf_token" value={ p.CSRF }/><input type="hidden" name="workspace_query" value={ components.PublicQuery(ctx, p.RepoID, p.Query()) }/>
						@button.Button(button.Props{Type: button.TypeSubmit, Disabled: p.SyncState == "queued" || p.SyncState == "syncing"}) {
							@components.SyncIcon()
							Sync Pull Requests
						}
					</form>
				} else {
					<h3>No pull requests in this view</h3>
					<p>Try another state or search. Sync Pull Requests refreshes what Previa knows from GitHub.</p>
				}
			</div>
		} else {
			<table class="pr-table pr-list">
				<thead>
					<tr>
						<th>Pull request</th>
						<th>Commit</th>
						<th>State</th>
						<th>Preview</th>
						<th><span class="sr-only">Open</span></th>
					</tr>
				</thead>
				<tbody>
					for _,pr:=range p.Rows {
						<tr>
							<td class="pr-cell-main">
								<div class="pr-cell-wrap">
									<span class={ "pr-state-icon", Tone(pr.State) } aria-hidden="true">
										if pr.State == "merged" {
											@components.MergeIcon()
										} else {
											@components.PullRequestIcon()
										}
									</span>
									<div class="pr-cell-text">
										<a href={ components.PublicURL(ctx, p.DetailURL(pr.Number)) }><span class="pr-number">#{ strconv.Itoa(int(pr.Number)) }</span> { pr.Title }</a>
										<small>
											if pr.Author != "" {
												<span class="pr-row-author"><span class="user-avatar user-avatar-xs" aria-hidden="true">{ components.Initial(pr.Author) }</span>{ pr.Author }</span>
											}
											if pr.Branch != "" {
												<code class="branch-chip">
													@components.BranchIcon()
													{ pr.Branch }
												</code>
											}
											if pr.UpdatedAt != "" {
												<span class="pr-row-updated">
													Updated { " " }
													@components.Time(pr.UpdatedAt, TimeLabel(pr.UpdatedAt))
												</span>
											}
											if pr.Fork && p.Mode == "automatic" {
												<span class="meta-flag" title="Automatic builds never start a fork's pull request; build it from its page.">Fork · needs your approval</span>
											} else if pr.Fork {
												<span class="meta-flag">Fork</span>
											}
											if pr.NeedsRefresh {
												<span class="meta-flag tone-warn">Refresh required</span>
											}
										</small>
									</div>
								</div>
							</td>
							<td class="pr-cell-sha" data-label="Commit">
								if href := pr.CommitURL(pr.SHA); href != "" {
									<a class="sha sha-link" href={ components.PublicURL(ctx, href) } target="_blank" rel="noopener noreferrer" title={ "Open commit " + pr.SHA + " on GitHub" }>
										@components.CommitIcon()
										{ Short(pr.SHA) }
									</a>
								} else {
									<code class="sha" title={ pr.SHA }>
										@components.CommitIcon()
										{ Short(pr.SHA) }
									</code>
								}
							</td>
							<td class="pr-cell-state" data-label="State">
								<span class={ "repository-status", "badge", Tone(pr.State) }><span class="badge-dot" aria-hidden="true"></span>{ Label(pr.State) }</span>
								if pr.MergeUnknown {
									<small>GitHub did not answer; sync to ask again</small>
								} else if pr.State=="checking" && pr.NoWorker {
									<small>Waiting for a worker</small>
								}
							</td>
							<td class="pr-cell-build pr-cell-url" data-label="Preview">
								@previewCell(p.RepoID, pr)
							</td>
							<td class="pr-cell-go" aria-hidden="true">
								@components.Arrow()
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
	<footer class="repository-pagination">
		<p role="status" aria-live="polite">
			{ strconv.FormatInt(p.Total,10) }
			if p.Total == 1 {
				pull request
			} else {
				pull requests
			}
			· Page { strconv.FormatInt(p.Number,10) } of { strconv.FormatInt(p.Pages,10) }
		</p>
		<nav aria-label="Pull request pages" class="pager">
			if p.Number>1 {
				<a href={ components.PublicURL(ctx, p.PageURL(p.Number-1)) } hx-get={ components.PublicURL(ctx, p.PageURL(p.Number-1)) } hx-target="#pull-request-results" hx-sync="#repository-detail:replace" hx-push-url="true" rel="prev">
					@components.ArrowLeft()
					Previous
				</a>
			}
			if p.Number<p.Pages {
				<a href={ components.PublicURL(ctx, p.PageURL(p.Number+1)) } hx-get={ components.PublicURL(ctx, p.PageURL(p.Number+1)) } hx-target="#pull-request-results" hx-sync="#repository-detail:replace" hx-push-url="true" rel="next">
					Next
					@components.Arrow()
				</a>
			}
		</nav>
	</footer>
}

templ PRDetail(p Page, pr PR, csrf string) {
	{{ diagnosis := pr.Diagnosis() }}
	{{ progress, tracked := pr.Progress() }}
	<div class="pr-detail-content">
		<div class="pr-layout">
			<div class="pr-main">
				<section class={ "workspace-panel", "pr-status", pr.Headline.Tone, templ.KV("is-active", progress.Active) } aria-labelledby="pr-status-title" data-pr-status>
					<div class="pr-status-main">
						<span class="pr-status-icon" aria-hidden="true">
							@statusIcon(pr, progress)
						</span>
						<div class="pr-status-text">
							if diagnosis.Title != "" && pr.Headline.Tone == "tone-danger" {
								<p class="pr-status-kicker"><span class="badge tone-danger"><span class="badge-dot" aria-hidden="true"></span>{ pr.Headline.Title }</span></p>
								<h2 id="pr-status-title">{ diagnosis.Title }</h2>
								<p>{ diagnosis.Summary }</p>
							} else {
								<h2 id="pr-status-title">{ pr.Headline.Title }</h2>
								if pr.Headline.Detail!="" {
									<p>{ pr.Headline.Detail }</p>
								}
							}
						</div>
						if progress.Active && progress.Since != "" {
							<p class="pr-status-clock" title="Time since the build started">
								@components.ClockIcon()
								<time datetime={ progress.Since } data-elapsed>{ TimeLabel(progress.Since) }</time>
							</p>
						}
					</div>
					if tracked {
						if progress.Active {
							@Tracker(progress, LogsURL(p.RepoID, pr.Number)+"/events")
						} else {
							@Tracker(progress, "")
						}
					}
					if diagnosis.Title != "" {
						@diagnosisCard(p, pr, diagnosis)
					}
					if pr.Live() {
						<div class="pr-status-preview">
							@components.LinkIcon()
							<a class="preview-address" href={ components.PublicURL(ctx, pr.PreviewURL) } target="_blank" rel="noopener noreferrer" data-preview-url>{ pr.PreviewURL }</a>
							@components.CopyButton(pr.PreviewURL, "Copy the preview address")
						</div>
					}
					<div class="pr-detail-actions">
						if pr.Live() {
							@button.Button(button.Props{Href: PreviewHref(ctx, p.RepoID, pr.Number, pr.PreviewURL), Target: "_blank", Attributes: templ.Attributes{"rel": "noopener noreferrer"}}) {
								Open preview
								@components.ArrowUpRight()
							}
						}
						if pr.Actions.HasBuildAction() {
							<form method="post" action={ components.PublicURL(ctx, PRURL(p.RepoID, pr.Number)+"/build") } hx-post={ components.PublicURL(ctx, PRURL(p.RepoID, pr.Number)+"/build") } hx-target="#repository-detail" hx-sync="#repository-detail:replace" hx-disabled-elt="find button" class="build-form">
								<input type="hidden" name="csrf_token" value={ csrf }/>
								<input type="hidden" name="workspace_query" value={ components.PublicQuery(ctx, p.RepoID, p.Query()) }/>
								<input type="hidden" name="expected_revision" value={ strconv.FormatInt(pr.Actions.ExpectedRevision, 10) }/>
								<input type="hidden" name="request_key" value={ pr.Actions.RequestKey }/>
								if pr.Actions.Retry {
									<input type="hidden" name="action" value="retry"/>
									@button.Button(button.Props{Type: button.TypeSubmit, Variant: secondaryWhen(pr.Live()), Class: "busy-button"}) {
										@buildButtonIcon(components.RestartIcon())
										<span class="busy-text">Retry build</span>
										<span class="busy-label">Starting…</span>
									}
								} else if pr.Actions.Rebuild {
									<input type="hidden" name="action" value="rebuild"/>
									@button.Button(button.Props{Type: button.TypeSubmit, Variant: secondaryWhen(pr.Live()), Class: "busy-button"}) {
										@buildButtonIcon(components.BuildIcon())
										<span class="busy-text">Rebuild preview</span>
										<span class="busy-label">Starting…</span>
									}
								} else {
									<input type="hidden" name="action" value="build"/>
									@button.Button(button.Props{Type: button.TypeSubmit, Variant: secondaryWhen(pr.Live()), Class: "busy-button"}) {
										@buildButtonIcon(components.BuildIcon())
										<span class="busy-text">
											if pr.Actions.BuildNow {
												Build now
											} else {
												Build latest commit
											}
										</span>
										<span class="busy-label">Starting…</span>
									}
								}
							</form>
						} else if pr.Actions.InProgress != "" {
							@button.Button(button.Props{Disabled: true, Variant: secondaryWhen(pr.Live())}) {
								@components.BuildIcon()
								{ pr.Actions.InProgress }
							}
						} else if pr.Actions.Blocked!="" {
							@button.Button(button.Props{Disabled: true, Variant: secondaryWhen(pr.Live()), Attributes: templ.Attributes{"aria-describedby": "build-unavailable"}}) {
								@components.BuildIcon()
								{ pr.Actions.Blocked }
							}
						}
						if pr.Actions.Teardown {
							@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-open-dialog": "teardown-preview", "commandfor": "teardown-preview", "command": "show-modal", "aria-haspopup": "dialog"}}) {
								{ pr.Actions.TeardownLabel() }
							}
						}
						<a class="text-link logs-link" data-open-pr-logs href={ components.PublicURL(ctx, LogsURL(p.RepoID, pr.Number)) }>
							@components.LogsIcon()
							if progress.Active {
								Follow the build log
							} else {
								Build logs
							}
						</a>
						if pr.Running() {
							<a class="text-link logs-link" href={ components.PublicURL(ctx, OutputURL(p.RepoID, pr.Number)) }>
								@components.ServerIcon()
								App output
							</a>
						}
					</div>
					if pr.Actions.Unavailable!="" {
						<div
							id="build-unavailable"
							if pr.Actions.Blocked!="" {
								class="connection-notice tone-warn pr-blocked"
							} else {
								class="connection-notice tone-neutral pr-blocked"
							}
							role="status"
							data-build-unavailable
						>
							@components.AlertIcon()
							<div>
								<strong>{ pr.Actions.Unavailable }</strong>
								if pr.Actions.Hint!="" {
									<span>{ pr.Actions.Hint }</span>
								}
							</div>
						</div>
					}
				</section>
				@prDescription(pr)
				<details class="pr-recent-logs" data-pr-logs data-pr-logs-url={ components.PublicURL(ctx, LogsURL(p.RepoID, pr.Number)+"/recent") }>
					<summary>Recent build logs <span>Latest 300 events</span></summary>
					<div id="pr-recent-log-content">
						<p class="log-empty"><a class="text-link" href={ components.PublicURL(ctx, LogsURL(p.RepoID, pr.Number)) }>View full build logs</a></p>
					</div>
				</details>
			</div>
			<aside class="workspace-panel pr-details" aria-labelledby="pr-details-title">
				<h2 id="pr-details-title" class="pr-details-title">Details</h2>
				<div class="pr-detail-grid lifecycle" role="list" aria-label="Commit lifecycle">
					<section class="lifecycle-step" role="listitem" aria-labelledby="lifecycle-commit">
						<h3 id="lifecycle-commit">
							@components.CommitIcon()
							Latest commit
						</h3>
						<div class="lifecycle-row">
							@commitChip(pr, pr.SHA, false)
							<span class={ "badge", Tone(pr.State) }><span class="badge-dot" aria-hidden="true"></span>{ Gate(pr.State) }</span>
						</div>
						@commitMessage(pr)
					</section>
					<section class={ "lifecycle-step", templ.KV("is-current", progress.Active) } role="listitem" aria-labelledby="lifecycle-request">
						<h3 id="lifecycle-request">
							@components.BuildIcon()
							Build request
						</h3>
						if pr.RequestedSHA=="" {
							<p class="lifecycle-empty">No build requested yet.</p>
						} else {
							<div class="lifecycle-row">
								@commitChip(pr, pr.RequestedSHA, false)
								if pr.Waiting!="" {
									<span class="badge tone-info"><span class="badge-dot" aria-hidden="true"></span>{ pr.Waiting }</span>
								} else {
									<span class={ "badge", Tone(pr.Build) }><span class="badge-dot" aria-hidden="true"></span>{ Label(pr.Build) }</span>
								}
							</div>
							<ul class="lifecycle-facts">
								if pr.RequestSource=="automatic" {
									<li>
										Automatic build · { " " }
										@components.Time(pr.RequestedAt, TimeLabel(pr.RequestedAt))
									</li>
								} else if pr.RequestedBy!="" {
									<li>
										Requested by { pr.RequestedBy } · { " " }
										@components.Time(pr.RequestedAt, TimeLabel(pr.RequestedAt))
									</li>
								}
								if pr.Build=="running" && pr.StartedAt!="" {
									<li>
										Started { " " }
										@components.Time(pr.StartedAt, TimeLabel(pr.StartedAt))
									</li>
								}
								if pr.CompletedAt!="" && (pr.Build=="succeeded" || pr.Build=="failed") {
									<li>
										Finished { " " }
										@components.Time(pr.CompletedAt, TimeLabel(pr.CompletedAt))
										if took := Took(pr.StartedAt, pr.CompletedAt); took!="" {
											{ " · took " + took }
										}
									</li>
								}
							</ul>
							if !pr.RequestCurrent {
								<p class="lifecycle-note tone-warn">This request was for an earlier commit than the latest one.</p>
							}
							if pr.Build=="superseded" && pr.RequestCurrent {
								<p class="lifecycle-note">Replaced by a teardown or a newer request before it finished.</p>
							}
							if pr.Waiting!="" {
								<p class="lifecycle-note">{ pr.WaitingNote }</p>
							} else if pr.Deadline!="" && pr.Build=="pending" {
								<p class="lifecycle-note">
									Eligible { " " }
									@components.Time(pr.Deadline, TimeLabel(pr.Deadline))
								</p>
							}
							if pr.Failure!="" {
								<p class="lifecycle-note tone-danger" data-failure>{ diagnosis.Title }.</p>
							}
						}
					</section>
					<section class="lifecycle-step" role="listitem" aria-labelledby="lifecycle-preview">
						<h3 id="lifecycle-preview">
							@components.EnvironmentIcon()
							Deployed preview
						</h3>
						if pr.DeployedSHA=="" {
							<div class="lifecycle-row">
								<span class="lifecycle-empty">Nothing deployed.</span>
								<span class={ "badge", Tone(pr.Environment) }><span class="badge-dot" aria-hidden="true"></span>{ Label(pr.Environment) }</span>
							</div>
						} else {
							<div class="lifecycle-row">
								@commitChip(pr, pr.DeployedSHA, false)
								<span class={ "badge", Tone(pr.Environment) }><span class="badge-dot" aria-hidden="true"></span>{ Label(pr.Environment) }</span>
							</div>
							<ul class="lifecycle-facts">
								if pr.PublishedAt!="" {
									<li>
										Published { " " }
										@components.Time(pr.PublishedAt, TimeLabel(pr.PublishedAt))
									</li>
								}
								if pr.AsleepAt!="" {
									<li>
										Asleep since { " " }
										@components.Time(pr.AsleepAt, TimeLabel(pr.AsleepAt))
										{ " · the next visit wakes it in a few seconds" }
									</li>
								}
								if pr.LastOpenedAt!="" {
									<li>
										Last opened { " " }
										@components.Time(pr.LastOpenedAt, TimeLabel(pr.LastOpenedAt))
										{ " · " + RequestCount(pr.Requests) }
									</li>
								}
								if pr.ExpiresAt!="" {
									<li>
										Expires { " " }
										@components.Time(pr.ExpiresAt, TimeLabel(pr.ExpiresAt))
									</li>
								}
							</ul>
							if pr.OlderPreview {
								<p class="lifecycle-note tone-warn">This preview serves an earlier commit than the latest one.</p>
							}
						}
						if pr.RemovedNote!="" {
							<p class="lifecycle-note">{ pr.RemovedNote }</p>
						}
					</section>
				</div>
				<section class="lifecycle-step" aria-labelledby="lifecycle-services">
					<h3 id="lifecycle-services">
						@components.ServerIcon()
						Environment
					</h3>
					@backendFacts(pr)
				</section>
			</aside>
		</div>
		if pr.Actions.Teardown {
			@components.ConfirmationDialog("teardown-preview", teardownTitle(pr.Actions), teardownText(pr.Actions)) {
				<form method="post" action={ components.PublicURL(ctx, PRURL(p.RepoID, pr.Number)+"/teardown") } class="dialog-actions" hx-post={ components.PublicURL(ctx, PRURL(p.RepoID, pr.Number)+"/teardown") } hx-target="#repository-detail" hx-sync="#repository-detail:replace" hx-disabled-elt="find button[type=submit]">
					<input type="hidden" name="csrf_token" value={ csrf }/>
					<input type="hidden" name="workspace_query" value={ components.PublicQuery(ctx, p.RepoID, p.Query()) }/>
					<p class="repository-search-feedback" data-dialog-feedback role="status" aria-live="polite"></p>
					@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{"autofocus": true, "data-close-dialog": true, "commandfor": "teardown-preview", "command": "close"}}) {
						Cancel
					}
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
						{ pr.Actions.TeardownLabel() }
					}
				</form>
			}
		}
	</div>
}

// previewCell is a list row's delivery status: the live preview with its
// address first, otherwise where the latest build request stands.
templ previewCell(repoID int64, pr PR) {
	if pr.PreviewURL != "" {
		<span class="delivery tone-ok">
			<span class="delivery-icon" aria-hidden="true">
				@components.EnvironmentIcon()
			</span>
			Live
		</span>
		<a class="delivery-open" href={ components.PublicURL(ctx, PreviewHref(ctx, repoID, pr.Number, pr.PreviewURL)) } target="_blank" rel="noopener noreferrer" title={ pr.PreviewURL } aria-label={ "Open the preview of #" + strconv.Itoa(int(pr.Number)) }>
			Open
			@components.ArrowUpRight()
		</a>
		switch  {
			case pr.Build == "failed":
				<small class="tone-danger-text">Latest build failed</small>
			case pr.Build == "running" || pr.Build == "queued" || pr.Build == "pending":
				<small>Newer build { Label(pr.Build) }</small>
			case pr.OlderPreview:
				<small class="tone-warn-text">On an earlier commit</small>
		}
	} else if pr.Build == "Not requested" || pr.Build == "" {
		<span class="delivery delivery-none">
			<span class="delivery-icon" aria-hidden="true">
				@components.BuildIcon()
			</span>
			Not built yet
		</span>
	} else {
		<span class={ "delivery", Tone(pr.Build) }>
			<span class="delivery-icon" aria-hidden="true">
				switch pr.Build {
					case "failed":
						@components.XIcon()
					case "running":
						@components.SpinnerIcon()
					case "queued", "pending":
						@components.ClockIcon()
					case "succeeded":
						@components.CheckIcon()
					default:
						@components.InfoIcon()
				}
			</span>
			switch pr.Build {
				case "failed":
					Build failed
				case "running":
					Building
				default:
					{ Label(pr.Build) }
			}
		</span>
		if !pr.RequestCurrent {
			<small class="tone-warn-text">For an earlier commit</small>
		}
	}
}

// statusIcon is the status card's symbol: a spinner while work is in
// flight, otherwise one for the headline's tone.
templ statusIcon(pr PR, progress Progress) {
	switch  {
		case progress.Active || ((pr.Build == "queued" || pr.Build == "pending") && !pr.ExecutionRetrying && !pr.BuildWorkerMissing && !pr.PublicationRetrying):
			@components.SpinnerIcon()
		case pr.Headline.Tone == "tone-danger":
			@components.AlertIcon()
		case pr.Live():
			@components.EnvironmentIcon()
		case pr.Headline.Tone == "tone-ok":
			@components.CheckIcon()
		default:
			@components.InfoIcon()
	}
}

// buildButtonIcon swaps the build button's icon for a spinner while its
// request is in flight (CSS, keyed on HTMX's request class).
templ buildButtonIcon(icon templ.Component) {
	<span class="busy-icon" aria-hidden="true">
		@icon
		@components.SpinnerIcon()
	</span>
}

// Tracker shows where a build request is: queued, getting the code, building
// the image, starting, publishing, live. With events (the attempt's live log
// stream) ui.js follows the output and names the exact step; the log page
// passes none and updates it from its own stream.
templ Tracker(progress Progress, events string) {
	<div
		class={ "build-tracker", templ.KV("is-failed", progress.Failed), templ.KV("is-active", progress.Active) }
		data-build-progress
		if events != "" {
			data-progress-events={ components.PublicURL(ctx, events) }
		}
	>
		<ol class="tracker-steps" aria-label="Build progress">
			for i, stage := range progress.Stages {
				<li class={ "tracker-step", "is-" + stage.State } data-stage={ stage.Key }>
					<span class="tracker-node" aria-hidden="true">
						<span class="tracker-num">{ strconv.Itoa(i + 1) }</span>
						@components.CheckIcon()
						@components.XIcon()
					</span>
					<span class="tracker-text">
						<strong>{ stage.Label }</strong>
						<small>{ stage.Hint }</small>
					</span>
					<span class="sr-only">{ stageStatus(stage.State) }</span>
				</li>
			}
		</ol>
		if progress.Active {
			<p class="tracker-live" data-progress-line hidden>
				<span class="tracker-live-label">Now</span>
				<code data-progress-text></code>
			</p>
		}
	</div>
}

// stageStatus reads a stage's state aloud.
func stageStatus(state string) string {
	switch state {
	case "done":
		return "(done)"
	case "current":
		return "(in progress)"
	case "working":
		return "(may be in progress)"
	case "failed":
		return "(failed here)"
	default:
		return "(not started)"
	}
}

// diagnosisCard says what to do about a failed build, with the technical
// details (the stored category, the precise reason and the last output
// lines) one click away.
templ diagnosisCard(p Page, pr PR, d Diagnosis) {
	<div class="diagnosis" data-diagnosis>
		<div class="diagnosis-next">
			<h3>
				@components.WrenchIcon()
				What to do next
			</h3>
			<ol class="diagnosis-steps">
				for _, step := range d.Steps {
					<li>{ step }</li>
				}
			</ol>
			if d.Retry {
				<p class="diagnosis-retry">This is often temporary: retrying may be all it takes.</p>
			}
		</div>
		<details class="diagnosis-details">
			<summary>
				@components.ChevronDownIcon()
				Technical details
			</summary>
			<dl class="diagnosis-facts">
				if d.Reason != "" {
					<div><dt>Reason</dt><dd class="diagnosis-reason">{ d.Reason }</dd></div>
				}
				<div><dt>What Previa recorded</dt><dd>{ pr.Failure }</dd></div>
				if d.Code != "" {
					<div><dt>Failure category</dt><dd><code>{ d.Code }</code></dd></div>
				}
				if pr.RequestedSHA != "" {
					<div><dt>Commit</dt><dd><code>{ Short(pr.RequestedSHA) }</code></dd></div>
				}
			</dl>
			if len(pr.FailureLog)>0 {
				<div class="failure-log">
					<header class="failure-log-header">
						<h4>Last lines of the build output</h4>
						<a class="text-link" data-open-pr-logs href={ components.PublicURL(ctx, LogsURL(p.RepoID, pr.Number)) }>
							Show recent logs
							@components.Arrow()
						</a>
					</header>
					<ol class="failure-log-lines" aria-label="Last build output lines">
						for _, line := range pr.FailureLog {
							<li class={ templ.KV("log-error", LooksLikeError(line)) }>{ line }</li>
						}
					</ol>
				</div>
			} else {
				<a class="text-link diagnosis-log-link" data-open-pr-logs href={ components.PublicURL(ctx, LogsURL(p.RepoID, pr.Number)) }>
					Show recent logs
					@components.Arrow()
				</a>
			}
		</details>
	</div>
}

// commitChip shows a commit, linked to GitHub when the PR's address is known.
templ commitChip(pr PR, sha string, full bool) {
	if href := pr.CommitURL(sha); href!="" {
		<a
			href={ components.PublicURL(ctx, href) }
			target="_blank"
			rel="noopener noreferrer"
			title={ "Open commit " + sha + " on GitHub" }
			if full {
				class="sha sha-full sha-link"
			} else {
				class="sha sha-link"
			}
		>
			if full {
				{ sha }
			} else {
				{ Short(sha) }
			}
		</a>
	} else if full {
		<code class="sha sha-full">{ sha }</code>
	} else {
		<code class="sha" title={ sha }>{ Short(sha) }</code>
	}
}

templ ActivityIndex(username, csrf string, p Activity) {
	{{
		title := "Builds"
		nav := components.NavBuilds
		if p.Previews {
			title = "Previews"
			nav = components.NavPreviews
		}
	}}
	@layouts.App(title, username, csrf, nav) {
		<div class="repository-workspace activity-page">
			<header class="page-header workspace-page-heading">
				<div class="page-header-text">
					if p.Previews {
						@components.PageTitle(title, "What is live now: each pull request's preview, the commit it serves, its link and when it expires. Every build attempt, including ones that failed before going live, is on Builds.")
					} else {
						@components.PageTitle(title, "Each pull request's latest attempt to build a commit: waiting, building, succeeded or failed, and why. A new attempt replaces the row. What is live, and its link, is on Previews.")
					}
				</div>
				<nav class="segmented segmented-nav" aria-label="Delivery views">
					<a
						href="/builds"
						if !p.Previews {
							aria-current="page"
						}
					>
						@components.BuildIcon()
						<span>Builds</span>
					</a>
					<a
						href="/previews"
						if p.Previews {
							aria-current="page"
						}
					>
						@components.EnvironmentIcon()
						<span>Previews</span>
					</a>
				</nav>
			</header>
			<section class="workspace-panel repository-browser">
				if !p.Previews {
					@failureToolbar(csrf, p)
				}
				<div class="repository-results">
					<div class="repository-table-scroll" tabindex="0" role="region" aria-label={ title + " list" }>
						if len(p.Rows)==0 && p.Failures != "" {
							{{ heading, text := FailureEmpty(p.Failures) }}
							<div class="repository-empty activity-empty">
								<span class="empty-source-icon" aria-hidden="true">
									@components.CheckIcon()
								</span>
								<h2>{ heading }</h2>
								<p>{ text }</p>
								<a class="text-link" href={ components.PublicURL(ctx, p.FilterURL("")) }>
									All builds
									@components.Arrow()
								</a>
							</div>
						} else if len(p.Rows)==0 {
							<div class="repository-empty activity-empty">
								<span class="empty-source-icon" aria-hidden="true">
									if p.Previews {
										@components.EnvironmentIcon()
									} else {
										@components.BuildIcon()
									}
								</span>
								if p.Previews {
									<h2>No live previews.</h2>
									<p>A preview appears here when a pull request's build succeeds. Builds that failed before going live are on <a class="text-link" href="/builds">Builds</a>.</p>
								} else {
									<h2>No builds to show.</h2>
									<p>Only real saved records appear here. Connecting or discovering a repository does not start a build.</p>
								}
								<ul class="empty-explainer">
									if p.Previews {
										<li><strong>Status</strong><span>Live, updating to a newer commit, or being removed</span></li>
										<li><strong>Link</strong><span>The preview's address, the same for the pull request's whole life</span></li>
										<li><strong>Expiry</strong><span>When an idle preview is removed</span></li>
									} else {
										<li><strong>Status</strong><span>Waiting, queued, building and outcome</span></li>
										<li><strong>Requested SHA</strong><span>The exact commit captured for work</span></li>
										<li><strong>Logs</strong><span>The current attempt's output, live</span></li>
									}
								</ul>
								<a class="text-link" href="/repositories">
									Browse repositories
									@components.Arrow()
								</a>
							</div>
						} else {
							<table class={ "pr-table", "activity-table", templ.KV("is-previews", p.Previews) }>
								<thead>
									<tr>
										<th>Pull request</th>
										<th>Status</th>
										if p.Previews {
											<th>Serving</th>
											<th>Link</th>
											<th>Published</th>
										} else {
											<th>Commit</th>
											<th>When</th>
										}
										<th><span class="sr-only">Actions</span></th>
									</tr>
								</thead>
								<tbody>
									for _,row:=range p.Rows {
										<tr>
											<td class="pr-cell-main">
												<div class="pr-cell-wrap">
													<span class={ "pr-state-icon", row.IconTone(p.Previews) } aria-hidden="true">
														if p.Previews {
															@components.EnvironmentIcon()
														} else {
															@components.BuildIcon()
														}
													</span>
													<div class="pr-cell-text">
														<a href={ components.PublicURL(ctx, PRURL(row.RepoID, row.Number)) }>
															if row.Title!="" {
																#{ strconv.Itoa(int(row.Number)) } · { row.Title }
															} else {
																{ row.Name } · #{ strconv.Itoa(int(row.Number)) }
															}
														</a>
														<small>
															<span>{ row.Name }</span>
															if !row.Available {
																<span class="meta-flag">· Access unavailable</span>
															}
														</small>
													</div>
												</div>
											</td>
											<td class="pr-cell-state" data-label="Status">
												if p.Previews {
													{{ label, tone := row.PreviewStatus() }}
													<span class={ "badge", tone }><span class="badge-dot" aria-hidden="true"></span>{ label }</span>
													if row.Failure!="" {
														<small title={ row.Failure }>Newer build failed: { row.Diagnosis().Title }</small>
													}
												} else {
													if row.Waiting!="" {
														<span class="badge tone-info"><span class="badge-dot" aria-hidden="true"></span>{ row.Waiting }</span>
													} else {
														<span class={ "badge", row.StatusTone() }><span class="badge-dot" aria-hidden="true"></span>{ Label(row.State) }</span>
													}
													if row.Failure!="" {
														<small class={ templ.KV("tone-danger", row.StatusTone() == "tone-danger") } title={ row.Failure }>{ row.Diagnosis().Title }</small>
													}
													if row.AttentionNote != "" {
														<small class="attention-note">{ row.AttentionNote }</small>
													}
												}
											</td>
											if p.Previews {
												<td class="pr-cell-sha" data-label="Serving">
													if row.Deployed!="" {
														<code class="sha" title={ row.Deployed }>{ Short(row.Deployed) }</code>
													} else {
														<span class="text-muted" aria-label="Nothing deployed">—</span>
													}
													if row.OlderPreview {
														<small>Earlier than the latest commit</small>
													}
												</td>
												<td class="pr-cell-url" data-label="Link">
													if row.PreviewURL!="" {
														<a class="preview-open" href={ components.PublicURL(ctx, PreviewHref(ctx, row.RepoID, row.Number, row.PreviewURL)) } target="_blank" rel="noopener noreferrer" title={ row.PreviewURL } aria-label={ "Open the preview of " + row.Name + " #" + strconv.Itoa(int(row.Number)) + " in a new tab" }>
															Open preview
															@components.ArrowUpRight()
														</a>
														@components.CopyButton(row.PreviewURL, "Copy the preview address of "+row.Name+" #"+strconv.Itoa(int(row.Number)))
													} else {
														<span class="text-muted" aria-label="No address">—</span>
													}
												</td>
												<td class="pr-cell-expiry" data-label="Published">
													if row.PublishedAt!="" {
														<span class="cell-line">
															@components.Time(row.PublishedAt, TimeLabel(row.PublishedAt))
														</span>
													}
													if row.AsleepAt!="" {
														<small>Asleep · wakes on the next visit</small>
													}
													if row.LastOpenedAt!="" {
														<small>
															Opened { " " }
															@components.Time(row.LastOpenedAt, TimeLabel(row.LastOpenedAt))
														</small>
													}
													if row.ExpiresAt!="" {
														<small>
															Expires { " " }
															@components.Time(row.ExpiresAt, TimeLabel(row.ExpiresAt))
														</small>
													} else if row.PublishedAt=="" {
														<span class="text-muted" aria-label="Not published">—</span>
													}
												</td>
											} else {
												<td class="pr-cell-sha" data-label="Commit">
													<code class="sha" title={ row.Requested }>{ Short(row.Requested) }</code>
													if !row.RequestCurrent && row.Latest!="" {
														<small>Latest is { Short(row.Latest) }</small>
													}
												</td>
												<td class="pr-cell-when" data-label="When">
													switch  {
														case row.State=="pending" && row.Waiting=="" && row.Deadline!="":
															Eligible { " " }
															@components.Time(row.Deadline, TimeLabel(row.Deadline))
														case row.State=="running" && row.StartedAt!="":
															Started { " " }
															@components.Time(row.StartedAt, TimeLabel(row.StartedAt))
														case row.CompletedAt!="":
															Finished { " " }
															@components.Time(row.CompletedAt, TimeLabel(row.CompletedAt))
															if took := Took(row.StartedAt, row.CompletedAt); took!="" {
																<small>Took { took }</small>
															}
														default:
															<span class="text-muted">—</span>
													}
													if row.RequestSource=="automatic" {
														<small>Automatic</small>
													}
												</td>
											}
											<td class="pr-cell-logs" data-label="Actions">
												<a class="text-link" href={ components.PublicURL(ctx, LogsURL(row.RepoID, row.Number)) } aria-label={ "Build logs for " + row.Name + " #" + strconv.Itoa(int(row.Number)) }>
													@components.LogsIcon()
													Logs
												</a>
												if !p.Previews && (row.CanDismiss() || row.Dismissed()) {
													@failureAction(csrf, p, row)
												}
												if row.Teardown {
													<button type="button" class="danger-link teardown-link" data-open-dialog={ row.TeardownDialog() } commandfor={ row.TeardownDialog() } command="show-modal" aria-haspopup="dialog" aria-label={ "Tear down the preview of " + row.Name + " #" + strconv.Itoa(int(row.Number)) }>Tear down</button>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
							for _,row:=range p.Rows {
								if row.Teardown {
									@components.ConfirmationDialog(row.TeardownDialog(), "Tear down this preview?", row.Name+" #"+strconv.Itoa(int(row.Number))+": the preview stops serving and its containers are removed. Its address stays reserved; build again from the pull request to bring it back.") {
										<form method="post" action={ components.PublicURL(ctx, PRURL(row.RepoID, row.Number)+"/teardown") } class="dialog-actions">
											<input type="hidden" name="csrf_token" value={ csrf }/>
											<input type="hidden" name="return" value="previews"/>
											<input type="hidden" name="page" value={ strconv.FormatInt(p.Number, 10) }/>
											@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{"autofocus": true, "data-close-dialog": true, "commandfor": row.TeardownDialog(), "command": "close"}}) {
												Cancel
											}
											@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
												Tear down preview
											}
										</form>
									}
								}
							}
						}
					</div>
					<footer class="repository-pagination">
						<p>
							{ strconv.FormatInt(p.Total,10) } records · Page { strconv.FormatInt(p.Number,10) } of { strconv.FormatInt(p.Pages,10) }
						</p>
						<nav aria-label={ title + " pages" } class="pager">
							if p.Number>1 {
								<a href={ components.PublicURL(ctx, p.PageURL(p.Number-1)) } rel="prev">
									@components.ArrowLeft()
									Previous
								</a>
							}
							if p.Number<p.Pages {
								<a href={ components.PublicURL(ctx, p.PageURL(p.Number+1)) } rel="next">
									Next
									@components.Arrow()
								</a>
							}
						</nav>
					</footer>
				</div>
			</section>
		</div>
	}
}

// backendFacts shows what the live preview runs next to its app, its docs
// address and outbound connections, and which managed services this server
// offers (labelled when none are).
templ backendFacts(pr PR) {
	<dl class="pr-backend" data-backend>
		if pr.Live() && pr.Backend != "" {
			<div>
				<dt>Runs with</dt>
				<dd>
					{ pr.Backend }.
					if pr.KeepsData {
						<span class="pr-backend-note">Data is kept between builds; Reset test data on the review page starts clean.</span>
					} else {
						<span class="pr-backend-note">Data does not survive a rebuild.</span>
					}
				</dd>
			</div>
		}
		if pr.Live() && pr.DataSource != "" {
			<div>
				<dt>Test data</dt>
				<dd data-test-data-source>
					{ "Started from: " + pr.DataSource + "." }
					for _, reason := range pr.DataReasons {
						<span class="pr-backend-note">{ reason }</span>
					}
					if pr.DataKept {
						<span class="pr-backend-note">Changes made in the previous preview while this build prepared are not included.</span>
					}
				</dd>
			</div>
		}
		if pr.Live() && pr.DocsURL != "" {
			<div>
				<dt>Docs</dt>
				<dd><a class="text-link" href={ components.PublicURL(ctx, pr.DocsURL) } target="_blank" rel="noopener noreferrer" data-docs-url>{ pr.DocsURL }</a></dd>
			</div>
		}
		if pr.Live() && pr.OutboundLabel() != "" {
			<div>
				<dt>Outbound</dt>
				<dd>{ pr.OutboundLabel() }</dd>
			</div>
		}
		<div>
			<dt>Managed services</dt>
			<dd class="pr-backend-offer" data-services-offered>
				if pr.ExecutionWorker && len(pr.ServicesOffered) > 0 {
					<ul class="pr-service-tags" aria-label="Available managed services">
						for _, service := range pr.ServicesOffered {
							<li class="badge tone-neutral">{ service }</li>
						}
					</ul>
				} else {
					{ pr.ServicesLabel() }
				}
			</dd>
		</div>
	</dl>
}

// failureToolbar filters Builds by failure, and offers Undo right after a
// dismissal (a filtered list may no longer show the row).
templ failureToolbar(csrf string, p Activity) {
	<div class="repository-toolbar activity-toolbar">
		<nav class="segmented activity-filters" aria-label="Failures">
			for _, f := range FailureFilters() {
				<a
					href={ components.PublicURL(ctx, p.FilterURL(f.Value)) }
					if f.Value == p.Failures {
						aria-current="page"
					}
				>{ f.Label }</a>
			}
		</nav>
		<p class="activity-filters-hint">
			Failures need attention for { strconv.Itoa(p.AttentionDays) } days, then stay here quietly.
		</p>
	</div>
	if row, ok := p.DismissedPR(); ok {
		<div class="activity-notice" role="status">
			@components.CheckIcon()
			<span>Failure dismissed. It no longer counts on the Overview, and returns if this pull request fails again.</span>
			<form method="post" action={ components.PublicURL(ctx, row.FailureURL("restore")) }>
				@failureReturn(csrf, p)
				<button type="submit" class="link-button">Undo</button>
			</form>
		</div>
	}
}

// failureAction is a row's Dismiss or Undo, returning to this Builds view.
templ failureAction(csrf string, p Activity, row ActivityRow) {
	if row.CanDismiss() {
		<form method="post" action={ components.PublicURL(ctx, row.FailureURL("dismiss")) } class="row-action">
			@failureReturn(csrf, p)
			<input type="hidden" name="revision" value={ strconv.FormatInt(row.Revision, 10) }/>
			<button type="submit" class="link-button" title="Stop counting this failure on the Overview" aria-label={ "Dismiss the failure of " + row.Name + " #" + strconv.Itoa(int(row.Number)) }>Dismiss</button>
		</form>
	} else {
		<form method="post" action={ components.PublicURL(ctx, row.FailureURL("restore")) } class="row-action">
			@failureReturn(csrf, p)
			<button type="submit" class="link-button" aria-label={ "Undo dismissing the failure of " + row.Name + " #" + strconv.Itoa(int(row.Number)) }>Undo</button>
		</form>
	}
}

templ failureReturn(csrf string, p Activity) {
	<input type="hidden" name="csrf_token" value={ csrf }/>
	<input type="hidden" name="return" value="builds"/>
	<input type="hidden" name="page" value={ strconv.FormatInt(p.Number, 10) }/>
	if p.Failures != "" {
		<input type="hidden" name="failures" value={ p.Failures }/>
	}
	if p.RepoID > 0 {
		<input type="hidden" name="repo_id" value={ components.PublicValue(ctx, "repository", p.RepoID) }/>
	}
}


// prDescription shows what the author wrote on GitHub, escaped as plain text.
templ prDescription(pr PR) {
	<section class="workspace-panel pr-description" aria-labelledby="pr-description-heading">
		<div class="pr-description-heading">
			<h2 id="pr-description-heading">Description</h2>
		</div>
		if strings.TrimSpace(pr.Description) != "" {
			<div class="pr-description-content" tabindex="0">{ pr.Description }</div>
		} else {
			<p class="pr-description-empty">The author didn't add a description to this pull request.</p>
		}
	</section>
}

// commitMessage shows the head commit's subject, its body on request, and who wrote it.
templ commitMessage(pr PR) {
	if pr.CommitMessage != "" {
		<div class="commit-message">
			<p class="commit-subject" title={ pr.CommitSubject() }>{ pr.CommitSubject() }</p>
			if pr.CommitBody() != "" {
				<details class="commit-body">
					<summary>Full commit message</summary>
					<pre>{ pr.CommitBody() }</pre>
				</details>
			}
			if pr.CommitAuthor != "" || pr.CommitAt != "" {
				<p class="commit-meta">
					if pr.CommitAuthor != "" {
						{ pr.CommitAuthor }
					}
					if pr.CommitAuthor != "" && pr.CommitAt != "" {
						{ " · " }
					}
					if pr.CommitAt != "" {
						@components.Time(pr.CommitAt, TimeLabel(pr.CommitAt))
					}
				</p>
			}
		</div>
	}
}
