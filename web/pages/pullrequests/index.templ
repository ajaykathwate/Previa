package pullrequests

import "strconv"
import "github.com/ajaykathwatee/previa/web/components"
import "github.com/ajaykathwatee/previa/web/components/button"
import "github.com/ajaykathwatee/previa/web/layouts"

templ Index(username, csrf string, p Page) {
	@layouts.App("Repositories", username, csrf, components.NavRepositories) {
		<div class="repository-workspace">
			<p class="repository-search-feedback" data-detail-feedback role="status" aria-live="polite"></p>
			<section id="repository-detail" class="repository-page" aria-label="Repository details" hx-sync="this:replace" hx-request='{"timeout":10000}'>
				@Panel(p, csrf)
			</section>
			if p.LiveURL != "" {
				// Server-sent change signals refetch the panel through the ordinary
				// GET handler; ui.js keeps the stream and defers refreshes while
				// filters are focused or a confirmation is open.
				<div hidden data-live-events={ p.LiveURL } data-live-refresh hx-get={ p.CurrentURL() } hx-trigger="live-update from:body" hx-target="#repository-detail" hx-sync="#repository-detail:drop"></div>
			}
		</div>
	}
}

templ Panel(p Page, csrf string) {
	<div class="pr-workspace" data-selected-repo={ strconv.FormatInt(p.RepoID, 10) }>
		<header class="pr-panel-heading">
			<div class="pr-heading-text">
				<nav aria-label="Repository location" class="pr-location">
					if p.SelectedPR!=nil {
						<a href={ templ.SafeURL(p.PageURL(p.Number)) } class="text-link pr-directory-link">
							@components.ArrowLeft()
							{ p.RepositoryName() } pull requests
						</a>
					} else {
						<a href={ templ.SafeURL(p.CloseURL()) } class="text-link pr-directory-link">
							@components.ArrowLeft()
							Repositories
						</a>
					}
					<div class="pr-title-row">
						<span class="pr-repo-icon" aria-hidden="true">
							if p.SelectedPR!=nil {
								@components.PullRequestIcon()
							} else {
								@components.RepositoryIcon()
							}
						</span>
						<h1 tabindex="-1" data-detail-heading class="pr-breadcrumb">
							<a href={ templ.SafeURL(p.CloseURL()) } title={ p.Owner() }>{ p.Owner() }</a>
							<span aria-hidden="true">/</span>
							<a
								href={ templ.SafeURL(p.PageURL(p.Number)) }
								title={ p.RepositoryName() }
								if p.SelectedPR==nil {
									aria-current="page"
								}
							>{ p.RepositoryName() }</a>
							if p.SelectedPR!=nil {
								<span aria-hidden="true">/</span><span aria-current="page" class="pr-current-crumb" title={ p.Selected().Title }>#{ strconv.Itoa(int(p.Selected().Number)) } · { p.Selected().Title }</span>
							}
						</h1>
					</div>
				</nav>
				<p class="pr-summary" role="status">
					if p.SelectedPR==nil {
						<span class="pr-summary-item">
							@components.ClockIcon()
							<span>
								Last synced ·
								if p.LastRefresh!="" {
									@components.Time(p.LastRefresh, TimeLabel(p.LastRefresh))
								} else {
									<span>Never</span>
								}
							</span>
						</span>
					}
					<span class="pr-summary-item pr-mode">
						@components.BuildIcon()
						<span>{ Label(p.Mode) } builds</span>
					</span>
					if p.SelectedPR==nil {
						if !p.Available {
							<span class="sync-state tone-neutral">Repository unavailable</span>
						} else if !p.DiscoveryEnabled {
							<span class="sync-state tone-neutral">Sync not configured</span>
						}
						if p.Syncing() && p.WorkerMissing {
							<span class="sync-state tone-warn" title="No worker is running to fetch pull requests from GitHub.">Waiting for a worker</span>
						} else if p.Syncing() && p.SyncStale {
							<span class="sync-state tone-danger" title="This sync did not finish in time. Sync Pull Requests starts it again.">Sync stalled</span>
						} else if p.Syncing() {
							<span class="sync-state tone-info is-syncing" data-refresh-at={ p.SyncStaleAt }>Syncing</span>
						} else if p.SyncState=="failed" {
							<span class="sync-state sync-failed tone-danger" title={ p.SyncMessage }>Sync failed</span>
						}
					}
					<span class="live-indicator" aria-hidden="true"><span class="live-dot"></span><span class="live-label-live">Live</span><span class="live-label-reconnecting">Reconnecting</span><span class="live-label-offline">Live updates paused · reload to resume</span></span>
				</p>
			</div>
			if p.SelectedPR==nil {
				<div class="pr-header-actions">
					<form method="post" action={ RepoURL(p.RepoID) + "/refresh" } hx-post={ RepoURL(p.RepoID) + "/refresh" } hx-target="#repository-detail" hx-sync="#repository-detail:replace">
						<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="workspace_query" value={ p.Query() }/>
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Class: "sync-button", Disabled: p.SyncDisabled()}) {
							@components.SyncIcon()
							Sync Pull Requests
						}
					</form>
					@AutomaticSwitch(p, csrf)
				</div>
			}
		</header>
		if p.SelectedPR!=nil {
			@PRDetail(p, p.Selected(), csrf)
		} else {
			@components.RepositoryTabs(p.RepoID, "pull-requests")
			if p.Available && p.DiscoveryEnabled && p.WorkerMissing {
				<p class="connection-notice tone-warn" role="status" data-worker-missing>
					@components.AlertIcon()
					<span>
						<strong>No worker is running</strong> (or it runs without the GitHub App). Syncs, mergeability checks and builds wait until one starts: run <code>make run-worker</code> during development, and check its log if it stops. Waiting work then continues by itself.
					</span>
				</p>
			} else if p.SyncStale {
				<p class="connection-notice tone-danger" role="status" data-sync-stalled>
					@components.AlertIcon()
					<span>
						<strong>This sync did not finish within 5 minutes.</strong> Choose Sync Pull Requests to start it again. If it stalls again, check the worker's log.
					</span>
				</p>
			}
			<p class="policy-hint">
				@components.InfoIcon()
				if p.Mode=="automatic" {
					<span><strong>Automatic mode.</strong> New commits on open pull requests schedule work after five quiet minutes. Existing pull requests are not bulk-built.</span>
				} else {
					<span><strong>Manual mode.</strong> Pull request events update tracking only. Nothing builds without an explicit request.</span>
				}
			</p>
			<section class="workspace-panel repository-browser" aria-label="Pull request browser">
				<form id="pull-request-filters" method="get" action={ RepoURL(p.RepoID) } class="repository-toolbar" role="search" hx-get={ RepoURL(p.RepoID) } hx-trigger="submit, input delay:300ms from:#pull-request-search, change from:.pr-state-option" hx-target="#pull-request-results" hx-sync="#repository-detail:replace" hx-replace-url="true" hx-request='{"timeout":10000}' data-repository-search="pull requests">
					@ContextFields(p)
					<div class="repository-search search-field">
						<label for="pull-request-search" class="sr-only">Find a pull request</label>
						<span class="search-field-icon">
							@components.SearchIcon()
						</span>
						<input id="pull-request-search" type="search" name="pr_q" value={ p.Search } maxlength="100" placeholder="Search title, number, author or branch" autocomplete="off"/>
					</div>
					<fieldset class="repository-access">
						<legend class="sr-only">State</legend>
						<div class="repository-access-tabs segmented">
							for _,state:=range []string{"open","closed","merged","all"} {
								<label><input class="sr-only pr-state-option" type="radio" name="pr_state" value={ state } checked?={ p.State==state }/><span>{ Label(state) }</span></label>
							}
						</div>
					</fieldset>
					<noscript><button type="submit" class="text-link">Apply filters</button></noscript>
					<p class="repository-search-feedback" data-repository-feedback role="status" aria-live="polite"></p>
				</form>
				<div id="pull-request-results" class="repository-results">
					@Results(p)
				</div>
			</section>
		}
		if p.SelectedPR==nil {
			@components.ConfirmationDialog("build-policy", "Enable automatic builds?", "Future PR updates will schedule work after five quiet minutes. Existing PRs are not bulk-built.") {
				@PolicyForm(p, csrf, true)
			}
			<noscript>
				<section class="workspace-panel pr-policy-fallback">
					<h3>Automatic builds</h3>
					<p>Automatic applies only to future events. Manual cancels unstarted automatic requests.</p>
					@PolicyForm(p, csrf, false)
				</section>
			</noscript>
		}
	</div>
}

templ AutomaticSwitch(p Page, csrf string) {
	if p.Mode=="automatic" {
		<form method="post" action={ RepoURL(p.RepoID) + "/policy" } hx-post={ RepoURL(p.RepoID) + "/policy" } hx-target="#repository-detail" hx-sync="#repository-detail:replace" hx-disabled-elt="find button">
			<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="workspace_query" value={ p.Query() }/><input type="hidden" name="mode" value="manual"/>
			<button type="submit" role="switch" aria-checked="true" class="automatic-switch" disabled?={ !p.Available } title="Automatic builds are on. Turn them off to build only on request."><span>Automatic builds</span><span class="switch-track" aria-hidden="true"><span></span></span></button>
		</form>
	} else {
		<button type="button" role="switch" aria-checked="false" class="automatic-switch" disabled?={ !p.Available } data-open-dialog="build-policy" commandfor="build-policy" command="show-modal" aria-haspopup="dialog" title="Automatic builds are off: nothing builds until you ask."><span>Automatic builds</span><span class="switch-track" aria-hidden="true"><span></span></span></button>
	}
}

templ ContextFields(p Page) {
	for key,value:=range p.DirectoryFilters() {
		<input type="hidden" name={ key } value={ value }/>
	}
}

templ PolicyForm(p Page, csrf string, modal bool) {
	<form method="post" action={ RepoURL(p.RepoID) + "/policy" } class="dialog-actions" hx-disabled-elt="find button[type=submit]" hx-post={ RepoURL(p.RepoID) + "/policy" } hx-target="#repository-detail" hx-sync="#repository-detail:replace">
		<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="workspace_query" value={ p.Query() }/>
		<p class="repository-search-feedback" data-policy-feedback role="status" aria-live="polite"></p>
		<input type="hidden" name="mode" value={ p.PolicyMode(modal) }/>
		if modal {
			@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-close-dialog": true, "commandfor": "build-policy", "command": "close"}}) {
				Cancel
			}
		}
		@button.Button(button.Props{Type: button.TypeSubmit, Disabled: !p.Available}) {
			{ p.PolicyAction(modal) }
		}
	</form>
}

templ Results(p Page) {
	<div class="repository-table-scroll" tabindex="0" role="region" aria-label="Pull request list">
		if len(p.Rows)==0 {
			<div class="repository-empty">
				<span class="empty-source-icon" aria-hidden="true">
					@components.PullRequestIcon()
				</span>
				if p.LastRefresh=="" && p.Search=="" && p.Total==0 && p.Available && p.DiscoveryEnabled {
					<h3>No pull requests found yet</h3>
					<p>Previa has not looked for this repository's open pull requests yet. Sync once; after that, GitHub keeps the list current.</p>
					<form method="post" action={ RepoURL(p.RepoID) + "/refresh" } hx-post={ RepoURL(p.RepoID) + "/refresh" } hx-target="#repository-detail" hx-sync="#repository-detail:replace">
						<input type="hidden" name="csrf_token" value={ p.CSRF }/><input type="hidden" name="workspace_query" value={ p.Query() }/>
						@button.Button(button.Props{Type: button.TypeSubmit, Disabled: p.SyncState == "queued" || p.SyncState == "syncing"}) {
							@components.SyncIcon()
							Sync Pull Requests
						}
					</form>
				} else {
					<h3>No pull requests in this view</h3>
					<p>Try another state or search. Sync Pull Requests refreshes what Previa knows from GitHub.</p>
				}
			</div>
		} else {
			<table class="pr-table">
				<thead><tr><th>Pull request</th><th>Head commit</th><th>State</th><th>Latest request</th><th>Preview</th></tr></thead>
				<tbody>
					for _,pr:=range p.Rows {
						<tr>
							<td class="pr-cell-main">
								<div class="pr-cell-wrap">
									<span class={ "pr-state-icon", Tone(pr.State) } aria-hidden="true">
										@components.PullRequestIcon()
									</span>
									<div class="pr-cell-text">
										<a href={ templ.SafeURL(p.DetailURL(pr.Number)) }>#{ strconv.Itoa(int(pr.Number)) } · { pr.Title }</a>
										<small>
											<span>{ pr.Author }</span>
											<code class="branch-chip">{ pr.Branch }</code>
											if pr.Fork {
												<span class="meta-flag">· Fork</span>
											}
											if pr.NeedsRefresh {
												<span class="meta-flag tone-warn">· Refresh required</span>
											}
										</small>
									</div>
								</div>
							</td>
							<td class="pr-cell-sha" data-label="Head"><code class="sha">{ Short(pr.SHA) }</code></td>
							<td class="pr-cell-state" data-label="State">
								<span class={ "repository-status", "badge", Tone(pr.State) }><span class="badge-dot" aria-hidden="true"></span>{ Label(pr.State) }</span>
								if pr.MergeUnknown {
									<small>GitHub did not answer; sync to ask again</small>
								} else if pr.State=="checking" && pr.NoWorker {
									<small>Waiting for a worker</small>
								}
							</td>
							<td class="pr-cell-build" data-label="Latest request">
								<span class={ "badge", "badge-quiet", Tone(pr.Build) }>{ Label(pr.Build) }</span>
								if !pr.RequestCurrent && pr.Build!="Not requested" {
									<small>For an earlier commit</small>
								}
							</td>
							<td class="pr-cell-url" data-label="Preview">
								if pr.PreviewURL!="" {
									<a class="text-link" href={ templ.SafeURL(pr.PreviewURL) } target="_blank" rel="noopener noreferrer" title={ pr.PreviewURL } aria-label={ "Open the preview of #" + strconv.Itoa(int(pr.Number)) }>
										Open
										@components.ArrowUpRight()
									</a>
								} else {
									<span class="text-muted" aria-label="No preview">—</span>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
	<footer class="repository-pagination">
		<p role="status" aria-live="polite">
			{ strconv.FormatInt(p.Total,10) } pull requests · Page { strconv.FormatInt(p.Number,10) } of { strconv.FormatInt(p.Pages,10) }
		</p>
		<nav aria-label="Pull request pages" class="pager">
			if p.Number>1 {
				<a href={ templ.SafeURL(p.PageURL(p.Number - 1)) } hx-get={ p.PageURL(p.Number - 1) } hx-target="#pull-request-results" hx-sync="#repository-detail:replace" hx-push-url="true" rel="prev">
					@components.ArrowLeft()
					Previous
				</a>
			}
			if p.Number<p.Pages {
				<a href={ templ.SafeURL(p.PageURL(p.Number + 1)) } hx-get={ p.PageURL(p.Number + 1) } hx-target="#pull-request-results" hx-sync="#repository-detail:replace" hx-push-url="true" rel="next">
					Next
					@components.Arrow()
				</a>
			}
		</nav>
	</footer>
}

templ PRDetail(p Page, pr PR, csrf string) {
	<div class="pr-detail-content">
		<p class="pr-meta">
			<span class={ "badge", Tone(pr.State) }><span class="badge-dot" aria-hidden="true"></span>{ Label(pr.State) }</span>
			if pr.Author!="" {
				<span class="pr-meta-item"><span class="user-avatar user-avatar-sm" aria-hidden="true">{ components.Initial(pr.Author) }</span>{ pr.Author }</span>
			}
			if pr.Branch!="" {
				<code class="branch-chip">
					@components.BranchIcon()
					{ pr.Branch }
				</code>
			}
			if pr.Fork {
				<span class="badge tone-warn" title="Pull requests from forks never receive repository secrets.">Fork · no secrets</span>
			}
			if pr.URL!="" {
				<a class="text-link github-link" href={ templ.SafeURL(pr.URL) } target="_blank" rel="noopener noreferrer">
					@components.GitHubMark()
					View on GitHub
					@components.ArrowUpRight()
				</a>
			}
		</p>
		<section class={ "workspace-panel", "pr-status", pr.Headline.Tone } aria-labelledby="pr-status-title" data-pr-status>
			<div class="pr-status-main">
				<span class="pr-status-dot" aria-hidden="true"></span>
				<div class="pr-status-text">
					<h2 id="pr-status-title">{ pr.Headline.Title }</h2>
					if pr.Headline.Detail!="" {
						<p>{ pr.Headline.Detail }</p>
					}
				</div>
			</div>
			if pr.Live() {
				<div class="pr-status-preview">
					@components.LinkIcon()
					<a class="preview-address" href={ templ.SafeURL(pr.PreviewURL) } target="_blank" rel="noopener noreferrer" data-preview-url>{ pr.PreviewURL }</a>
					@components.CopyButton(pr.PreviewURL, "Copy the preview address")
				</div>
			}
			<div class="pr-detail-actions">
				if pr.Live() {
					@button.Button(button.Props{Href: pr.PreviewURL, Target: "_blank", Attributes: templ.Attributes{"rel": "noopener noreferrer"}}) {
						Open preview
						@components.ArrowUpRight()
					}
				}
				if pr.Actions.HasBuildAction() {
					<form method="post" action={ templ.SafeURL(PRURL(p.RepoID, pr.Number) + "/build") } hx-post={ PRURL(p.RepoID, pr.Number) + "/build" } hx-target="#repository-detail" hx-sync="#repository-detail:replace" hx-disabled-elt="find button">
						<input type="hidden" name="csrf_token" value={ csrf }/>
						<input type="hidden" name="workspace_query" value={ p.Query() }/>
						<input type="hidden" name="expected_revision" value={ strconv.FormatInt(pr.Actions.ExpectedRevision, 10) }/>
						<input type="hidden" name="request_key" value={ pr.Actions.RequestKey }/>
						if pr.Actions.Retry {
							<input type="hidden" name="action" value="retry"/>
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: secondaryWhen(pr.Live())}) {
								@components.BuildIcon()
								Retry build
							}
						} else if pr.Actions.Rebuild {
							<input type="hidden" name="action" value="rebuild"/>
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: secondaryWhen(pr.Live())}) {
								@components.BuildIcon()
								Rebuild preview
							}
						} else {
							<input type="hidden" name="action" value="build"/>
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: secondaryWhen(pr.Live())}) {
								@components.BuildIcon()
								if pr.Actions.BuildNow {
									Build now
								} else {
									Build latest commit
								}
							}
						}
					</form>
				} else if pr.Actions.Blocked!="" {
					@button.Button(button.Props{Disabled: true, Variant: secondaryWhen(pr.Live()), Attributes: templ.Attributes{"aria-describedby": "build-unavailable"}}) {
						@components.BuildIcon()
						{ pr.Actions.Blocked }
					}
				}
				if pr.Actions.Teardown {
					@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-open-dialog": "teardown-preview", "commandfor": "teardown-preview", "command": "show-modal", "aria-haspopup": "dialog"}}) {
						{ pr.Actions.TeardownLabel() }
					}
				}
				<a class="text-link logs-link" href={ templ.SafeURL(LogsURL(p.RepoID, pr.Number)) }>
					@components.LogsIcon()
					Build logs
				</a>
			</div>
			if pr.Actions.Unavailable!="" {
				<div
					id="build-unavailable"
					if pr.Actions.Blocked!="" {
						class="connection-notice tone-warn pr-blocked"
					} else {
						class="connection-notice tone-neutral pr-blocked"
					}
					role="status"
					data-build-unavailable
				>
					@components.AlertIcon()
					<div>
						<strong>{ pr.Actions.Unavailable }</strong>
						if pr.Actions.Hint!="" {
							<span>{ pr.Actions.Hint }</span>
						}
					</div>
				</div>
			}
		</section>
		if len(pr.FailureLog)>0 {
			<section class="workspace-panel failure-log" aria-labelledby="failure-log-title">
				<header class="failure-log-header">
					<h2 id="failure-log-title">Last lines of the build output</h2>
					<a class="text-link" href={ templ.SafeURL(LogsURL(p.RepoID, pr.Number)) }>
						Open the full log
						@components.Arrow()
					</a>
				</header>
				<ol class="failure-log-lines" aria-label="Last build output lines">
					for _, line := range pr.FailureLog {
						<li class={ templ.KV("log-error", LooksLikeError(line)) }>{ line }</li>
					}
				</ol>
			</section>
		}
		<div class="pr-detail-grid lifecycle" role="list" aria-label="Commit lifecycle">
			<section class="workspace-panel lifecycle-step" role="listitem">
				<header>
					<span class="lifecycle-index" aria-hidden="true">01</span>
					<span class="lifecycle-icon" aria-hidden="true">
						@components.CommitIcon()
					</span>
				</header>
				<h2>Latest commit</h2>
				@commitChip(pr, pr.SHA, true)
				<p><span class={ "badge", Tone(pr.State) }><span class="badge-dot" aria-hidden="true"></span>{ Gate(pr.State) }</span></p>
			</section>
			<section class="workspace-panel lifecycle-step" role="listitem">
				<header>
					<span class="lifecycle-index" aria-hidden="true">02</span>
					<span class="lifecycle-icon" aria-hidden="true">
						@components.BuildIcon()
					</span>
				</header>
				<h2>Build request</h2>
				if pr.RequestedSHA=="" {
					<p class="lifecycle-empty">No build requested yet.</p>
				} else {
					@commitChip(pr, pr.RequestedSHA, false)
					<p>
						if pr.Waiting!="" {
							<span class="badge tone-info"><span class="badge-dot" aria-hidden="true"></span>{ pr.Waiting }</span>
						} else {
							<span class={ "badge", Tone(pr.Build) }><span class="badge-dot" aria-hidden="true"></span>{ Label(pr.Build) }</span>
						}
					</p>
					<ul class="lifecycle-facts">
						if pr.RequestSource=="automatic" {
							<li>
								Automatic build · { " " }
								@components.Time(pr.RequestedAt, TimeLabel(pr.RequestedAt))
							</li>
						} else if pr.RequestedBy!="" {
							<li>
								Requested by { pr.RequestedBy } · { " " }
								@components.Time(pr.RequestedAt, TimeLabel(pr.RequestedAt))
							</li>
						}
						if pr.Build=="running" && pr.StartedAt!="" {
							<li>
								Started { " " }
								@components.Time(pr.StartedAt, TimeLabel(pr.StartedAt))
							</li>
						}
						if pr.CompletedAt!="" && (pr.Build=="succeeded" || pr.Build=="failed") {
							<li>
								Finished { " " }
								@components.Time(pr.CompletedAt, TimeLabel(pr.CompletedAt))
								if took := Took(pr.StartedAt, pr.CompletedAt); took!="" {
									{ " · took " + took }
								}
							</li>
						}
					</ul>
					if !pr.RequestCurrent {
						<p class="lifecycle-note tone-warn">This request was for an earlier commit than the latest one.</p>
					}
					if pr.Build=="superseded" && pr.RequestCurrent {
						<p class="lifecycle-note">Replaced by a teardown or a newer request before it finished.</p>
					}
					if pr.Waiting!="" {
						<p class="lifecycle-note">{ pr.WaitingNote }</p>
					} else if pr.Deadline!="" && pr.Build=="pending" {
						<p class="lifecycle-note">
							Eligible { " " }
							@components.Time(pr.Deadline, TimeLabel(pr.Deadline))
						</p>
					}
					if pr.Failure!="" {
						<p class="lifecycle-note tone-danger" data-failure>{ pr.Failure } <a class="text-link" href={ templ.SafeURL(LogsURL(p.RepoID, pr.Number)) }>See the build log</a>.</p>
					}
				}
			</section>
			<section class="workspace-panel lifecycle-step" role="listitem">
				<header>
					<span class="lifecycle-index" aria-hidden="true">03</span>
					<span class="lifecycle-icon" aria-hidden="true">
						@components.EnvironmentIcon()
					</span>
				</header>
				<h2>Deployed preview</h2>
				if pr.DeployedSHA=="" {
					<p class="lifecycle-empty">Nothing deployed.</p>
					<p><span class={ "badge", Tone(pr.Environment) }><span class="badge-dot" aria-hidden="true"></span>{ Label(pr.Environment) }</span></p>
				} else {
					@commitChip(pr, pr.DeployedSHA, false)
					<p><span class={ "badge", Tone(pr.Environment) }><span class="badge-dot" aria-hidden="true"></span>{ Label(pr.Environment) }</span></p>
					<ul class="lifecycle-facts">
						if pr.PublishedAt!="" {
							<li>
								Published { " " }
								@components.Time(pr.PublishedAt, TimeLabel(pr.PublishedAt))
							</li>
						}
						if pr.ExpiresAt!="" {
							<li>
								Expires { " " }
								@components.Time(pr.ExpiresAt, TimeLabel(pr.ExpiresAt))
							</li>
						}
					</ul>
					if pr.OlderPreview {
						<p class="lifecycle-note tone-warn">This preview serves an earlier commit than the latest one.</p>
					}
				}
				if pr.RemovedNote!="" {
					<p class="lifecycle-note">{ pr.RemovedNote }</p>
				}
			</section>
		</div>
		if pr.Actions.Teardown {
			@components.ConfirmationDialog("teardown-preview", teardownTitle(pr.Actions), teardownText(pr.Actions)) {
				<form method="post" action={ templ.SafeURL(PRURL(p.RepoID, pr.Number) + "/teardown") } class="dialog-actions" hx-post={ PRURL(p.RepoID, pr.Number) + "/teardown" } hx-target="#repository-detail" hx-sync="#repository-detail:replace" hx-disabled-elt="find button[type=submit]">
					<input type="hidden" name="csrf_token" value={ csrf }/>
					<input type="hidden" name="workspace_query" value={ p.Query() }/>
					<p class="repository-search-feedback" data-dialog-feedback role="status" aria-live="polite"></p>
					@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{"autofocus": true, "data-close-dialog": true, "commandfor": "teardown-preview", "command": "close"}}) {
						Cancel
					}
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
						{ pr.Actions.TeardownLabel() }
					}
				</form>
			}
		}
	</div>
}

// commitChip shows a commit, linked to GitHub when the PR's address is known.
templ commitChip(pr PR, sha string, full bool) {
	if href := pr.CommitURL(sha); href!="" {
		<a
			href={ templ.SafeURL(href) }
			target="_blank"
			rel="noopener noreferrer"
			title={ "Open commit " + sha + " on GitHub" }
			if full {
				class="sha sha-full sha-link"
			} else {
				class="sha sha-link"
			}
		>
			if full {
				{ sha }
			} else {
				{ Short(sha) }
			}
		</a>
	} else if full {
		<code class="sha sha-full">{ sha }</code>
	} else {
		<code class="sha" title={ sha }>{ Short(sha) }</code>
	}
}

templ ActivityIndex(username, csrf string, p Activity) {
	{{
		title := "Builds"
		nav := components.NavBuilds
		if p.Environments {
			title = "Environments"
			nav = components.NavEnvironments
		}
	}}
	@layouts.App(title, username, csrf, nav) {
		<div class="repository-workspace activity-page">
			<header class="page-header workspace-page-heading">
				<div class="page-header-text">
					<span class="eyebrow">Delivery</span>
					<h1>{ title }</h1>
					if p.Environments {
						<p>Previews that exist now, most recently published first: what each serves, its address and when it expires.</p>
					} else {
						<p>The current or latest build request of each pull request, most recent first. A new request replaces the row; this is not a history.</p>
					}
				</div>
				<nav class="segmented segmented-nav" aria-label="Delivery views">
					<a
						href="/builds"
						if !p.Environments {
							aria-current="page"
						}
					>
						@components.BuildIcon()
						<span>Builds</span>
					</a>
					<a
						href="/environments"
						if p.Environments {
							aria-current="page"
						}
					>
						@components.EnvironmentIcon()
						<span>Environments</span>
					</a>
				</nav>
			</header>
			<section class="workspace-panel repository-browser">
				<div class="repository-results">
					<div class="repository-table-scroll" tabindex="0" role="region" aria-label={ title + " list" }>
						if len(p.Rows)==0 {
							<div class="repository-empty activity-empty">
								<span class="empty-source-icon" aria-hidden="true">
									if p.Environments {
										@components.EnvironmentIcon()
									} else {
										@components.BuildIcon()
									}
								</span>
								<h2>No { title } to show.</h2>
								<p>Only real saved records appear here. Connecting or discovering a repository does not create a deployment.</p>
								<ul class="empty-explainer">
									if p.Environments {
										<li><strong>Status</strong><span>Publishing, serving, failed or being removed</span></li>
										<li><strong>Preview</strong><span>The stable address and the commit it serves</span></li>
										<li><strong>Expiry</strong><span>When an idle preview is removed</span></li>
									} else {
										<li><strong>Status</strong><span>Waiting, queued, building and outcome</span></li>
										<li><strong>Requested SHA</strong><span>The exact commit captured for work</span></li>
										<li><strong>Logs</strong><span>The current attempt's output, live</span></li>
									}
								</ul>
								<a class="text-link" href="/repositories">
									Browse repositories
									@components.Arrow()
								</a>
							</div>
						} else {
							<table class="pr-table activity-table">
								<thead>
									<tr>
										<th>Pull request</th>
										<th>Status</th>
										if p.Environments {
											<th>Serving</th>
											<th>Preview</th>
											<th>Published</th>
										} else {
											<th>Commit</th>
											<th>When</th>
										}
										<th><span class="sr-only">Actions</span></th>
									</tr>
								</thead>
								<tbody>
									for _,row:=range p.Rows {
										<tr>
											<td class="pr-cell-main">
												<div class="pr-cell-wrap">
													<span class={ "pr-state-icon", Tone(row.State) } aria-hidden="true">
														if p.Environments {
															@components.EnvironmentIcon()
														} else {
															@components.BuildIcon()
														}
													</span>
													<div class="pr-cell-text">
														<a href={ PRURL(row.RepoID, row.Number) }>
															if row.Title!="" {
																#{ strconv.Itoa(int(row.Number)) } · { row.Title }
															} else {
																{ row.Name } · #{ strconv.Itoa(int(row.Number)) }
															}
														</a>
														<small>
															<span>{ row.Name }</span>
															if !row.Available {
																<span class="meta-flag">· Access unavailable</span>
															}
														</small>
													</div>
												</div>
											</td>
											<td class="pr-cell-state" data-label="Status">
												if row.Waiting!="" {
													<span class="badge tone-info"><span class="badge-dot" aria-hidden="true"></span>{ row.Waiting }</span>
												} else {
													<span class={ "badge", Tone(row.State) }><span class="badge-dot" aria-hidden="true"></span>{ Label(row.State) }</span>
												}
												if row.Failure!="" {
													<small class="tone-danger">{ row.Failure }</small>
												}
											</td>
											if p.Environments {
												<td class="pr-cell-sha" data-label="Serving">
													if row.Deployed!="" {
														<code class="sha" title={ row.Deployed }>{ Short(row.Deployed) }</code>
													} else {
														<span class="text-muted" aria-label="Nothing deployed">—</span>
													}
													if row.OlderPreview {
														<small>Earlier than the latest commit</small>
													}
												</td>
												<td class="pr-cell-url" data-label="Preview">
													if row.PreviewURL!="" {
														<a class="text-link" href={ templ.SafeURL(row.PreviewURL) } target="_blank" rel="noopener noreferrer" title={ row.PreviewURL }>
															Open preview
															@components.ArrowUpRight()
														</a>
														@components.CopyButton(row.PreviewURL, "Copy the preview address of "+row.Name+" #"+strconv.Itoa(int(row.Number)))
													} else {
														<span class="text-muted" aria-label="No address">—</span>
													}
												</td>
												<td class="pr-cell-expiry" data-label="Published">
													if row.PublishedAt!="" {
														<span class="cell-line">
															@components.Time(row.PublishedAt, TimeLabel(row.PublishedAt))
														</span>
													}
													if row.ExpiresAt!="" {
														<small>
															Expires { " " }
															@components.Time(row.ExpiresAt, TimeLabel(row.ExpiresAt))
														</small>
													} else if row.PublishedAt=="" {
														<span class="text-muted" aria-label="Not published">—</span>
													}
												</td>
											} else {
												<td class="pr-cell-sha" data-label="Commit">
													<code class="sha" title={ row.Requested }>{ Short(row.Requested) }</code>
													if !row.RequestCurrent && row.Latest!="" {
														<small>Latest is { Short(row.Latest) }</small>
													}
												</td>
												<td class="pr-cell-when" data-label="When">
													switch {
														case row.State=="pending" && row.Waiting=="" && row.Deadline!="":
															Eligible { " " }
															@components.Time(row.Deadline, TimeLabel(row.Deadline))
														case row.State=="running" && row.StartedAt!="":
															Started { " " }
															@components.Time(row.StartedAt, TimeLabel(row.StartedAt))
														case row.CompletedAt!="":
															Finished { " " }
															@components.Time(row.CompletedAt, TimeLabel(row.CompletedAt))
															if took := Took(row.StartedAt, row.CompletedAt); took!="" {
																<small>Took { took }</small>
															}
														default:
															<span class="text-muted">—</span>
													}
													if row.RequestSource=="automatic" {
														<small>Automatic</small>
													}
												</td>
											}
											<td class="pr-cell-logs" data-label="Actions">
												<a class="text-link" href={ templ.SafeURL(LogsURL(row.RepoID, row.Number)) } aria-label={ "Build logs for " + row.Name + " #" + strconv.Itoa(int(row.Number)) }>
													@components.LogsIcon()
													Logs
												</a>
												if row.Teardown {
													<button type="button" class="danger-link teardown-link" data-open-dialog={ row.TeardownDialog() } commandfor={ row.TeardownDialog() } command="show-modal" aria-haspopup="dialog" aria-label={ "Tear down the preview of " + row.Name + " #" + strconv.Itoa(int(row.Number)) }>Tear down</button>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
							for _,row:=range p.Rows {
								if row.Teardown {
									@components.ConfirmationDialog(row.TeardownDialog(), "Tear down this preview?", row.Name+" #"+strconv.Itoa(int(row.Number))+": the preview stops serving and its containers are removed. Its address stays reserved; build again from the pull request to bring it back.") {
										<form method="post" action={ templ.SafeURL(PRURL(row.RepoID, row.Number) + "/teardown") } class="dialog-actions">
											<input type="hidden" name="csrf_token" value={ csrf }/>
											<input type="hidden" name="return" value="environments"/>
											<input type="hidden" name="page" value={ strconv.FormatInt(p.Number, 10) }/>
											@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{"autofocus": true, "data-close-dialog": true, "commandfor": row.TeardownDialog(), "command": "close"}}) {
												Cancel
											}
											@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
												Tear down preview
											}
										</form>
									}
								}
							}
						}
					</div>
					<footer class="repository-pagination">
						<p>
							{ strconv.FormatInt(p.Total,10) } records · Page { strconv.FormatInt(p.Number,10) } of { strconv.FormatInt(p.Pages,10) }
						</p>
						<nav aria-label={ title + " pages" } class="pager">
							if p.Number>1 {
								<a href={ templ.SafeURL(p.PageURL(p.Number - 1)) } rel="prev">
									@components.ArrowLeft()
									Previous
								</a>
							}
							if p.Number<p.Pages {
								<a href={ templ.SafeURL(p.PageURL(p.Number + 1)) } rel="next">
									Next
									@components.Arrow()
								</a>
							}
						</nav>
					</footer>
				</div>
			</section>
		</div>
	}
}
