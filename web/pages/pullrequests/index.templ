package pullrequests

import "strconv"
import "github.com/ajaykathwatee/previa/web/components"
import "github.com/ajaykathwatee/previa/web/components/button"
import "github.com/ajaykathwatee/previa/web/layouts"

templ Panel(p Page, csrf string) {
	<div class="pr-workspace" data-selected-repo={ strconv.FormatInt(p.RepoID, 10) }>
		<header class="pr-panel-heading">
			<div><span class="eyebrow">PULL REQUESTS</span><h2 tabindex="-1" data-detail-heading>{ p.Name }</h2></div>
			<div class="pr-header-actions">
				<form method="post" action={ RepoURL(p.RepoID) + "/refresh" } hx-post={ RepoURL(p.RepoID) + "/refresh" } hx-target="#repository-detail" hx-sync="#repository-detail:replace">
					<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="workspace_query" value={ p.Query() }/>
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Disabled: !p.Available || !p.DiscoveryEnabled || p.SyncState == "queued" || p.SyncState == "syncing"}) {
						Refresh pull requests
					}
				</form>
				@button.Button(button.Props{Variant: button.VariantOutline, Disabled: !p.Available, Attributes: templ.Attributes{"data-open-dialog": "build-policy", "aria-haspopup": "dialog"}}) {
					Build mode: { Label(p.Mode) }
				}
			</div>
		</header>
		<p class="repository-search-feedback" data-detail-feedback role="status" aria-live="polite"></p>
		<div class="pr-summary" role="status">
			if !p.Available {
				<p>Repository unavailable. Previously observed PRs remain visible. Restore access with Manage connections above.</p>
			} else if !p.DiscoveryEnabled {
				<p>PR discovery is not configured. See the development setup guide.</p>
			}
			if p.SyncState=="" {
				<p>No refresh yet. Refresh pull requests to discover existing PRs without starting builds.</p>
			} else if p.SyncState=="queued" || p.SyncState=="syncing" {
				<p hx-get={ p.CurrentURL() } hx-trigger="every 3s" hx-target="#repository-detail" hx-sync="#repository-detail:drop">Refresh { p.SyncState } · { strconv.Itoa(int(p.Fetched)) } records fetched. Progress updates automatically while the worker runs.</p>
			} else if p.SyncState=="failed" {
				<p>Refresh failed. { p.SyncMessage } Some records may already have been imported. Retry with Refresh pull requests.</p>
			} else {
				<p>Refresh complete · { strconv.Itoa(int(p.Fetched)) } records fetched.</p>
			}
			if p.LastRefresh!="" {
				<p>Last successful refresh: <time datetime={ p.LastRefresh }>{ TimeLabel(p.LastRefresh) }</time>.</p>
			}
		</div>
		if p.SelectedPR!=nil {
			@PRDetail(p, p.Selected())
		} else {
			<section class="workspace-panel repository-browser" aria-label="Pull request browser">
				<form id="pull-request-filters" method="get" action="/repositories" class="repository-toolbar" role="search" hx-get="/repositories" hx-trigger="submit, input delay:300ms from:#pull-request-search, change from:.pr-state-option" hx-target="#pull-request-results" hx-sync="#repository-detail:replace" hx-replace-url="true" hx-request='{"timeout":10000}' data-repository-search="pull requests">
					@ContextFields(p)
					<div class="repository-search"><label for="pull-request-search">Find a pull request</label><input id="pull-request-search" type="search" name="pr_q" value={ p.Search } maxlength="100" placeholder="Title, number, author or branch"/></div>
					<fieldset class="repository-access">
						<legend>State</legend>
						<div class="repository-access-tabs">
							for _,state:=range []string{"open","closed","merged","all"} {
								<label><input class="sr-only pr-state-option" type="radio" name="pr_state" value={ state } checked?={ p.State==state }/><span>{ Label(state) }</span></label>
							}
						</div>
					</fieldset>
					<noscript><button type="submit" class="text-link">Apply filters</button></noscript>
					<p class="repository-search-feedback" data-repository-feedback role="status" aria-live="polite"></p>
				</form>
				<div id="pull-request-results" class="repository-results">
					@Results(p)
				</div>
			</section>
		}
		<p class="repository-help"><a href={ templ.SafeURL("/builds?repo_id=" + strconv.FormatInt(p.RepoID, 10)) }>Build requests</a> · <a href={ templ.SafeURL("/environments?repo_id=" + strconv.FormatInt(p.RepoID, 10)) }>Environments</a></p>
		@components.ConfirmationDialog("build-policy", "Change build mode?", "Automatic records eligible work for future PR events after five quiet minutes. It never bulk-builds existing PRs. Manual cancels unstarted automatic requests and preserves running work and previews. Build execution is not available yet.") {
			@PolicyForm(p, csrf, true)
		}
		<noscript>
			<section class="workspace-panel pr-policy-fallback">
				<h3>Repository build policy</h3>
				<p>Automatic applies only to future events. Manual cancels unstarted automatic requests.</p>
				@PolicyForm(p, csrf, false)
			</section>
		</noscript>
	</div>
}

templ ContextFields(p Page) {
	<input type="hidden" name="repo_id" value={ strconv.FormatInt(p.RepoID, 10) }/>
	for key,value:=range p.DirectoryFilters() {
		<input type="hidden" name={ key } value={ value }/>
	}
}

templ PolicyForm(p Page, csrf string, modal bool) {
	<form method="post" action={ RepoURL(p.RepoID) + "/policy" } class="dialog-actions" hx-disabled-elt="find button[type=submit]" hx-post={ RepoURL(p.RepoID) + "/policy" } hx-target="#repository-detail" hx-sync="#repository-detail:replace">
		<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="workspace_query" value={ p.Query() }/>
		<p class="repository-search-feedback" data-policy-feedback role="status" aria-live="polite"></p>
		<label>Build mode <select name="mode" disabled?={ !p.Available }><option value="manual" selected?={ p.Mode=="manual" }>Manual</option><option value="automatic" selected?={ p.Mode=="automatic" }>Automatic</option></select></label>
		if modal {
			@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-close-dialog": true, "commandfor": "build-policy", "command": "close"}}) {
				Cancel
			}
		}
		@button.Button(button.Props{Type: button.TypeSubmit, Disabled: !p.Available}) {
			Save build mode
		}
	</form>
}

templ Results(p Page) {
	<div class="repository-table-scroll" tabindex="0" role="region" aria-label="Pull request list">
		if len(p.Rows)==0 {
			<div class="repository-empty"><h3>No pull requests in this view</h3><p>Try a different search or state. Refresh pull requests to discover existing PRs; discovery never starts a build.</p></div>
		} else {
			<table class="pr-table">
				<thead><tr><th>Pull request</th><th>Head commit</th><th>State</th><th>Latest request</th></tr></thead>
				<tbody>
					for _,pr:=range p.Rows {
						<tr>
							<td>
								<a href={ templ.SafeURL(p.DetailURL(pr.Number)) } hx-get={ p.DetailURL(pr.Number) } hx-target="#repository-detail" hx-sync="#repository-detail:replace" hx-push-url="true">#{ strconv.Itoa(int(pr.Number)) } · { pr.Title }</a>
								<small>
									{ pr.Author } · { pr.Branch }
									if pr.Fork {
										<span>· Fork</span>
									}
									if pr.NeedsRefresh {
										<span>· Refresh required</span>
									}
								</small>
							</td>
							<td><code>{ Short(pr.SHA) }</code></td>
							<td><span class={ "repository-status", StateClass(pr.State) }>{ Label(pr.State) }</span></td>
							<td>{ Label(pr.Build) }</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
	<footer class="repository-pagination">
		<p role="status" aria-live="polite">
			{ strconv.FormatInt(p.Total,10) } pull requests · Page { strconv.FormatInt(p.Number,10) } of { strconv.FormatInt(p.Pages,10) }
		</p>
		<nav aria-label="Pull request pages">
			if p.Number>1 {
				<a href={ templ.SafeURL(p.PageURL(p.Number - 1)) } hx-get={ p.PageURL(p.Number - 1) } hx-target="#pull-request-results" hx-sync="#repository-detail:replace" hx-push-url="true" rel="prev">Previous</a>
			}
			if p.Number<p.Pages {
				<a href={ templ.SafeURL(p.PageURL(p.Number + 1)) } hx-get={ p.PageURL(p.Number + 1) } hx-target="#pull-request-results" hx-sync="#repository-detail:replace" hx-push-url="true" rel="next">Next</a>
			}
		</nav>
	</footer>
}

templ PRDetail(p Page, pr PR) {
	<div class="pr-detail-content">
		<a href={ templ.SafeURL(p.PageURL(p.Number)) } hx-get={ p.PageURL(p.Number) } hx-target="#repository-detail" hx-sync="#repository-detail:replace" hx-push-url="true" class="text-link">
			@components.ArrowLeft()
			Back to pull requests
		</a>
		<header class="pr-detail-heading">
			<h3>#{ strconv.Itoa(int(pr.Number)) } · { pr.Title }</h3>
			<p>
				{ pr.Author } · { pr.Branch } · { Label(pr.State) }
				if pr.Fork {
					<span>· Fork</span>
				}
			</p>
		</header>
		if pr.NeedsRefresh {
			<p class="connection-notice">Conflicting upstream observations need a fresh GitHub snapshot. Refresh this repository before requesting work.</p>
		}
		<div class="pr-detail-grid">
			<section class="workspace-panel">
				<h4>Latest observed commit</h4><code>{ pr.SHA }</code>
				<p>
					{ Label(pr.State) }
				</p>
			</section>
			<section class="workspace-panel">
				<h4>Current build request</h4>
				<p>
					{ Label(pr.Build) }
				</p><code>{ Short(pr.RequestedSHA) }</code>
				if pr.Deadline!="" && pr.Build=="pending" {
					<p>Eligible after <time datetime={ pr.Deadline }>{ TimeLabel(pr.Deadline) }</time>.</p>
				}
			</section>
			<section class="workspace-panel">
				<h4>Deployed preview</h4>
				<p>
					{ Label(pr.Environment) }
				</p><code>{ Short(pr.DeployedSHA) }</code>
				if pr.DeployedSHA!="" && pr.DeployedSHA!=pr.SHA {
					<p>This deployment reflects an older commit.</p>
				}
				<p>A public URL is not available until routing is connected.</p>
			</section>
		</div>
		<div class="pr-detail-actions">
			@button.Button(button.Props{Disabled: true, Attributes: templ.Attributes{"aria-describedby": "build-unavailable"}}) {
				Build latest commit
			}
			if pr.URL!="" {
				<a class="text-link" href={ templ.SafeURL(pr.URL) } target="_blank" rel="noopener noreferrer">
					View on GitHub @components.ArrowUpRight()
				</a>
			}
		</div>
		<p id="build-unavailable" class="repository-help">Build execution, runtime health, live logs and teardown controls are not available yet.</p>
	</div>
}

templ ActivityIndex(username, csrf string, p Activity) {
	{{
		title := "Builds"
		nav := components.NavBuilds
		if p.Environments {
			title = "Environments"
			nav = components.NavEnvironments
		}
	}}
	@layouts.App(title, username, csrf, nav) {
		<div class="repository-workspace">
			<header class="workspace-page-heading">
				<div>
					<span class="eyebrow">YOUR WORKSPACE</span>
					<h1>{ title }</h1>
					if p.Environments {
						<p>Persisted deployment state. Runtime health and public routing are not connected yet.</p>
					} else {
						<p>Current/latest authorized requests, not a permanent attempt history. Execution is not available yet.</p>
					}
				</div>
				<a class="text-link" href="/repositories">
					Repositories
					@components.ArrowUpRight()
				</a>
			</header>
			<section class="workspace-panel repository-browser">
				<div class="repository-results">
					<div class="repository-table-scroll" tabindex="0" role="region" aria-label={ title + " list" }>
						if len(p.Rows)==0 {
							<div class="repository-empty"><h2>No { title } to show.</h2><p>Only real saved records appear here. Connecting or discovering a repository does not create a deployment.</p></div>
						} else {
							<table class="pr-table">
								<thead>
									<tr>
										<th>Repository / PR</th>
										<th>Status</th>
										<th>Latest SHA</th>
										<th>
											if p.Environments {
												Deployed SHA
											} else {
												Requested SHA
											}
										</th>
									</tr>
								</thead>
								<tbody>
									for _,row:=range p.Rows {
										<tr>
											<td>
												<a href={ PRURL(row.RepoID, row.Number) }>{ row.Name } · #{ strconv.Itoa(int(row.Number)) }</a>
												if !row.Available {
													<small>Access unavailable</small>
												}
											</td>
											<td>
												{ Label(row.State) }
												if !p.Environments&&row.State=="pending" {
													<small>
														Eligible: { row.Deadline }
													</small>
												}
											</td>
											<td><code>{ Short(row.Latest) }</code></td>
											<td>
												if p.Environments {
													<code>{ Short(row.Deployed) }</code>
												} else {
													<code>{ Short(row.Requested) }</code>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						}
					</div>
					<footer class="repository-pagination">
						<p>
							{ strconv.FormatInt(p.Total,10) } records · Page { strconv.FormatInt(p.Number,10) } of { strconv.FormatInt(p.Pages,10) }
						</p>
						<nav aria-label={ title + " pages" }>
							if p.Number>1 {
								<a href={ templ.SafeURL(p.PageURL(p.Number - 1)) } rel="prev">Previous</a>
							}
							if p.Number<p.Pages {
								<a href={ templ.SafeURL(p.PageURL(p.Number + 1)) } rel="next">Next</a>
							}
						</nav>
					</footer>
				</div>
			</section>
		</div>
	}
}
