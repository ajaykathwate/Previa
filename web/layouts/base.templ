package layouts

import "github.com/ajaykathwatee/previa/web/components"

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } | Previa</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src="/static/htmx.min.js" defer></script>
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground antialiased">
			<a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:z-10 focus:rounded-md focus:bg-card focus:px-4 focus:py-2">Skip to content</a>
			@components.Navbar()
			<main id="content" tabindex="-1" class="mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-16">
				{ children... }
			</main>
		</body>
	</html>
}
