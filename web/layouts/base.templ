package layouts

import "github.com/ajaykathwatee/previa/web/components"

templ Document(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content="Previa is a self-hosted preview platform built around GitHub pull requests. A shared place to see, discuss, and review what comes next."/>
			<meta name="theme-color" content="#f4f5f7" media="(prefers-color-scheme: light)"/>
			<meta name="theme-color" content="#0a0c0f" media="(prefers-color-scheme: dark)"/>
			<title>{ title } | Previa</title>
			<script data-theme-boot>
				(function(){
					try{var t=localStorage.getItem("previa-theme");if(t==="light"||t==="dark")document.documentElement.dataset.theme=t;}catch(e){}
					var s=document.createElement("style");
					s.textContent="@media (prefers-reduced-motion: no-preference){@view-transition{navigation:auto}"+"}";
					document.head.appendChild(s);
					function quiet(v){if(!v)return;var n=function(){};v.ready.catch(n);v.finished.catch(n);v.updateCallbackDone.catch(n);}
					addEventListener("pageswap",function(e){quiet(e.viewTransition);});
					addEventListener("pagereveal",function(e){quiet(e.viewTransition);});
					addEventListener("unhandledrejection",function(e){var r=e.reason;if(r&&r.name==="InvalidStateError"&&/^Transition was aborted/.test(r.message))e.preventDefault();});
				})();
			</script>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/js/ui.js" defer></script>
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground antialiased">
			<a href="#content" class="skip-link">Skip to content</a>
			{ children... }
		</body>
	</html>
}

templ Base(title string) {
	@Document(title) {
		@components.Navbar(false)
		<main id="content" tabindex="-1" class="site-container standalone-main">
			{ children... }
		</main>
	}
}
